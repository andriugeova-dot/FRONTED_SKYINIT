---
// src/pages/inmobiliarias/[id].astro
// Perfil publico de una inmobiliaria: a donde llega el usuario al presionar
// el logo/nombre de la inmobiliaria desde el catalogo de servicios.
const { id } = Astro.params;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Inmobiliaria | SkyInit</title>
	</head>
	<body>
		<header id="header">
			<div class="topbar">
				<div class="logo">SkyInit</div>
				<div class="menu-toggle" id="menuToggle">&#9776;</div>
				<nav id="menu">
					<a href="/">Inicio</a>
					<a href="/propiedades">Propiedades</a>
					<a href="/proyectos">Proyectos</a>
					<a href="/servicios">Servicios</a>
					<a href="/constructoras">Constructoras</a>
					<span id="navUser"></span>
				</nav>
			</div>
		</header>

		<!-- ▌PERFIL DE LA INMOBILIARIA ▐ -->
		<section class="contenedor" id="perfilInmobiliaria">
			<div class="empty-state">
				<span>⏳</span>
				Cargando inmobiliaria...
			</div>
		</section>

		<!-- ▌SERVICIOS DE ESTA INMOBILIARIA ▐ -->
		<section class="contenedor">
			<div class="section-header">
				<span class="section-eyebrow">Catálogo</span>
				<h2 class="section-title">Servicios que ofrece</h2>
				<p class="section-sub">Mantenimiento verificado por SkyInit para esta inmobiliaria</p>
			</div>
		</section>
		<section class="contenedor grid" id="serviciosGrid"></section>

		<!-- ▌MODAL SOLICITAR SERVICIO ▐ -->
		<div class="modal-overlay" id="modalSolicitud">
			<div class="modal-content">
				<button type="button" class="modal-close" id="btnCerrarModal">&times;</button>
				<div class="modal-header">
					<div class="modal-title-wrap">
						<h2>Solicitar servicio</h2>
						<p id="modalServicioNombre"></p>
					</div>
				</div>
				<div class="modal-body">
					<form id="formSolicitud">
						<input type="hidden" name="servicioId" id="modalServicioId" />
						<div class="form-row">
							<label for="modalNotas">Detalles adicionales (opcional)</label>
							<textarea
								name="notas"
								id="modalNotas"
								rows="4"
								placeholder="Ej: dirección del inmueble, disponibilidad de horario, descripción del problema..."
							></textarea>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn-secondary" id="btnCancelarModal">Cancelar</button>
							<button type="submit" class="btn-confirm">✅ Enviar solicitud</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<div id="toastContainer"></div>

		<script define:vars={{ id }}>
			let usuarioAutenticado = false;
			let nombreUsuario = '';
			let fotoPerfil = '/img/default-avatar.svg';

			async function verificarSesion() {
				try {
					const res = await fetch('/api/perfil', { credentials: 'same-origin' });
					if (res.ok) {
						const data = await res.json();
						usuarioAutenticado = true;
						nombreUsuario = data.usuario?.nombre ?? '';
						fotoPerfil = data.usuario?.fotoPerfil || '/img/default-avatar.svg';
					}
				} catch {}
				renderUserMenu();
			}

			function renderUserMenu() {
				const nav = document.getElementById('navUser');
				if (!nav) return;
				if (usuarioAutenticado) {
					nav.innerHTML = `
						<div class="user-profile">
							<img src="${fotoPerfil}" alt="Perfil" class="profile-pic" id="profilePic" />
							<div id="user-menu" class="user-menu">
								<div class="user-menu-name">${nombreUsuario}</div>
								<a href="/ajustes">⚙️ Ajustes</a>
								<button type="button" id="btnLogout">🚪 Cerrar sesión</button>
							</div>
						</div>`;
					document.getElementById('profilePic')?.addEventListener('click', () => {
						document.getElementById('user-menu')?.classList.toggle('active');
					});
					document.getElementById('btnLogout')?.addEventListener('click', async () => {
						await fetch('/api/logout', { method: 'POST', credentials: 'same-origin' });
						location.reload();
					});
				} else {
					nav.innerHTML = `<a href="/login" class="btn-registrar">Iniciar Sesión</a>`;
				}
			}

			function escapeHtml(valor) {
				return (valor ?? '').replace(/[&<>"']/g, (c) => ({
					'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
				}[c]));
			}

			function iniciales(nombre) {
				return (nombre || '')
					.split(/\s+/)
					.filter(Boolean)
					.slice(0, 2)
					.map((p) => p[0]?.toUpperCase())
					.join('') || '?';
			}

			function formatoPrecio(precio) {
				return new Intl.NumberFormat('es-CO').format(Number(precio));
			}

			async function cargarInmobiliaria() {
				const cont = document.getElementById('perfilInmobiliaria');
				const grid = document.getElementById('serviciosGrid');
				if (!cont || !grid) return;

				try {
					const res = await fetch(`/api/inmobiliarias/${id}`, { credentials: 'same-origin' });
					const json = await res.json();

					if (!res.ok || !json.ok || !json.data) {
						cont.innerHTML = `
							<div class="empty-state">
								<span>🔍</span>
								No encontramos esta inmobiliaria.
							</div>`;
						return;
					}

					const inm = json.data;
					const nombreSeguro = escapeHtml(inm.nombre);

					const logoHtml = inm.logo
						? `<img src="${inm.logo}" alt="${nombreSeguro}" class="perfil-logo">`
						: `<span class="perfil-logo perfil-logo--placeholder">${iniciales(inm.nombre)}</span>`;

					const filasContacto = [
						inm.ciudad ? `<span>📍 ${escapeHtml(inm.ciudad)}</span>` : '',
						inm.telefono ? `<span>📞 ${escapeHtml(inm.telefono)}</span>` : '',
						inm.correo ? `<span>✉️ ${escapeHtml(inm.correo)}</span>` : '',
					].filter(Boolean).join('');

					cont.innerHTML = `
						<div class="perfil-card">
							${logoHtml}
							<div class="perfil-datos">
								<h1>${nombreSeguro}</h1>
								${inm.descripcion ? `<p class="perfil-descripcion">${escapeHtml(inm.descripcion)}</p>` : ''}
								<div class="perfil-contacto">${filasContacto}</div>
							</div>
						</div>`;

					const servicios = inm.servicios ?? [];
					if (!servicios.length) {
						grid.innerHTML = `
							<div class="empty-state">
								<span>🛠️</span>
								Esta inmobiliaria aún no tiene servicios de mantenimiento activos.
							</div>`;
						return;
					}

					grid.innerHTML = servicios.map((s) => `
						<div class="card">
							<div class="card-img-container">
								${
									s.imagen
										? `<img src="${s.imagen}" alt="${escapeHtml(s.nombre)}" loading="lazy">`
										: `<div class="card-icon-placeholder">🛠️</div>`
								}
								<span class="badge-tipo">Disponible</span>
							</div>
							<div class="card-content">
								<h3>${escapeHtml(s.nombre)}</h3>
								<p>${escapeHtml(s.descripcion)}</p>
								<div class="card-bottom">
									<p class="price-tag"><span class="price-eyebrow">Desde</span>$${formatoPrecio(s.precio)}</p>
									${
										usuarioAutenticado
										? `<button type="button" class="btn-solicitar" data-id="${s.servicioID}" data-nombre="${escapeHtml(s.nombre)}">Solicitar</button>`
										: `<a href="/login?redirect=/inmobiliarias/${id}&solicitar=${s.servicioID}&nombre=${encodeURIComponent(s.nombre ?? '')}" class="btn-login-required">Inicia sesión</a>`
									}
								</div>
							</div>
						</div>`).join('');

					grid.querySelectorAll('.btn-solicitar').forEach((btn) => {
						btn.addEventListener('click', () => {
							abrirModalSolicitud(btn.dataset.id ?? '', btn.dataset.nombre ?? '');
						});
					});
				} catch (e) {
					cont.innerHTML = `
						<div class="empty-state">
							<span>⚠️</span>
							Ocurrió un error al cargar la inmobiliaria. Intenta nuevamente.
						</div>`;
					console.error(e);
				}
			}

			function abrirModalSolicitud(servicioId, nombre) {
				document.getElementById('modalServicioId').value = servicioId;
				document.getElementById('modalServicioNombre').textContent = nombre;
				document.getElementById('modalSolicitud')?.classList.add('active');
			}

			function cerrarModal(idModal) {
				document.getElementById(idModal)?.classList.remove('active');
			}

			function mostrarToast(mensaje, tipo = 'success') {
				const cont = document.getElementById('toastContainer');
				if (!cont) return;
				const toast = document.createElement('div');
				toast.className = `toast ${tipo}`;
				toast.textContent = mensaje;
				cont.appendChild(toast);
				setTimeout(() => toast.remove(), 4500);
			}

			document.addEventListener('DOMContentLoaded', () => {
				verificarSesion().then(cargarInmobiliaria);

				document.getElementById('menuToggle')?.addEventListener('click', () => {
					document.getElementById('menu')?.classList.toggle('active');
				});

				document.querySelectorAll('.modal-overlay').forEach((overlay) => {
					overlay.addEventListener('click', (e) => {
						if (e.target === overlay) overlay.classList.remove('active');
					});
				});

				document.getElementById('btnCerrarModal')?.addEventListener('click', () => cerrarModal('modalSolicitud'));
				document.getElementById('btnCancelarModal')?.addEventListener('click', () => cerrarModal('modalSolicitud'));

				const form = document.getElementById('formSolicitud');
				form?.addEventListener('submit', async (e) => {
					e.preventDefault();
					const servicioId = document.getElementById('modalServicioId').value;
					const notas = document.getElementById('modalNotas').value;
					try {
						const res = await fetch('/api/solicitar', {
							method: 'POST',
							credentials: 'same-origin',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ servicioId: Number(servicioId), notas }),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.message ?? 'No se pudo enviar la solicitud');
						cerrarModal('modalSolicitud');
						form.reset();
						mostrarToast('Solicitud enviada correctamente ✅');
					} catch (err) {
						mostrarToast(err.message ?? 'Error al enviar la solicitud', 'error');
					}
				});
			});
		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap');

	* { margin: 0; padding: 0; box-sizing: border-box; }
	body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #F9FCF3; }

	:root {
		--verde: #2E8B57;
		--verde-oscuro: #1b5e20;
		--verde-medio: #2e7d32;
		--verde-claro: #a5d6a7;
	}

	header { background: var(--verde-medio); }
	.topbar { display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; }
	.logo { font-size: 24px; font-weight: bold; color: white; }
	nav { display: flex; align-items: center; gap: 20px; }
	nav a { color: white; text-decoration: none; padding: 6px 10px; border-radius: 5px; font-size: 15px; }
	nav a:hover { background: var(--verde-claro); color: var(--verde-oscuro); }
	.btn-registrar { background: #f5f5dc; color: var(--verde-medio); font-weight: bold; }
	.menu-toggle { display: none; font-size: 26px; cursor: pointer; color: white; }

	.user-profile { position: relative; }
	.profile-pic { width: 40px; height: 40px; border-radius: 50%; cursor: pointer; border: 2px solid #fff; object-fit: cover; }
	.user-menu { display: none; position: absolute; right: 0; top: calc(100% + 10px); background: #fff; border: 1px solid #eaeaea; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,.1); min-width: 180px; padding: 8px 0; z-index: 999; }
	.user-menu.active { display: flex; flex-direction: column; }
	.user-menu-name { padding: 10px 16px; font-weight: bold; border-bottom: 1px solid #eee; margin-bottom: 4px; font-size: 14.5px; }
	.user-menu a, .user-menu button { display: block; width: 100%; padding: 10px 16px !important; color: #333 !important; text-align: left; background: none; border: none; font-size: 14.5px; cursor: pointer; text-decoration: none; }
	.user-menu a:hover, .user-menu button:hover { background: #f8f9fa !important; color: var(--verde-medio) !important; }

	@media (max-width: 900px) {
		nav { position: absolute; top: 65px; right: 0; background: var(--verde-medio); flex-direction: column; width: 240px; display: none; }
		nav.active { display: flex; }
		.menu-toggle { display: block; }
	}

	.contenedor { max-width: 1200px; margin: 0 auto; padding: 0 30px; }

	.section-header { display: flex; flex-direction: column; gap: 6px; padding: 40px 0 25px 0; text-align: left; }
	.section-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--verde); font-size: .85rem; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; }
	.section-eyebrow::before { content: ""; display: inline-block; width: 30px; height: 2px; background: var(--verde); }
	.section-title { font-family: 'Playfair Display', serif; font-size: 2.1rem; color: #1a1a1a; margin: 0; }
	.section-sub { color: #6c757d; font-size: 1rem; margin: 5px 0 0 0; }

	/* ── Perfil de la inmobiliaria ── */
	#perfilInmobiliaria { padding: 45px 30px 10px; }
	.perfil-card {
		display: flex;
		align-items: center;
		gap: 26px;
		background: #fff;
		border-radius: 18px;
		padding: 30px;
		box-shadow: 0 10px 30px rgba(15, 61, 36, 0.08);
		border: 1px solid #edf2ee;
	}
	.perfil-logo {
		width: 96px;
		height: 96px;
		border-radius: 18px;
		object-fit: cover;
		flex-shrink: 0;
		border: 1px solid #eef3ee;
		box-shadow: 0 4px 14px rgba(0,0,0,.08);
	}
	.perfil-logo--placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Playfair Display', serif;
		font-size: 2.2rem;
		font-weight: 700;
		color: #fff;
		background: linear-gradient(135deg, var(--verde-medio), var(--verde-oscuro));
	}
	.perfil-datos h1 { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--verde-oscuro); margin: 0 0 8px 0; }
	.perfil-descripcion { color: #555; font-size: .98rem; line-height: 1.55; margin-bottom: 12px; max-width: 640px; }
	.perfil-contacto { display: flex; flex-wrap: wrap; gap: 16px; font-size: .9rem; color: #444; font-weight: 600; }

	@media (max-width: 640px) {
		.perfil-card { flex-direction: column; text-align: center; }
		.perfil-contacto { justify-content: center; }
	}

	/* ── Grid + tarjetas (mismo lenguaje visual que /servicios) ── */
	.grid { padding: 0 30px 70px 30px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; }

	.empty-state { grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #666; background: white; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,.06); margin: 0 30px; }
	.empty-state span { display: block; font-size: 48px; margin-bottom: 10px; }

	.card { background: white; border-radius: 16px; overflow: hidden; border: 1px solid #edf2ee; box-shadow: 0 2px 10px rgba(15,61,36,.05); transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; display: flex; flex-direction: column; position: relative; }
	.card:hover { transform: translateY(-6px); box-shadow: 0 16px 32px rgba(15,61,36,.14); border-color: var(--verde-claro); }
	.card-img-container { position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: #eef3ee; }
	.card img, .card-img-container img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
	.card:hover img { transform: scale(1.08); }
	.card-icon-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 52px; background: linear-gradient(135deg, #e8f5e9, #c8e6c9); }
	.badge-tipo { position: absolute; top: 14px; left: 14px; display: inline-flex; align-items: center; gap: 5px; padding: 6px 13px; border-radius: 20px; background: rgba(255,255,255,.94); color: var(--verde-oscuro); font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
	.badge-tipo::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--verde-medio); }
	.card-content { padding: 20px 20px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
	.card-content h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: #1a1a1a; margin: 0; }
	.card-content p { font-size: .9rem; color: #666; line-height: 1.5; margin: 2px 0 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.card-bottom { margin-top: 14px; padding-top: 12px; border-top: 1px dashed #e7e7e7; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
	.price-tag { display: flex; flex-direction: column; line-height: 1.1; color: var(--verde-oscuro); font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; }
	.price-eyebrow { font-family: 'Segoe UI', sans-serif; color: #999; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
	.card-bottom button, .card-bottom .btn-login-required { background: var(--verde-medio); color: #fff; border: none; padding: 11px 18px; border-radius: 9px; cursor: pointer; font-weight: 700; font-size: .88rem; text-decoration: none; white-space: nowrap; box-shadow: 0 4px 12px rgba(46,125,50,.25); transition: background .3s ease, transform .2s ease; }
	.card-bottom button:hover { background: var(--verde-oscuro); transform: translateY(-1px); }
	.btn-login-required { background: #ececec !important; color: #555 !important; box-shadow: none !important; }
	.btn-login-required:hover { background: var(--verde-medio) !important; color: #fff !important; }

	/* ── Toast + Modal (idénticos a /servicios) ── */
	.toast { position: fixed; bottom: 28px; right: 28px; padding: 14px 22px; border-radius: 10px; font-size: 14px; font-weight: 600; z-index: 2500; box-shadow: 0 4px 20px rgba(0,0,0,.15); }
	.toast.success { background: var(--verde-medio); color: #fff; }
	.toast.error { background: #c0392b; color: #fff; }

	.modal-overlay { position: fixed; inset: 0; background: rgba(15,61,36,.6); backdrop-filter: blur(5px); z-index: 2000; display: none; align-items: center; justify-content: center; padding: 20px; }
	.modal-overlay.active { display: flex; }
	.modal-content { background: #fff; width: 100%; max-width: 480px; max-height: 90vh; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,.25); overflow-y: auto; position: relative; }
	.modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 26px; color: #999; cursor: pointer; }
	.modal-header { padding: 28px 30px 15px; border-bottom: 1px solid #eee; }
	.modal-title-wrap h2 { font-family: 'Playfair Display', serif; margin: 0 0 4px 0; color: var(--verde); font-size: 22px; }
	.modal-title-wrap p { margin: 0; color: #777; font-size: 14px; font-weight: 600; }
	.modal-body { padding: 20px 30px 30px; }
	.modal-body .form-row { margin-bottom: 18px; }
	.modal-body label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; color: #333; }
	.modal-body textarea { width: 100%; border: 1px solid #ddd; border-radius: 8px; padding: 10px; font-family: inherit; font-size: 14px; resize: vertical; }
	.modal-footer { display: flex; justify-content: flex-end; gap: 10px; }
	.btn-secondary { background: #eee; color: #444; border: none; padding: 9px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; }
	.btn-confirm { background: var(--verde-medio); color: #fff; border: none; padding: 9px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; }
	.btn-confirm:hover { background: var(--verde-oscuro); }
</style>
