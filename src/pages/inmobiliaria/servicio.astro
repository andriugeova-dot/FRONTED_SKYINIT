---
import ServicioCard from '../../components/inmobiliaria/servicioCard.astro';
import ServicioModal from '../../components/inmobiliaria/serviciomodal.astro';

interface ServicioInmobiliaria {
  ServicioID: number;
  InmobiliariaID: number | null;
  Nombre: string;
  Descripcion: string;
  Precio: string | number;
  Estado: 'Activo' | 'Inactivo';
  Imagen?: string | null;
}

const cookieHeader = Astro.request.headers.get('cookie') || '';
let serviciosIniciales: ServicioInmobiliaria[] = [];
let errorCargaInicial: string | null = null;

try {
  const response = await fetch('http://localhost:8001/api/inmobiliaria/servicios', {
    headers: { Cookie: cookieHeader },
  });
  if (response.ok) {
    const json = await response.json();
    serviciosIniciales = (json.data ?? []) as ServicioInmobiliaria[];
  } else {
    errorCargaInicial = 'No se pudieron cargar los servicios iniciales.';
  }
} catch {
  errorCargaInicial = 'Error de conexión con el servidor backend.';
}

const totalCount = serviciosIniciales.length;
const activosCount = serviciosIniciales.filter((s) => s.Estado === 'Activo').length;
const inactivosCount = serviciosIniciales.filter((s) => s.Estado === 'Inactivo').length;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gestión de Servicios - SkyInit</title>

  <!-- Google Fonts: Playfair Display e Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap CSS (debe importarse ANTES del CSS del módulo) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <!-- CSS del Módulo Inmobiliaria -->
  <link rel="stylesheet" href="/src/styles/inmobiliaria-servicios.css" />
</head>
<body>

  <div class="dashboard-wrapper">
    <!-- Sidebar Embebido (position: sticky) -->
    <aside class="sidebar-embedded" aria-label="Navegación del panel">
      <a href="/inmobiliaria/dashboard" class="brand">SkyInit Panel</a>
      <ul class="sidebar-menu">
        <li><a href="/inmobiliaria/dashboard" class="sidebar-link"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
        <li><a href="/inmobiliaria/propiedades" class="sidebar-link"><i class="bi bi-house-door"></i> Propiedades</a></li>
        <li><a href="/inmobiliaria/servicios" class="sidebar-link active" aria-current="page"><i class="bi bi-tools"></i> Servicios</a></li>
        <li><a href="/inmobiliaria/solicitudes" class="sidebar-link"><i class="bi bi-clipboard-check"></i> Solicitudes</a></li>
      </ul>
    </aside>

    <!-- Contenido Principal -->
    <main class="main-content">
      <!-- Encabezado -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
          <h1 class="page-title">Servicios de Mantenimiento</h1>
          <p class="page-subtitle">Gestiona el catálogo de servicios ofrecidos por tu inmobiliaria.</p>
        </div>
        <button class="btn btn-sky-primary d-flex align-items-center gap-2" id="btnNuevoServicio">
          <i class="bi bi-plus-lg"></i>
          <span>Nuevo servicio</span>
        </button>
      </div>

      <!-- Tarjetas Resumen -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="stat-card">
            <div class="stat-title">Total Servicios</div>
            <div class="stat-value" id="statTotal">{totalCount}</div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card stat-activos">
            <div class="stat-title">Servicios Activos</div>
            <div class="stat-value" id="statActivos">{activosCount}</div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-card stat-inactivos">
            <div class="stat-title">Servicios Inactivos</div>
            <div class="stat-value" id="statInactivos">{inactivosCount}</div>
          </div>
        </div>
      </div>

      <!-- Buscador y Filtro por Estado -->
      <div class="filter-bar">
        <div class="row g-3">
          <div class="col-md-8">
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="inputBuscar" class="form-control border-start-0" placeholder="Buscar por nombre de servicio..." aria-label="Buscar servicio por nombre" />
            </div>
          </div>
          <div class="col-md-4">
            <select id="selectEstado" class="form-select" aria-label="Filtrar por estado">
              <option value="">Todos los estados</option>
              <option value="Activo">Activos</option>
              <option value="Inactivo">Inactivos</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Estado de Carga -->
      <div id="loadingState" class="text-center py-5 d-none">
        <div class="spinner-border text-success" role="status">
          <span class="visually-hidden">Cargando servicios...</span>
        </div>
        <p class="mt-2 text-muted">Cargando catálogo de servicios...</p>
      </div>

      <!-- Estado de Error -->
      <div id="errorState" class={`alert alert-danger py-3 ${errorCargaInicial ? '' : 'd-none'}`} role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span id="errorMessage">{errorCargaInicial || 'Ocurrió un error al cargar la información.'}</span>
      </div>

      <!-- Estado Vacío -->
      <div id="emptyState" class={`text-center py-5 bg-white rounded border ${serviciosIniciales.length === 0 && !errorCargaInicial ? '' : 'd-none'}`}>
        <i class="bi bi-tools display-4 text-muted"></i>
        <h3 class="mt-3 text-secondary" style="font-family: var(--font-title);">No hay servicios registrados</h3>
        <p class="text-muted">Aún no se han publicado servicios o no se encontraron coincidencias.</p>
      </div>

      <!-- Grilla de Servicios -->
      <div id="gridServicios" class="services-grid">
        {serviciosIniciales.map((servicio) => (
          <ServicioCard servicio={servicio} />
        ))}
      </div>
    </main>
  </div>

  <!-- Modal Crear/Editar Servicio -->
  <ServicioModal />

  <!-- Modal Confirmación Eliminar / Desactivar (Conflicto 409) -->
  <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title font-weight-bold" id="modalConfirmarLabel">Confirmar Acción</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body" id="modalConfirmarBody">
          ¿Está seguro de que desea realizar esta acción?
        </div>
        <div class="modal-footer" id="modalConfirmarFooter">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btnEjecutarConfirmar">Aceptar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenedor de Toasts -->
  <div class="toast-container-custom">
    <div id="toastFeedback" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body" id="toastMessage">Operación realizada con éxito.</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
      </div>
    </div>
  </div>

  <!-- Scripts JS de Bootstrap -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Lógica Cliente con define:vars -->
  <script define:vars={{ initialServices: serviciosIniciales }}>
    document.addEventListener('DOMContentLoaded', () => {
      let listadoServicios = initialServices || [];
      let bsModalForm = new bootstrap.Modal(document.getElementById('modalServicio'));
      let bsModalConfirm = new bootstrap.Modal(document.getElementById('modalConfirmar'));
      let bsToast = new bootstrap.Toast(document.getElementById('toastFeedback'));

      let servicioAEliminarId = null;

      const inputBuscar = document.getElementById('inputBuscar');
      const selectEstado = document.getElementById('selectEstado');
      const gridServicios = document.getElementById('gridServicios');
      const emptyState = document.getElementById('emptyState');
      const loadingState = document.getElementById('loadingState');
      const errorState = document.getElementById('errorState');
      const formServicio = document.getElementById('formServicio');
      const btnNuevoServicio = document.getElementById('btnNuevoServicio');
      const imagenInput = document.getElementById('imagenInput');
      const imgPreview = document.getElementById('imgPreview');

      let currentBase64Image = '';

      // Mostrar Toast
      function showToast(message, isSuccess = true) {
        const toastEl = document.getElementById('toastFeedback');
        const toastMsg = document.getElementById('toastMessage');
        toastEl.className = `toast align-items-center text-white border-0 ${isSuccess ? 'bg-success' : 'bg-danger'}`;
        toastMsg.textContent = message;
        bsToast.show();
      }

      // Renderizar Resumen
      function actualizarEstadisticas() {
        const total = listadoServicios.length;
        const activos = listadoServicios.filter(s => s.Estado === 'Activo').length;
        const inactivos = listadoServicios.filter(s => s.Estado === 'Inactivo').length;

        document.getElementById('statTotal').textContent = total;
        document.getElementById('statActivos').textContent = activos;
        document.getElementById('statInactivos').textContent = inactivos;
      }

      // Cargar lista con filtros desde el Proxy API
      async function fetchServicios() {
        const q = inputBuscar.value.trim();
        const estado = selectEstado.value;

        loadingState.classList.remove('d-none');
        gridServicios.classList.add('d-none');
        emptyState.classList.add('d-none');
        errorState.classList.add('d-none');

        try {
          const res = await fetch(`/api/inmobiliaria/servicios?q=${encodeURIComponent(q)}&estado=${encodeURIComponent(estado)}`);
          const json = await res.json();

          if (res.ok && json.ok) {
            listadoServicios = json.data || [];
            renderGrid(listadoServicios);
            actualizarEstadisticas();
          } else {
            document.getElementById('errorMessage').textContent = json.message || 'Error al filtrar los servicios.';
            errorState.classList.remove('d-none');
          }
        } catch (err) {
          document.getElementById('errorMessage').textContent = 'Error de conexión con el servidor.';
          errorState.classList.remove('d-none');
        } finally {
          loadingState.classList.add('d-none');
        }
      }

      // Renderizar Grilla con prevencion XSS
      function renderGrid(servicios) {
        gridServicios.innerHTML = '';
        if (servicios.length === 0) {
          emptyState.classList.remove('d-none');
          gridServicios.classList.add('d-none');
          return;
        }

        emptyState.classList.add('d-none');
        gridServicios.classList.remove('d-none');

        const formatter = new Intl.NumberFormat('es-CO', {
          style: 'currency',
          currency: 'COP',
          maximumFractionDigits: 0
        });

        servicios.forEach(s => {
          const card = document.createElement('div');
          card.className = 'service-card';
          card.dataset.id = s.ServicioID;

          const precioFormatted = formatter.format(s.Precio);
          const imgUrl = (s.Imagen && s.Imagen.trim() !== '') ? s.Imagen : '/img/servicios-placeholder.webp';

          card.innerHTML = `
            <div class="service-img-wrapper">
              <img src="${imgUrl}" alt="Imagen del servicio" loading="lazy">
              <span class="badge-status ${s.Estado === 'Activo' ? 'badge-activo' : 'badge-inactivo'}">${s.Estado}</span>
            </div>
            <div class="service-card-body">
              <h3 class="service-title"></h3>
              <p class="service-desc"></p>
              <div class="service-price">${precioFormatted}</div>
            </div>
            <div class="service-actions">
              <button class="btn btn-sm btn-outline-primary flex-grow-1 btn-editar" data-id="${s.ServicioID}">
                <i class="bi bi-pencil me-1"></i> Editar
              </button>
              <button class="btn btn-sm btn-outline-secondary btn-estado" data-id="${s.ServicioID}" data-estado="${s.Estado}">
                ${s.Estado === 'Activo' ? 'Desactivar' : 'Activar'}
              </button>
              <button class="btn btn-sm btn-outline-danger btn-eliminar" data-id="${s.ServicioID}" data-nombre="">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          `;

          // Escape XSS mediante textContent
          card.querySelector('.service-title').textContent = s.Nombre;
          card.querySelector('.service-desc').textContent = s.Descripcion;
          card.querySelector('.btn-eliminar').dataset.nombre = s.Nombre;

          gridServicios.appendChild(card);
        });
      }

      // Eventos de filtro
      inputBuscar.addEventListener('input', debounce(fetchServicios, 300));
      selectEstado.addEventListener('change', fetchServicios);

      function debounce(fn, delay) {
        let timeoutId;
        return (...args) => {
          clearTimeout(timeoutId);
          timeoutId = setTimeout(() => fn.apply(this, args), delay);
        };
      }

      // Previsualización de Imagen + Validación Tamaño/Formato
      imagenInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        const errorImg = document.getElementById('error-imagen');
        errorImg.textContent = '';

        if (!file) {
          imgPreview.src = '/img/servicios-placeholder.webp';
          currentBase64Image = '';
          return;
        }

        const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        if (!validTypes.includes(file.type)) {
          errorImg.textContent = 'Formato no válido. Use JPG, PNG o WEBP.';
          imagenInput.value = '';
          return;
        }

        if (file.size > 2 * 1024 * 1024) {
          errorImg.textContent = 'La imagen no debe superar los 2 MB.';
          imagenInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = (evt) => {
          imgPreview.src = evt.target.result;
          currentBase64Image = evt.target.result;
        };
        reader.readAsDataURL(file);
      });

      // Abrir Modal Crear
      btnNuevoServicio.addEventListener('click', () => {
        limpiarErrores();
        formServicio.reset();
        document.getElementById('servicioId').value = '';
        document.getElementById('modalServicioLabel').textContent = 'Nuevo Servicio de Mantenimiento';
        imgPreview.src = '/img/servicios-placeholder.webp';
        currentBase64Image = '';
        bsModalForm.show();
      });

      // Delegación de Eventos en Tarjetas (Editar, Cambiar Estado, Eliminar)
      gridServicios.addEventListener('click', async (e) => {
        const btnEditar = e.target.closest('.btn-editar');
        const btnEstado = e.target.closest('.btn-estado');
        const btnEliminar = e.target.closest('.btn-eliminar');

        if (btnEditar) {
          const id = btnEditar.dataset.id;
          const servicio = listadoServicios.find(s => s.ServicioID == id);
          if (servicio) abrirEditarModal(servicio);
        }

        if (btnEstado) {
          const id = btnEstado.dataset.id;
          const estadoActual = btnEstado.dataset.estado;
          const nuevoEstado = estadoActual === 'Activo' ? 'Inactivo' : 'Activo';
          await cambiarEstadoServicio(id, nuevoEstado);
        }

        if (btnEliminar) {
          const id = btnEliminar.dataset.id;
          const nombre = btnEliminar.dataset.nombre;
          solicitarEliminacion(id, nombre);
        }
      });

      function abrirEditarModal(servicio) {
        limpiarErrores();
        document.getElementById('servicioId').value = servicio.ServicioID;
        document.getElementById('nombre').value = servicio.Nombre;
        document.getElementById('precio').value = servicio.Precio;
        document.getElementById('estado').value = servicio.Estado;
        document.getElementById('descripcion').value = servicio.Descripcion;
        imgPreview.src = servicio.Imagen || '/img/servicios-placeholder.webp';
        document.getElementById('modalServicioLabel').textContent = 'Editar Servicio de Mantenimiento';
        bsModalForm.show();
      }

      function limpiarErrores() {
        document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
      }

      // Envío de Formulario Crear / Editar
      formServicio.addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarErrores();

        const id = document.getElementById('servicioId').value;
        const nombre = document.getElementById('nombre').value.trim();
        const precio = parseFloat(document.getElementById('precio').value);
        const estado = document.getElementById('estado').value;
        const descripcion = document.getElementById('descripcion').value.trim();

        // Validación en cliente
        let hasError = false;

        if (nombre.length < 3 || nombre.length > 150) {
          document.getElementById('error-nombre').textContent = 'El nombre debe tener entre 3 y 150 caracteres.';
          hasError = true;
        }

        if (isNaN(precio) || precio <= 0) {
          document.getElementById('error-precio').textContent = 'El precio debe ser un número mayor a 0.';
          hasError = true;
        }

        if (descripcion.length < 20) {
          document.getElementById('error-descripcion').textContent = 'La descripción debe tener al menos 20 caracteres.';
          hasError = true;
        }

        if (hasError) return;

        /**
         * TODO: SUBIDA DE IMAGEN A SERVIDOR
         * La carga de archivos debe reutilizar el endpoint central de almacenamiento
         * (e.g. guardando la imagen en /img/Servicios/<uuid>.<ext>).
         * Por ahora se envía la ruta preexistente o vacía si no se selecciona archivo nuevo.
         */
        const payload = {
          Nombre: nombre,
          Precio: precio,
          Estado: estado,
          Descripcion: descripcion,
          Imagen: currentBase64Image || imgPreview.src
        };

        const isEdit = Boolean(id);
        const url = isEdit ? `/api/inmobiliaria/servicios/${id}` : '/api/inmobiliaria/servicios';
        const method = isEdit ? 'PUT' : 'POST';

        const btnSubmit = document.getElementById('btnGuardarServicio');
        const spinner = document.getElementById('spinnerGuardar');
        btnSubmit.disabled = true;
        spinner.classList.remove('d-none');

        try {
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const json = await res.json();

          if (res.ok && json.ok) {
            bsModalForm.hide();
            showToast(isEdit ? 'Servicio actualizado correctamente.' : 'Servicio creado correctamente.');
            await fetchServicios();
          } else if (res.status === 422 && json.errors) {
            // Mostrar errores de validación 422 campo por campo
            Object.keys(json.errors).forEach(field => {
              const errEl = document.getElementById(`error-${field.toLowerCase()}`);
              if (errEl) errEl.textContent = json.errors[field];
            });
          } else {
            showToast(json.message || 'Ocurrió un error al guardar.', false);
          }
        } catch (err) {
          showToast('Error de conexión al guardar el servicio.', false);
        } finally {
          btnSubmit.disabled = false;
          spinner.classList.add('d-none');
        }
      });

      // PATCH - Cambiar estado
      async function cambiarEstadoServicio(id, nuevoEstado) {
        try {
          const res = await fetch(`/api/inmobiliaria/servicios/${id}/estado`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ estado: nuevoEstado })
          });
          const json = await res.json();

          if (res.ok && json.ok) {
            showToast(`Servicio ${nuevoEstado === 'Activo' ? 'activado' : 'desactivado'} con éxito.`);
            await fetchServicios();
          } else {
            showToast(json.message || 'No se pudo cambiar el estado.', false);
          }
        } catch (err) {
          showToast('Error de red al cambiar estado.', false);
        }
      }

      // DELETE - Confirmar y eliminar / Manejo de conflicto 409
      function solicitarEliminacion(id, nombre) {
        servicioAEliminarId = id;
        document.getElementById('modalConfirmarLabel').textContent = 'Confirmar Eliminación';
        document.getElementById('modalConfirmarBody').innerHTML = `¿Está seguro de eliminar el servicio <strong>${escapeHTML(nombre)}</strong>?`;

        const footer = document.getElementById('modalConfirmarFooter');
        footer.innerHTML = `
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btnConfirmarDeleteAction">Eliminar</button>
        `;

        document.getElementById('btnConfirmarDeleteAction').addEventListener('click', () => ejecutarEliminacion(id));
        bsModalConfirm.show();
      }

      async function ejecutarEliminacion(id) {
        try {
          const res = await fetch(`/api/inmobiliaria/servicios/${id}`, { method: 'DELETE' });
          const json = await res.json();

          if (res.ok && json.ok) {
            bsModalConfirm.hide();
            showToast('Servicio eliminado exitosamente.');
            await fetchServicios();
          } else if (res.status === 409) {
            // Manejo especial del conflicto 409 (servicio con solicitudes activas)
            document.getElementById('modalConfirmarLabel').textContent = 'No se puede eliminar';
            document.getElementById('modalConfirmarBody').innerHTML = `
              <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i> ${escapeHTML(json.message || 'Este servicio tiene solicitudes activas asociadas.')}
                <p class="mt-2 mb-0">¿Desea cambiar su estado a <strong>Inactivo</strong> en su lugar?</p>
              </div>
            `;

            const footer = document.getElementById('modalConfirmarFooter');
            footer.innerHTML = `
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="button" class="btn btn-warning" id="btnDesactivarConflict">Desactivar Servicio</button>
            `;

            document.getElementById('btnDesactivarConflict').addEventListener('click', async () => {
              bsModalConfirm.hide();
              await cambiarEstadoServicio(id, 'Inactivo');
            });
          } else {
            bsModalConfirm.hide();
            showToast(json.message || 'Error al eliminar el servicio.', false);
          }
        } catch (err) {
          bsModalConfirm.hide();
          showToast('Error de conexión al eliminar.', false);
        }
      }

      function escapeHTML(str) {
        return str.replace(/[&<>'"]/g, 
          tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
        );
      }
    });
  </script>
</body>
</html>