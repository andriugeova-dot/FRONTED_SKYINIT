---
import Navbar from "../components/menu/Navbar.astro";
import "../components/menu/menu.css";

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Servicios de Mantenimiento | SkyInit</title>
	</head>
	<body>
		<!-- ▌HEADER / HERO ▐ -->
		<header id="header">
            <Navbar />

			<div class="hero-inner">
				<div class="hero-eyebrow">Cuidamos tu hogar</div>
				<h1>Mantenimiento <em>profesional</em> para tu vivienda</h1>
				<p class="hero-sub">
					Conecta con especialistas certificados para reparaciones, mantenimiento y mejoras en tu
					hogar, con la confianza que solo SkyInit te ofrece.
				</p>
			</div>
		</header>

		<!-- ▌ENCABEZADO DE SECCIÓN ▐ -->
		<section class="contenedor">
			<div class="section-header">
				<span class="section-eyebrow">Nuestra oferta</span>
				<h2 class="section-title">Servicios de Mantenimiento</h2>
				<p class="section-sub">
					Soluciones prácticas y confiables para el cuidado de tu hogar, con proveedores
					verificados por SkyInit
				</p>
			</div>
		</section>

		<!-- ▌SERVICIOS AGRUPADOS POR INMOBILIARIA (se llena por JS con /api/servicios) ▐ -->
		<section class="contenedor" id="serviciosGrid">
			<div class="empty-state">
				<span>⏳</span>
				Cargando servicios...
			</div>
		</section>

		<!-- ▌MODAL SOLICITAR SERVICIO ▐ -->
		<div class="modal-overlay" id="modalSolicitud">
			<div class="modal-content">
				<button type="button" class="modal-close" id="btnCerrarModal">&times;</button>
				<div class="modal-header">
					<div class="modal-title-wrap">
						<h2>Solicitar servicio</h2>
						<p id="modalServicioNombre"></p>
					</div>
				</div>
				<div class="modal-body">
					<form id="formSolicitud">
						<input type="hidden" name="servicioId" id="modalServicioId" />

						<div class="form-row">
							<label for="modalNotas">Detalles adicionales (opcional)</label>
							<textarea
								name="notas"
								id="modalNotas"
								rows="4"
								placeholder="Ej: dirección del inmueble, disponibilidad de horario, descripción del problema..."
							></textarea>
						</div>

						<div class="modal-footer">
							<button type="button" class="btn-secondary" id="btnCancelarModal">Cancelar</button>
							<button type="submit" class="btn-confirm">✅ Enviar solicitud</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<div id="toastContainer"></div>

		<script>
			import {
				obtenerServiciosRequest,
				solicitarServicioRequest,
				type GrupoServiciosInmobiliaria,
				type ServicioMantenimiento,
			} from '../utils/api';

const BACKEND_PUBLIC = "http://localhost:8001";

function urlPublica(ruta: string | null | undefined) {
  if (!ruta || !ruta.trim()) return "";
  const r = ruta.trim();
  if (r.startsWith("http") || r.startsWith("data:")) return r;
  if (r.startsWith("/uploads/")) return `${BACKEND_PUBLIC}${r}`;
  return r;
}

function iniciales(nombre: string) {
  const p = nombre.trim().split(/\s+/).filter(Boolean);
  if (!p.length) return "U";
  if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
  return (p[0][0] + p[1][0]).toUpperCase();
}

let usuarioAutenticado = false;
let nombreUsuario = "";
let fotoPerfil = "";

async function verificarSesion() {
  try {
    const res = await fetch("/api/perfil", { credentials: "same-origin" });
    if (res.ok) {
      const data = await res.json();
      const u = data.usuario ?? data;
      usuarioAutenticado = true;
      nombreUsuario = u.nombre ?? "";
      fotoPerfil = urlPublica(u.fotoPerfil ?? u.FotoPerfil);
    }
  } catch {
    /* sin sesión */
  }
  renderUserMenu();
}

function renderUserMenu() {
  const nav = document.getElementById("navUser");
  if (!nav) return;

  if (usuarioAutenticado) {
    const avatar = fotoPerfil
      ? `<img src="${fotoPerfil}" alt="Perfil" class="profile-pic" id="profilePic" />`
      : `<button type="button" class="profile-pic profile-iniciales" id="profilePic">${iniciales(nombreUsuario)}</button>`;

    nav.innerHTML = `
      <div class="user-profile">
        ${avatar}
        <div id="user-menu" class="user-menu">
          <div class="user-menu-name">${nombreUsuario}</div>
          <a href="/usuario">⚙️ Ajustes</a>
          <button type="button" id="btnLogout">🚪 Cerrar sesión</button>
        </div>
      </div>`;

    document.getElementById("profilePic")?.addEventListener("click", () => {
      document.getElementById("user-menu")?.classList.toggle("active");
    });

    document.getElementById("btnLogout")?.addEventListener("click", async () => {
      await fetch("/api/logout", { method: "POST", credentials: "same-origin" });
      location.reload();
    });
  } else {
    nav.innerHTML = `<a href="/login" class="btn-registrar">Iniciar Sesión</a>`;
  }
}



// ── Catálogo de servicios ───────────────────────────
function formatoPrecio(precio: string | number) {
    return new Intl.NumberFormat('es-CO').format(Number(precio));
}

function escapeHtml(valor: string | null | undefined) {
    return (valor ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
}


// Bloque clicable con el logo + nombre de la inmobiliaria que ofrece el servicio.
// Si no hay InmobiliariaID (servicio publicado directo por SkyInit) no es clicable.
function renderProveedorChip(inmobiliariaID: number | null, nombre: string, logo: string | null) {
    const nombreSeguro = escapeHtml(nombre);
    const contenido = `
        ${
            logo
                ? `<img src="${urlPublica(logo)}" alt="${nombreSeguro}" class="proveedor-logo" loading="lazy">`
                : `<span class="proveedor-logo proveedor-logo--placeholder">${iniciales(nombre)}</span>`
        }
        <span class="proveedor-nombre">${nombreSeguro}</span>
        ${inmobiliariaID ? `<span class="proveedor-flecha" aria-hidden="true"></span>` : ''}
    `;

    if (!inmobiliariaID) {
        return `<div class="proveedor-chip proveedor-chip--sin-link">${contenido}</div>`;
    }

    return `
        <a href="/inmobiliarias/${inmobiliariaID}" class="proveedor-chip" title="Ver perfil de ${nombreSeguro}">
            ${contenido}
        </a>`;
}


function renderCardServicio(s: ServicioMantenimiento, grupo: GrupoServiciosInmobiliaria) {
    const nombreSeguro = escapeHtml(s.nombre);
    return `
    <div class="card">
        <div class="card-img-container">
            ${
                s.imagen
                    ? `<img src="${urlPublica(s.imagen)}" alt="${nombreSeguro}" loading="lazy">`
                    : `<div class="card-icon-placeholder">🛠️</div>`
            }
            <span class="badge-tipo">Disponible</span>
        </div>
        <div class="card-content">
            <h3>${nombreSeguro}</h3>
            <p>${escapeHtml(s.descripcion)}</p>

            ${renderProveedorChip(grupo.inmobiliariaID, grupo.inmobiliaria, grupo.inmobiliariaLogo)}

            <div class="card-bottom">
                <p class="price-tag"><span class="price-eyebrow">Desde</span>$${formatoPrecio(s.precio)}</p>
                ${
                    usuarioAutenticado
                    ? `<button type="button" class="btn-solicitar" data-id="${s.servicioID}" data-nombre="${nombreSeguro}">Solicitar</button>`
                    : `<a href="/login?redirect=/servicios&solicitar=${s.servicioID}&nombre=${encodeURIComponent(s.nombre ?? '')}" class="btn-login-required">Inicia sesión para solicitar</a>`
                }
            </div>
        </div>
    </div>`;
}

function renderGrupo(grupo: GrupoServiciosInmobiliaria) {
    const nombreSeguro = escapeHtml(grupo.inmobiliaria);
    const cantidad = grupo.servicios.length;
    const textoCantidad = `${cantidad} ${cantidad === 1 ? 'servicio disponible' : 'servicios disponibles'}`;

    const logoHtml = grupo.inmobiliariaLogo
        ? `<img src="${urlPublica(grupo.inmobiliariaLogo)}" alt="${nombreSeguro}" class="grupo-logo">`
        : `<span class="grupo-logo grupo-logo-placeholder">${iniciales(grupo.inmobiliaria)}</span>`;

    const headerInner = `
        ${logoHtml}
        <div class="grupo-header-texto">
            <h3 class="grupo-nombre">${nombreSeguro}</h3>
            <span class="grupo-count">${textoCantidad}</span>
        </div>
        ${grupo.inmobiliariaID ? `<span class="grupo-ver-mas">Ver inmobiliaria <span aria-hidden="true">→</span></span>` : ''}
    `;

    const header = grupo.inmobiliariaID
        ? `<a href="/inmobiliarias/${grupo.inmobiliariaID}" class="grupo-header" title="Ver perfil de ${nombreSeguro}">${headerInner}</a>`
        : `<div class="grupo-header grupo-header--sin-link">${headerInner}</div>`;

    return `
    <div class="grupo-inmobiliaria">
        ${header}
        <div class="grid">
            ${grupo.servicios.map((s) => renderCardServicio(s, grupo)).join('')}
        </div>
    </div>`;
}

async function cargarServicios() {
    const grid = document.getElementById('serviciosGrid');
    if (!grid) return;

    try {
        const res = await fetch('/api/servicios', { credentials: 'same-origin' });
        if (!res.ok) throw new Error('No se pudieron cargar los servicios');
        const json = await res.json();
        const grupos: GrupoServiciosInmobiliaria[] = json.data ?? [];

        const totalServicios = grupos.reduce((acc, g) => acc + g.servicios.length, 0);
        if (!totalServicios) {
            grid.innerHTML = `
                <div class="empty-state">
                    <span>🛠️</span>
                    No hay servicios de mantenimiento disponibles por el momento.
                </div>`;
            return;
        }

        grid.innerHTML = grupos.map(renderGrupo).join('');

        grid.querySelectorAll('.btn-solicitar').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = (btn as HTMLElement).dataset.id ?? '';
                const nombre = (btn as HTMLElement).dataset.nombre ?? '';
                abrirModalSolicitud(id, nombre);
            });
        });
    } catch (e) {
        grid.innerHTML = `
            <div class="empty-state">
                <span>⚠️</span>
                Ocurrió un error al cargar los servicios. Intenta nuevamente.
            </div>`;
        console.error(e);
    }
}

// ── Modal ────────────────────────────────────────────
function abrirModalSolicitud(servicioId: string, nombre: string) {
    (document.getElementById('modalServicioId') as HTMLInputElement).value = servicioId;
    document.getElementById('modalServicioNombre')!.textContent = nombre;
    document.getElementById('modalSolicitud')?.classList.add('active');
}

function cerrarModal(id: string) {
    document.getElementById(id)?.classList.remove('active');
}

function abrirSolicitudPendiente() {
    if (!usuarioAutenticado) return;

    const params = new URLSearchParams(window.location.search);
    const id = params.get('solicitar');
    if (!id) return;

    const nombre = params.get('nombre') ?? '';
    abrirModalSolicitud(id, nombre);
    history.replaceState({}, '', '/servicios');
}

function mostrarToast(mensaje: string, tipo: 'success' | 'error' = 'success') {
    const cont = document.getElementById('toastContainer');
    if (!cont) return;
    const toast = document.createElement('div');
    toast.className = `toast ${tipo}`;
    toast.textContent = mensaje;
    cont.appendChild(toast);
    setTimeout(() => toast.remove(), 4500);
}

document.addEventListener('DOMContentLoaded', () => {
    verificarSesion().then(async () => {
        await cargarServicios();
        abrirSolicitudPendiente();
    });

    document.getElementById('menuToggle')?.addEventListener('click', () => {
        document.getElementById('menu')?.classList.toggle('active');
    });

    document.querySelectorAll('.modal-overlay').forEach((overlay) => {
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) overlay.classList.remove('active');
        });
    });

    document.getElementById('btnCerrarModal')?.addEventListener('click', () =>
        cerrarModal('modalSolicitud')
    );
    document.getElementById('btnCancelarModal')?.addEventListener('click', () =>
        cerrarModal('modalSolicitud')
    );

    const form = document.getElementById('formSolicitud') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const servicioId = (document.getElementById('modalServicioId') as HTMLInputElement).value;
        const notas = (document.getElementById('modalNotas') as HTMLTextAreaElement).value;

        try {
            const res = await fetch('/api/solicitar', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ servicioId: Number(servicioId), notas }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message ?? 'No se pudo enviar la solicitud');

            cerrarModal('modalSolicitud');
            form.reset();
            mostrarToast('Solicitud enviada correctamente ✅');
        } catch (err: any) {
            mostrarToast(err.message ?? 'Error al enviar la solicitud', 'error');
        }
    });

    const images = [
        'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789',
        'https://images.unsplash.com/photo-1581141849291-1125c7b692b5',
        'https://images.unsplash.com/photo-1599423300746-b62533397364',
    ];
    let index = 0;
    const header = document.getElementById('header');
    function cambiarFondo() {
        if (!header) return;
        header.style.backgroundImage = `url(${images[index]})`;
        index = (index + 1) % images.length;
    }
    cambiarFondo();
    setInterval(cambiarFondo, 7500);
});
		</script>
	</body>
</html>

<style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #F9FCF3;
}

:root {
    --verde: #2E8B57;
    --verde-oscuro: #1b5e20;
    --verde-medio: #2e7d32;
    --verde-claro: #a5d6a7;
}

/* ===========================================
   HEADER / HERO
   =========================================== */
header {
    height: 60vh;
    min-height: 420px;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    background-size: cover;
    background-position: center;
    transition: background-image 1s ease-in-out;
}

header::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
}

/* HERO TEXTO */
.hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    padding: 0 20px;
    z-index: 2;
    margin-bottom: 40px;
}

.hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    border-radius: 30px;
    padding: 7px 18px;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    margin: 0 auto 24px auto;
}

.hero-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--verde-claro);
    border-radius: 50%;
}

.hero-inner h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 20px;
    max-width: 700px;
    margin-top: 0;
}

.hero-inner h1 em {
    color: var(--verde-claro);
    font-style: normal;
}

.hero-sub {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
    max-width: 520px;
    margin: 0;
}

/* ===========================================
   CONTENEDOR Y ENCABEZADO DE SECCIÓN
   =========================================== */
.contenedor {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px;
}

.section-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 50px 0 35px 0;
    text-align: left;
}

.section-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--verde);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.section-eyebrow::before {
    content: "";
    display: inline-block;
    width: 30px;
    height: 2px;
    background-color: var(--verde);
}

.section-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.15;
}

.section-sub {
    color: #6c757d;
    font-size: 1.05rem;
    margin: 5px 0 0 0;
}

/* ===========================================
   GRUPOS DE SERVICIOS POR INMOBILIARIA
   =========================================== */
.grupo-inmobiliaria {
    margin-bottom: 50px;
}

.grupo-inmobiliaria:last-child {
    margin-bottom: 0;
}

.grupo-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border: 1px solid #e7efe8;
    border-radius: 14px;
    margin-bottom: 25px;
    background: #ffffff;
    box-shadow: 0 3px 12px rgba(27, 94, 32, 0.05);
    text-decoration: none;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
}

a.grupo-header:hover {
    box-shadow: 0 10px 22px rgba(27, 94, 32, 0.12);
    border-color: var(--verde-claro);
    transform: translateY(-2px);
}

.grupo-header--sin-link {
    cursor: default;
}

.grupo-logo {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid #eef3ee;
}

.grupo-logo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 700;
    color: var(--verde-oscuro);
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    font-family: 'Playfair Display', serif;
}

.grupo-header-texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
}

.grupo-nombre {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    color: var(--verde-oscuro);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.grupo-count {
    font-size: 0.85rem;
    color: #888;
    font-weight: 600;
}

.grupo-ver-mas {
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--verde-medio);
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    border-radius: 20px;
    background: #eef7ee;
    transition: background 0.25s ease, gap 0.25s ease;
}

a.grupo-header:hover .grupo-ver-mas {
    background: var(--verde-medio);
    color: #fff;
    gap: 8px;
}

/* ===========================================
   GRID DE SERVICIOS
   =========================================== */
.grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px 70px 30px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
}

.grupo-inmobiliaria .grid {
    max-width: none;
    margin: 0;
    padding: 0;
}

#serviciosGrid {
    padding-bottom: 70px;
}

#serviciosGrid .empty-state {
    margin: 20px 0 70px 0;
}

.card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #edf2ee;
    box-shadow: 0 2px 10px rgba(15, 61, 36, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
}

.card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(15, 61, 36, 0.14);
    border-color: var(--verde-claro);
}

.card-img-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #eef3ee;
}

.card img,
.card-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.card:hover .card-img-container img,
.card:hover img {
    transform: scale(1.08);
}

.card-icon-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52px;
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.card-img-container::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0));
    pointer-events: none;
}

.badge-tipo {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 13px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.94);
    color: var(--verde-oscuro);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}

.badge-tipo::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--verde-medio);
}

.card-content {
    padding: 20px 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
    flex: 1;
