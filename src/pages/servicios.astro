---
// src/pages/servicios.astro

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Servicios de Mantenimiento | SkyInit</title>
	</head>
	<body>
		<!-- ▌HEADER / HERO ▐ -->
		<header id="header">
			<div class="topbar">
				<div class="logo">SkyInit</div>
				<div class="menu-toggle" id="menuToggle">&#9776;</div>
				<nav id="menu">
					<a href="/">Inicio</a>
					<a href="/propiedades">Propiedades</a>
					<a href="/proyectos">Proyectos</a>
					<a href="/servicios">Servicios</a>
					<a href="/constructoras">Constructoras</a>
					<span id="navUser"></span>
				</nav>
			</div>
			<div class="hero-inner">
				<div class="hero-eyebrow">Cuidamos tu hogar</div>
				<h1>Mantenimiento <em>profesional</em> para tu vivienda</h1>
				<p class="hero-sub">
					Conecta con especialistas certificados para reparaciones, mantenimiento y mejoras en tu
					hogar, con la confianza que solo SkyInit te ofrece.
				</p>
			</div>
		</header>

		<!-- ▌ENCABEZADO DE SECCIÓN ▐ -->
		<section class="contenedor">
			<div class="section-header">
				<span class="section-eyebrow">Nuestra oferta</span>
				<h2 class="section-title">Servicios de Mantenimiento</h2>
				<p class="section-sub">
					Soluciones prácticas y confiables para el cuidado de tu hogar, con proveedores
					verificados por SkyInit
				</p>
			</div>
		</section>

		<!-- ▌GRID DE TARJETAS (se llena por JS con /api/servicios) ▐ -->
		<section class="grid" id="serviciosGrid">
			<div class="empty-state">
				<span>⏳</span>
				Cargando servicios...
			</div>
		</section>

		<!-- ▌MODAL SOLICITAR SERVICIO ▐ -->
		<div class="modal-overlay" id="modalSolicitud">
			<div class="modal-content">
				<button type="button" class="modal-close" id="btnCerrarModal">&times;</button>
				<div class="modal-header">
					<div class="modal-title-wrap">
						<h2>Solicitar servicio</h2>
						<p id="modalServicioNombre"></p>
					</div>
				</div>
				<div class="modal-body">
					<form id="formSolicitud">
						<input type="hidden" name="servicioId" id="modalServicioId" />

						<div class="form-row">
							<label for="modalNotas">Detalles adicionales (opcional)</label>
							<textarea
								name="notas"
								id="modalNotas"
								rows="4"
								placeholder="Ej: dirección del inmueble, disponibilidad de horario, descripción del problema..."
							></textarea>
						</div>

						<div class="modal-footer">
							<button type="button" class="btn-secondary" id="btnCancelarModal">Cancelar</button>
							<button type="submit" class="btn-confirm">✅ Enviar solicitud</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<div id="toastContainer"></div>

		<script>
			let usuarioAutenticado = false;
			let nombreUsuario = '';
			let fotoPerfil = '/img/default-avatar.svg';

			// ── Sesión ──────────────────────────────────────────
// El 401 en /auth/perfil es NORMAL (no hay sesión), no es un error
async function verificarSesion() {
    try {
        const res = await fetch('/auth/perfil', { credentials: 'include' });
        if (res.ok) {
            const data = await res.json();
            usuarioAutenticado = true;
            nombreUsuario = data.usuario?.nombre ?? '';
            fotoPerfil = data.usuario?.fotoPerfil || '/img/default-avatar.svg';
        }
        // 401 → simplemente no hay sesión, usuarioAutenticado queda false
    } catch {
        // Error de red real
    }
    renderUserMenu();
}

			function renderUserMenu() {
				const nav = document.getElementById('navUser');
				if (!nav) return;

				if (usuarioAutenticado) {
					nav.innerHTML = `
						<div class="user-profile">
							<img src="${fotoPerfil}" alt="Perfil" class="profile-pic" id="profilePic" />
							<div id="user-menu" class="user-menu">
								<div class="user-menu-name">${nombreUsuario}</div>
								<a href="/ajustes">⚙️ Ajustes</a>
								<button type="button" id="btnLogout">🚪 Cerrar sesión</button>
							</div>
						</div>`;

					document.getElementById('profilePic')?.addEventListener('click', () => {
						document.getElementById('user-menu')?.classList.toggle('active');
					});

					document.getElementById('btnLogout')?.addEventListener('click', async () => {
						await fetch('/auth/logout', { method: 'POST', credentials: 'include' });
						location.reload();
					});
				} else {
					nav.innerHTML = `<a href="/login" class="btn-registrar">Iniciar Sesión</a>`;
				}
			}

			// ── Catálogo de servicios ───────────────────────────
			function formatoPrecio(precio: string | number) {
				return new Intl.NumberFormat('es-CO').format(Number(precio));
			}

			async function cargarServicios() {
				const grid = document.getElementById('serviciosGrid');
				if (!grid) return;

				try {
					const res = await fetch('/api/servicios', { credentials: 'include' });
					if (!res.ok) throw new Error('No se pudieron cargar los servicios');
					const json = await res.json();
					const servicios = json.data ?? [];

					if (!servicios.length) {
						grid.innerHTML = `
							<div class="empty-state">
								<span>🛠️</span>
								No hay servicios de mantenimiento disponibles por el momento.
							</div>`;
						return;
					}

					grid.innerHTML = servicios
						.map(
							(s: any) => `
						<div class="card">
							<div class="card-img-container">
								${
									s.imagen
										? `<img src="${s.imagen}" alt="${s.nombre}">`
										: `<div class="card-icon-placeholder">🛠️</div>`
								}
								<span class="badge-tipo">Disponible</span>
							</div>
							<div class="card-content">
								<h3>${s.nombre}</h3>
								<p>${s.descripcion}</p>
								<p class="price-tag">$${formatoPrecio(s.precio)}</p>
								${
									usuarioAutenticado
										? `<button type="button" class="btn-solicitar" data-id="${s.servicioID}" data-nombre="${s.nombre}">Solicitar</button>`
										: `<a href="/login" class="btn-login-required">Inicia sesión para solicitar</a>`
								}
							</div>
						</div>`
						)
						.join('');

					grid.querySelectorAll('.btn-solicitar').forEach((btn) => {
						btn.addEventListener('click', () => {
							const id = (btn as HTMLElement).dataset.id ?? '';
							const nombre = (btn as HTMLElement).dataset.nombre ?? '';
							abrirModalSolicitud(id, nombre);
						});
					});
				} catch (e) {
					grid.innerHTML = `
						<div class="empty-state">
							<span>⚠️</span>
							Ocurrió un error al cargar los servicios. Intenta nuevamente.
						</div>`;
					console.error(e);
				}
			}

			// ── Modal ────────────────────────────────────────────
			function abrirModalSolicitud(servicioId: string, nombre: string) {
				(document.getElementById('modalServicioId') as HTMLInputElement).value = servicioId;
				document.getElementById('modalServicioNombre')!.textContent = nombre;
				document.getElementById('modalSolicitud')?.classList.add('active');
			}

			function cerrarModal(id: string) {
				document.getElementById(id)?.classList.remove('active');
			}

			// ── Toast ────────────────────────────────────────────
			function mostrarToast(mensaje: string, tipo: 'success' | 'error' = 'success') {
				const cont = document.getElementById('toastContainer');
				if (!cont) return;
				const toast = document.createElement('div');
				toast.className = `toast ${tipo}`;
				toast.textContent = mensaje;
				cont.appendChild(toast);
				setTimeout(() => toast.remove(), 4500);
			}

			// ── Init ─────────────────────────────────────────────
			document.addEventListener('DOMContentLoaded', () => {
				verificarSesion().then(cargarServicios);

				document.getElementById('menuToggle')?.addEventListener('click', () => {
					document.getElementById('menu')?.classList.toggle('active');
				});

				document.querySelectorAll('.modal-overlay').forEach((overlay) => {
					overlay.addEventListener('click', (e) => {
						if (e.target === overlay) overlay.classList.remove('active');
					});
				});

				document.getElementById('btnCerrarModal')?.addEventListener('click', () =>
					cerrarModal('modalSolicitud')
				);
				document.getElementById('btnCancelarModal')?.addEventListener('click', () =>
					cerrarModal('modalSolicitud')
				);

				const form = document.getElementById('formSolicitud') as HTMLFormElement;
				form?.addEventListener('submit', async (e) => {
					e.preventDefault();
					const servicioId = (document.getElementById('modalServicioId') as HTMLInputElement)
						.value;
					const notas = (document.getElementById('modalNotas') as HTMLTextAreaElement).value;

					try {
						// TODO backend: crear POST /api/servicios/solicitar (tabla serviciossolicitados
						// ya existe en el esquema, falta el Controller/Model/Router para exponerla).
						const res = await fetch('/api/servicios/solicitar', {
							method: 'POST',
							credentials: 'include',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ servicioId: Number(servicioId), notas }),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.message ?? 'No se pudo enviar la solicitud');

						cerrarModal('modalSolicitud');
						form.reset();
						mostrarToast('Solicitud enviada correctamente ✅');
					} catch (err: any) {
						mostrarToast(err.message ?? 'Error al enviar la solicitud', 'error');
					}
				});

				// Fondo rotativo del header
				const images = [
					'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789',
					'https://images.unsplash.com/photo-1581141849291-1125c7b692b5',
					'https://images.unsplash.com/photo-1599423300746-b62533397364',
				];
				let index = 0;
				const header = document.getElementById('header');
				function cambiarFondo() {
					if (!header) return;
					header.style.backgroundImage = `url(${images[index]})`;
					index = (index + 1) % images.length;
				}
				cambiarFondo();
				setInterval(cambiarFondo, 5000);
			});
		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #F9FCF3;
}

:root {
    --verde: #2E8B57;
    --verde-oscuro: #1b5e20;
    --verde-medio: #2e7d32;
    --verde-claro: #a5d6a7;
}

/* ===========================================
   HEADER / HERO
   =========================================== */
header {
    height: 60vh;
    min-height: 420px;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    background-size: cover;
    background-position: center;
    transition: background-image 1s ease-in-out;
}

header::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
}

/* NAVBAR */
.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    position: relative;
    z-index: 100;
    overflow: visible;
    background: rgba(46, 125, 50, 0.7);
    backdrop-filter: blur(6px);
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: white;
}

nav {
    display: flex;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 9999;
    overflow: visible;
}

nav a {
    color: white;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 5px;
    transition: 0.3s;
    font-size: 15px;
}

nav a:hover {
    background: var(--verde-claro);
    color: var(--verde-oscuro);
}

.btn-registrar {
    background: #f5f5dc;
    color: var(--verde-medio);
    font-weight: bold;
}

.btn-registrar:hover {
    background: #e6e6c5;
}

.menu-toggle {
    display: none;
    font-size: 26px;
    cursor: pointer;
    color: white;
}

/* PERFIL DE USUARIO */
.user-profile {
    position: relative;
    display: inline-block;
    z-index: 9999;
    overflow: visible;
}

.profile-pic {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid #fff;
    object-fit: cover;
    transition: transform 0.3s;
}

.profile-pic:hover {
    transform: scale(1.1);
}

.user-menu {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    background: #ffffff;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    min-width: 180px;
    z-index: 9999;
    padding: 8px 0;
}

.user-menu.active {
    display: flex;
    flex-direction: column;
}

.user-menu-name {
    padding: 10px 16px;
    font-weight: bold;
    color: #333333;
    border-bottom: 1px solid #eeeeee;
    margin-bottom: 4px;
    font-size: 14.5px;
}

.user-menu a,
.user-menu button {
    display: block;
    width: 100%;
    padding: 10px 16px !important;
    color: #333333 !important;
    text-align: left;
    background: none;
    border: none;
    font-size: 14.5px;
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
}

.user-menu a:hover,
.user-menu button:hover {
    background-color: #f8f9fa !important;
    color: var(--verde-medio) !important;
}

/* RESPONSIVE NAV */
@media (max-width: 900px) {
    nav {
        position: absolute;
        top: 65px;
        right: 0;
        background: var(--verde-medio);
        flex-direction: column;
        width: 240px;
        display: none;
    }

    nav.active {
        display: flex;
    }

    .menu-toggle {
        display: block;
    }
}

/* HERO TEXTO */
.hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    padding: 0 20px;
    z-index: 2;
    margin-bottom: 40px;
}

.hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    border-radius: 30px;
    padding: 7px 18px;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    margin: 0 auto 24px auto;
}

.hero-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--verde-claro);
    border-radius: 50%;
}

.hero-inner h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 20px;
    max-width: 700px;
    margin-top: 0;
}

.hero-inner h1 em {
    color: var(--verde-claro);
    font-style: normal;
}

.hero-sub {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
    max-width: 520px;
    margin: 0;
}

/* ===========================================
   CONTENEDOR Y ENCABEZADO DE SECCIÓN
   =========================================== */
.contenedor {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px;
}

.section-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 50px 0 35px 0;
    text-align: left;
}

.section-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--verde);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.section-eyebrow::before {
    content: "";
    display: inline-block;
    width: 30px;
    height: 2px;
    background-color: var(--verde);
}

.section-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.15;
}

.section-sub {
    color: #6c757d;
    font-size: 1.05rem;
    margin: 5px 0 0 0;
}

/* ===========================================
   GRID DE SERVICIOS
   =========================================== */
.grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px 70px 30px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
}

.card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
}

.card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
}

.card-img-container {
    position: relative;
    width: 100%;
    height: 210px;
    overflow: hidden;
}

.card img,
.card-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.card:hover .card-img-container img,
.card:hover img {
    transform: scale(1.08);
}

.card-icon-placeholder {
    width: 100%;
    height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.badge-tipo {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 6px 14px;
    border-radius: 20px;
    background-color: var(--verde-medio);
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
}

.card-content {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
    flex: 1;
}

.card-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
}

.card-content p {
    font-size: 0.92rem;
    color: #666;
    line-height: 1.5;
    margin: 4px 0 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.price-tag {
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: var(--verde-oscuro);
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 10px 0 14px 0;
}

.price-tag::after {
    content: "COP";
    font-family: 'Segoe UI', sans-serif;
    color: #888;
    font-size: 0.75rem;
    font-weight: 500;
}

.card-content button,
.btn-login-required {
    margin-top: auto;
    background: var(--verde-medio);
    color: white;
    border: none;
    padding: 11px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.92rem;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    transition: background 0.3s ease;
}

.card-content button:hover {
    background: var(--verde-oscuro);
}

.btn-login-required {
    background: #ececec;
    color: #555;
}

.btn-login-required:hover {
    background: var(--verde-medio);
    color: white;
}

.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: #666;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
}

.empty-state span {
    display: block;
    font-size: 48px;
    margin-bottom: 10px;
}

/* ===========================================
   TOAST DE CONFIRMACIÓN
   =========================================== */
.toast {
    position: fixed;
    bottom: 28px;
    right: 28px;
    padding: 14px 22px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    z-index: 2500;
    box-shadow: 0 4px 20px rgba(0, 0, 0, .15);
    animation: slideUp .3s ease;
}

@keyframes slideUp {
    from {
        transform: translateY(20px);
        opacity: 0;
    }

    to {
        transform: translateY(0);
        opacity: 1;
    }
}

.toast.success {
    background: var(--verde-medio);
    color: white;
}

.toast.error {
    background: #c0392b;
    color: white;
}

/* ===========================================
   MODAL "SOLICITAR SERVICIO"
   =========================================== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 61, 36, 0.6);
    backdrop-filter: blur(5px);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.modal-overlay.active {
    display: flex;
    opacity: 1;
}

.modal-content {
    background: white;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    overflow-y: auto;
    position: relative;
    transform: translateY(-20px);
    transition: transform 0.3s ease;
}

.modal-overlay.active .modal-content {
    transform: translateY(0);
