---
import Navbar from "../../components/menu/Navbar.astro";
import FooterMenu from "../../components/menu/FooterMenu.astro";
import Constructoras from "../../components/ConstructorasUsuario/constructoras.astro";
import "../../components/menu/menu.css";

const BACKEND = "http://127.0.0.1:8001";

let lista: any[] = [];
try {
    const res = await fetch(`${BACKEND}/api/constructoras`);
    if (res.ok) {
        const json = await res.json();
        lista = Array.isArray(json.data)
            ? json.data
            : Array.isArray(json)
              ? json
              : [];
    }
} catch {
    lista = [];
}

const map = new Map<
    string,
    { nombre: string; ciudad: string | null; items: any[] }
>();

for (const c of lista) {
    const key = c.inmobiliariaID != null ? String(c.inmobiliariaID) : "sin";
    const nombre = c.inmobiliariaNombre ?? "Otras constructoras";
    if (!map.has(key)) {
        map.set(key, {
            nombre,
            ciudad: c.inmobiliariaCiudad ?? null,
            items: [],
        });
    }
    map.get(key)!.items.push(c);
}

const grupos = Array.from(map.values());
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Constructoras - SkyInit</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header id="header">
            <Navbar />
            <div class="hero-inner">
                <div class="hero-eyebrow">Aliados de construcción</div>
                <h1>Constructoras <em>que construyen</em> confianza</h1>
                <p class="hero-sub">
                    Constructoras activas vinculadas a nuestras inmobiliarias,
                    listas para hacer realidad tu próximo proyecto.
                </p>
            </div>
        </header>

        <Constructoras grupos={grupos} />

        <FooterMenu />

        <script>
            const images = [
                "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=2000&q=80",
                'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=2000&q=80',
                "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=2000&q=80",
            ];
            let index = 0;
            const header = document.getElementById("header") as HTMLElement;

            function changeBackground() {
                if (!header) return;
                header.style.backgroundImage = `url(${images[index]})`;
                index = (index + 1) % images.length;
            }
            changeBackground();
            setInterval(changeBackground, 7500);
        </script>
    </body>
</html>
