---
import Layout from "../../layouts/LayoutVistas.astro";
import  Propiedades  from "../../components/admin/propiedades.astro";
import { getTokenSSR, obtenerRolDesdeToken } from "../../utils/auth";

const token = getTokenSSR(Astro.cookies);
const rol = obtenerRolDesdeToken(token);

if (!token || (rol !== "Administrador" && rol !== "SuperAdmin")) {
    return Astro.redirect("/login");
}
---

<Layout>
    <Propiedades />
</Layout>