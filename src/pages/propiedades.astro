---
import Propiedades from "../components/propiedades/propiedades.astro";
import { getTokenSSR, COOKIE_NAME } from "../utils/auth";

const BACKEND_URL = "http://127.0.0.1:8001";

const query = Astro.url.searchParams.get("query") ?? "";
const tipoOperacion = Astro.url.searchParams.get("tipoOperacion") ?? "";
const habitaciones = Astro.url.searchParams.get("habitaciones") ?? "";
const ciudad = Astro.url.searchParams.get("ciudad") ?? "";

const paramsBackend = new URLSearchParams();
if (ciudad) paramsBackend.set("ciudad", ciudad);
if (tipoOperacion) paramsBackend.set("tipoOperacionID", tipoOperacion);
if (habitaciones && habitaciones !== "3") paramsBackend.set("habitaciones", habitaciones);

const respuestaPropiedades = await fetch(
    `${BACKEND_URL}/api/propiedades${paramsBackend.toString() ? `?${paramsBackend}` : ""}`
);
let propiedades = respuestaPropiedades.ok ? await respuestaPropiedades.json() : [];

// Filtro por titulo/descripcion
if (query) {
    const texto = query.toLowerCase();
    propiedades = propiedades.filter((p: any) =>
        p.titulo?.toLowerCase().includes(texto) ||
        p.descripcion?.toLowerCase().includes(texto)
    );
}

// "3+" habitaciones
if (habitaciones === "3") {
    propiedades = propiedades.filter((p: any) => (p.habitaciones ?? 0) >= 3);
}   

// Perfil de usuario autenticado
const token = getTokenSSR(Astro.cookies);
let usuario = null;

if (token) {
    const respuestaPerfil = await fetch(`${BACKEND_URL}/auth/perfil`, {
        headers: { 
            Cookie: `${COOKIE_NAME}=${token}`,
            Authorization: `Bearer ${token}`,
        },
    });
    if (respuestaPerfil.ok) {
        const data = await respuestaPerfil.json();
        usuario = data.usuario;
    }
}
---

<Propiedades
    propiedades={propiedades}
    usuario={usuario}
    filtros={{ query, tipoOperacion, habitaciones, ciudad }}
/>