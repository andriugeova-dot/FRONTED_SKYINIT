---
import "../admin/propiedades.css";
import "./proyectosAdmin.css";
import { COOKIE_NAME, getTokenSSR } from "../../utils/auth";

const BACKEND = import.meta.env.BACKEND_URL ?? "http://localhost:8001";
const BACKEND_PUBLIC = import.meta.env.PUBLIC_BACKEND_URL ?? BACKEND;

const token = getTokenSSR(Astro.cookies);

type FilaProyecto = {
    proyectoID: number;
    nombre: string;
    descripcion: string | null;
    ubicacion: string | null;
    estadoProyectoID: number;
    estadoProyecto: string;
    porcentajeAvance: number;
    fechaInicio: string | null;
    fechaFin: string | null;
    constructoraID: number | null;
    constructoraNombre: string | null;
    imagenPrincipal: string | null;
};

type Opcion = { id: number; nombre: string; estado: string};

let filas: FilaProyecto[] = [];
let constructoras: Opcion[] = [];
let errorCarga: string | null = null;

if (token) {
    const auth = {
        Cookie: `${COOKIE_NAME}=${token}`,
        Accept: "application/json",
    };
    try {
        const [resProy, resConstr] = await Promise.all([
            fetch(`${BACKEND}/proyectos?orden=fecha`, { headers: auth }),
            fetch(`${BACKEND}/constructoras`, { headers: auth }),
        ]);

        if (resProy.ok) {
            const data = await resProy.json();
            const lista = Array.isArray(data)
                ? data
                : (data.proyectos ?? data.data ?? []);
            filas = (lista as Record<string, any>[]).map((p) => ({
                proyectoID: Number(p.proyectoID),
                nombre: String(p.nombre ?? ""),
                descripcion: p.descripcion ?? null,
                ubicacion: p.ubicacion ?? null,
                estadoProyectoID: Number(p.estadoProyectoID) || 1,
                estadoProyecto: String(p.estadoProyecto ?? ""),
                porcentajeAvance: Number(p.porcentajeAvance) || 0,
                fechaInicio: p.fechaInicio
                    ? String(p.fechaInicio).slice(0, 10)
                    : null,
                fechaFin: p.fechaFin ? String(p.fechaFin).slice(0, 10) : null,
                constructoraID: p.constructoraID ?? null,
                constructoraNombre: p.constructoraNombre ?? null,
                imagenPrincipal: p.imagenPrincipal ?? null,
            }));
        } else {
            errorCarga = `No se pudieron cargar los proyectos (${resProy.status})`;
        }

        if (resConstr.ok) {
            const c = await resConstr.json();
            constructoras = (c.data ?? []).map((x: any) => ({
                id: Number(x.constructoraID),
                nombre: String(x.nombre),
                estado: String(x.estado ?? "Activo"),
            }));
        }
    } catch {
        errorCarga = "No se pudo conectar con el backend";
    }
} else {
    errorCarga = "Sesión no válida";
}
const norm = (s: string) =>
    s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

const textoBusqueda = (p: FilaProyecto) =>
    norm(
        [p.nombre, p.ubicacion, p.constructoraNombre].filter(Boolean).join(" "),
    );

const urlImg = (path?: string | null) => {
    if (!path) return null;
    if (/^https?:\/\//i.test(path)) return path;
    return (
        BACKEND_PUBLIC.replace(/\/$/, "") +
        (path.startsWith("/") ? path : "/" + path)
    );
};

const fmtFecha = (s: string | null) => {
    if (!s) return "—";
    const [y, m, d] = s.split("-");
    return `${d}/${m}/${y}`;
};

const nombreEstado = (p: FilaProyecto) =>
    p.estadoProyecto ||
    (p.estadoProyectoID === 3
        ? "Finalizado"
        : p.estadoProyectoID === 2
          ? "En construcción"
          : "Planificado");

// 1 Planificado (azul) · 2 En construcción (ámbar) · 3 Finalizado (verde)
const claseEstado = (id: number) =>
    id === 3
        ? "est-disponible"
        : id === 2
          ? "est-reservada"
          : "est-mantenimiento";

const pct = (p: FilaProyecto) =>
    Math.max(0, Math.min(100, Math.round(p.porcentajeAvance)));

// Resumen
const total = filas.length;
const planificados = filas.filter((f) => f.estadoProyectoID === 1).length;
const enConstruccion = filas.filter((f) => f.estadoProyectoID === 2).length;
const finalizados = filas.filter((f) => f.estadoProyectoID === 3).length;

const filasJson = JSON.stringify(filas).replace(/</g, "\\u003c");
---

<div class="page" data-backend={BACKEND_PUBLIC}>
    <header class="page-header">
        <div>
            <h1>Proyectos</h1>
            <p>Gestiona los proyectos de cada constructora.</p>
        </div>
        <button type="button" class="btn-nueva" id="btn-nuevo-proyecto">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo proyecto
        </button>
    </header>

    {
        errorCarga && (
            <div class="alert-error" role="alert">
                {errorCarga}
            </div>
        )
    }

    <section class="stats" aria-label="Resumen">
        <div class="stat-card">
            <div class="stat-title">Total</div>
            <div class="stat-value">{total}</div>
        </div>
        <div class="stat-card stat-gray">
            <div class="stat-title">Planificados</div>
            <div class="stat-value">{planificados}</div>
        </div>
        <div class="stat-card stat-warn">
            <div class="stat-title">En construcción</div>
            <div class="stat-value">{enConstruccion}</div>
        </div>
        <div class="stat-card stat-ok">
            <div class="stat-title">Finalizados</div>
            <div class="stat-value">{finalizados}</div>
        </div>
    </section>

    <section class="filtros" aria-label="Filtros">
        <div class="filtro-busqueda">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input
                type="search"
                id="filtro-buscar"
                placeholder="Buscar por nombre, ubicación o constructora..."
            />
        </div>
        <select id="filtro-constructora" aria-label="Filtrar por constructora">
            <option value="">Todas las constructoras</option>
            {constructoras.map((c) => (
            <option value={c.id}>
                {c.estado !== "Activo" ? `${c.nombre} (${c.estado})`: c.nombre}
                </option>
            ))
            }
            <option value="sin">Sin constructora</option>
        </select>
        <select id="filtro-estado" aria-label="Filtrar por estado">
            <option value="">Todos los estados</option>
            <option value="1">Planificado</option>
            <option value="2">En construcción</option>
            <option value="3">Finalizado</option>
        </select>
    </section>

    <p class="contador" id="contador" aria-live="polite">
        {total}
        {total === 1 ? "proyecto" : "proyectos"}
    </p>

    {
        total === 0 && !errorCarga && (
            <div class="estado-vacio">
                <i class="bi bi-buildings" aria-hidden="true" />
                <h3>No hay proyectos registrados</h3>
                <p>Crea el primero con “Nuevo proyecto”.</p>
            </div>
        )
    }

    <div class="estado-vacio" id="sin-resultados" hidden>
        <i class="bi bi-search" aria-hidden="true"></i>
        <h3>Sin resultados</h3>
        <p>Prueba con otra búsqueda o cambia los filtros.</p>
    </div>

    <div class="prop-grid" id="grid-proyectos">
        {
            filas.map((p) => (
                <article
                    class="prop-card"
                    data-id={p.proyectoID}
                    data-estado={p.estadoProyectoID}
                    data-constructora={p.constructoraID ?? "sin"}
                    data-busqueda={textoBusqueda(p)}
                >
                    <div class="prop-img">
                        {urlImg(p.imagenPrincipal) ? (
                            <img
                                src={urlImg(p.imagenPrincipal)!}
                                alt={`Imagen de ${p.nombre}`}
                                loading="lazy"
                            />
                        ) : (
                            <div class="prop-img-vacia">
                                <i class="bi bi-buildings" aria-hidden="true" />
                                <span>Sin imagen</span>
                            </div>
                        )}
                        <span
                            class={`prop-badge ${claseEstado(p.estadoProyectoID)}`}
                        >
                            {nombreEstado(p)}
                        </span>
                    </div>

                    <div class="prop-body">
                        <h3 class="prop-title">{p.nombre}</h3>
                        <p class="prop-loc">
                            <i class="bi bi-geo-alt" aria-hidden="true" />
                            {p.ubicacion || "Sin ubicación"}
                        </p>

                        <div class="proy-progress">
                            <div class="proy-progress-top">
                                <span>Avance</span>
                                <strong>{pct(p)}%</strong>
                            </div>
                            <div
                                class="proy-bar"
                                role="progressbar"
                                aria-valuenow={pct(p)}
                                aria-valuemin="0"
                                aria-valuemax="100"
                            >
                                <span style={`width:${pct(p)}%`} />
                            </div>
                        </div>

                        <div class="prop-chips">
                            <span class="chip">
                                <i
                                    class="bi bi-calendar-event"
                                    aria-hidden="true"
                                />{" "}
                                {fmtFecha(p.fechaInicio)}
                            </span>
                            <span class="chip">
                                <i class="bi bi-flag" aria-hidden="true" />{" "}
                                {fmtFecha(p.fechaFin)}
                            </span>
                        </div>

                        <dl class="prop-meta una-col">
                            <div>
                                <dt>Constructora</dt>
                                <dd>{p.constructoraNombre ?? "Sin asignar"}</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="prop-actions">
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-primary flex-grow-1"
                            data-accion="editar"
                            data-id={p.proyectoID}
                            aria-label={`Editar ${p.nombre}`}
                        >
                            <i class="bi bi-pencil" aria-hidden="true" /> Editar
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            data-accion="fotos"
                            data-id={p.proyectoID}
                            aria-label={`Fotos de ${p.nombre}`}
                        >
                            <i class="bi bi-images" aria-hidden="true" /> Fotos
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-danger"
                            data-accion="eliminar"
                            data-id={p.proyectoID}
                            aria-label={`Eliminar ${p.nombre}`}
                        >
                            <i class="bi bi-trash" aria-hidden="true" />
                        </button>
                    </div>
                </article>
            ))
        }
    </div>
</div>

<script
    is:inline
    type="application/json"
    id="proyectos-data"
    set:html={filasJson}
/>

<!-- Modal crear / editar -->
<div id="modal-proyecto" class="sky-modal" hidden>
    <div class="sky-modal-backdrop" data-cerrar="proyecto"></div>
    <div
        class="sky-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-titulo"
    >
        <h3 id="modal-titulo">Nuevo proyecto</h3>
        <div id="form-error" class="alert-error" role="alert" hidden></div>
        <form id="form-proyecto" class="form-grid" novalidate>
            <input type="hidden" id="campo-id" value="" />

            <div class="full">
                <label for="campo-nombre">Nombre *</label>
                <input type="text" id="campo-nombre" required maxlength="150" />
            </div>

            <div class="full">
                <label for="campo-descripcion">Descripción</label>
                <textarea id="campo-descripcion" rows="3" maxlength="500"
                ></textarea>
            </div>

            <div class="full">
                <label for="campo-ubicacion">Ubicación</label>
                <input type="text" id="campo-ubicacion" maxlength="255" />
            </div>

            <div class="full">
                <label for="campo-constructora">Constructora encargada *</label>
                <select id="campo-constructora" required>
                    <option value="">Selecciona una constructora</option>
                    {
                        constructoras
                              .filter((c) => c.estado === "Activo")
                              .map((c) => <option value={c.id}>{c.nombre}</option>)
    
                    }
                </select>
            </div>

            <div>
                <label for="campo-estado">Estado *</label>
                <select id="campo-estado" required>
                    <option value="1">Planificado</option>
                    <option value="2">En construcción</option>
                    <option value="3">Finalizado</option>
                </select>
            </div>

            <div></div>

            <div>
                <label for="campo-inicio">Fecha de inicio</label>
                <input type="date" id="campo-inicio" />
            </div>

            <div>
                <label for="campo-fin">Fecha de fin</label>
                <input type="date" id="campo-fin" />
            </div>
        </form>
        <div class="modal-actions">
            <button type="button" class="btn-outline" data-cerrar="proyecto"
                >Cancelar</button
            >
            <button type="button" class="btn-primary" id="btn-guardar-proyecto"
                >Guardar</button
            >
        </div>
    </div>
</div>

<!-- Modal fotos -->
<div id="modal-fotos" class="sky-modal" hidden>
    <div class="sky-modal-backdrop" data-cerrar="fotos"></div>
    <div
        class="sky-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="titulo-fotos"
    >
        <h3 id="titulo-fotos">Fotos del proyecto</h3>
        <div id="fotos-error" class="alert-error" role="alert" hidden></div>
        <div id="fotos-ok" class="alert-ok" role="status" hidden></div>
        <div id="galeria-fotos" class="galeria"></div>
        <label for="input-foto">Agregar imagen</label>
        <input
            type="file"
            id="input-foto"
            accept="image/jpeg,image/png,image/webp"
        />
        <div class="modal-actions">
            <button type="button" class="btn-outline" data-cerrar="fotos"
                >Cerrar</button
            >
            <button type="button" class="btn-primary" id="btn-subir-foto"
                >Subir</button
            >
        </div>
    </div>
</div>

<!-- Modal confirmar eliminar (proyecto o foto) -->
<div id="modal-eliminar" class="sky-modal" hidden>
    <div class="sky-modal-backdrop" data-cerrar="eliminar"></div>
    <div
        class="sky-modal-card"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="titulo-eliminar"
        aria-describedby="texto-eliminar"
    >
        <h3 id="titulo-eliminar">Eliminar proyecto</h3>
        <p id="texto-eliminar">¿Seguro que deseas eliminar este proyecto?</p>
        <div id="eliminar-error" class="alert-error" role="alert" hidden></div>
        <div class="modal-actions">
            <button type="button" class="btn-outline" data-cerrar="eliminar"
                >Cancelar</button
            >
            <button type="button" class="btn-danger" id="btn-confirmar-eliminar"
                >Eliminar</button
            >
        </div>
    </div>
</div>

<script>
    type Proy = {
        proyectoID: number;
        nombre?: string;
        descripcion?: string | null;
        ubicacion?: string | null;
        estadoProyectoID?: number;
        constructoraNombre?: string | null;
        fechaInicio?: string | null;
        fechaFin?: string | null;
        constructoraID?: number | null;
    };

    const API = "/api/inmobiliarias/proyectos";
    const MAX_FOTO_BYTES = 5 * 1024 * 1024;
    const TIPOS_FOTO = ["image/jpeg", "image/png", "image/webp"];

    // ---------- Datos completos (para editar) ----------
    const proyectos = new Map<number, Proy>();
    try {
        const raw =
            document.getElementById("proyectos-data")?.textContent ?? "[]";
        (JSON.parse(raw) as Proy[]).forEach((p) =>
            proyectos.set(p.proyectoID, p),
        );
    } catch {
        /* sin datos precargados */
    }

    // ---------- Helpers de DOM ----------
    function get<T extends HTMLElement>(id: string): T {
        const node = document.getElementById(id);
        if (!node) throw new Error(`Falta el elemento #${id}`);
        return node as T;
    }

    const modales = {
        proyecto: get<HTMLElement>("modal-proyecto"),
        fotos: get<HTMLElement>("modal-fotos"),
        eliminar: get<HTMLElement>("modal-eliminar"),
    };
    type NombreModal = keyof typeof modales;

    const form = get<HTMLFormElement>("form-proyecto");
    const campo = {
        id: get<HTMLInputElement>("campo-id"),
        nombre: get<HTMLInputElement>("campo-nombre"),
        descripcion: get<HTMLTextAreaElement>("campo-descripcion"),
        ubicacion: get<HTMLInputElement>("campo-ubicacion"),
        constructora: get<HTMLSelectElement>("campo-constructora"),
        estado: get<HTMLSelectElement>("campo-estado"),
        inicio: get<HTMLInputElement>("campo-inicio"),
        fin: get<HTMLInputElement>("campo-fin"),
    };
    const formError = get<HTMLElement>("form-error");
    const eliminarError = get<HTMLElement>("eliminar-error");

    const fotosError = get<HTMLElement>("fotos-error");
    const fotosOk = get<HTMLElement>("fotos-ok");
    const galeria = get<HTMLElement>("galeria-fotos");
    const inputFoto = get<HTMLInputElement>("input-foto");
    const root = document.querySelector<HTMLElement>(".page");
    const BACKEND_PUBLIC = (root?.dataset.backend ?? "").replace(/\/$/, "");

    type Imagen = { imagenID: number | null; url: string };
    type Pendiente =
        | { tipo: "proyecto"; id: number }
        | { tipo: "foto"; proyectoId: number; imagenId: string };

    let pendiente: Pendiente | null = null;
    let proyectoFotosId: number | null = null;

    // ---------- Modales (apertura, cierre, foco, Escape) ----------
    const pilaModales: NombreModal[] = [];
    const focoPrevio = new Map<NombreModal, HTMLElement | null>();

    function mostrarError(node: HTMLElement, msg: string | null) {
        node.hidden = !msg;
        node.textContent = msg ?? "";
    }

    function abrir(nombre: NombreModal) {
        const modal = modales[nombre];
        focoPrevio.set(nombre, document.activeElement as HTMLElement | null);
        modal.hidden = false;
        pilaModales.push(nombre);
        modal
            .querySelector<HTMLElement>(
                "input:not([type=hidden]), textarea, select, button.btn-danger, button",
            )
            ?.focus();
    }

    function cerrar(nombre: NombreModal) {
        modales[nombre].hidden = true;
        const i = pilaModales.lastIndexOf(nombre);
        if (i >= 0) pilaModales.splice(i, 1);
        focoPrevio.get(nombre)?.focus?.();
        focoPrevio.delete(nombre);
    }

    document.querySelectorAll<HTMLElement>("[data-cerrar]").forEach((n) => {
        n.addEventListener("click", () =>
            cerrar(n.dataset.cerrar as NombreModal),
        );
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && pilaModales.length) {
            cerrar(pilaModales[pilaModales.length - 1]);
        }
    });

    // ---------- Red ----------
    async function pedir(url: string, init: RequestInit) {
        const res = await fetch(url, { credentials: "same-origin", ...init });
        const data = (await res.json().catch(() => ({}))) as Record<
            string,
            any
        >;
        return { ok: res.ok, status: res.status, data };
    }

    function mensajeError(
        data: Record<string, any>,
        status: number,
        porDefecto: string,
    ) {
        const detalle = (data.error ?? data.message) as string | undefined;
        return detalle ? String(detalle) : `${porDefecto} (${status})`;
    }

    async function conBloqueo(btn: HTMLButtonElement, fn: () => Promise<void>) {
        if (btn.disabled) return;
        const textoOriginal = btn.textContent;
        btn.disabled = true;
        btn.setAttribute("aria-busy", "true");
        try {
            await fn();
        } finally {
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
            btn.textContent = textoOriginal;
        }
    }

    // ---------- Filtros ----------
    const norm = (s: string) =>
        s
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
    const grid = get<HTMLElement>("grid-proyectos");
    const tarjetas = Array.from(
        grid.querySelectorAll<HTMLElement>(".prop-card"),
    );
    const filtroBuscar = get<HTMLInputElement>("filtro-buscar");
    const filtroConstructora = get<HTMLSelectElement>("filtro-constructora");
    const filtroEstado = get<HTMLSelectElement>("filtro-estado");
    const sinResultados = get<HTMLElement>("sin-resultados");
    const contador = get<HTMLElement>("contador");

    function filtrar() {
        const q = norm(filtroBuscar.value.trim());
        const constr = filtroConstructora.value;
        const estado = filtroEstado.value;
        let visibles = 0;

        tarjetas.forEach((t) => {
            const ok =
                (!q || (t.dataset.busqueda ?? "").includes(q)) &&
                (!constr || t.dataset.constructora === constr) &&
                (!estado || t.dataset.estado === estado);
            t.hidden = !ok;
            if (ok) visibles++;
        });

        sinResultados.hidden = visibles !== 0 || tarjetas.length === 0;
        contador.textContent =
            visibles === tarjetas.length
                ? `${visibles} ${visibles === 1 ? "proyecto" : "proyectos"}`
                : `Mostrando ${visibles} de ${tarjetas.length}`;
    }

    filtroBuscar.addEventListener("input", filtrar);
    filtroConstructora.addEventListener("change", filtrar);
    filtroEstado.addEventListener("change", filtrar);

    // ---------- Formulario ----------
    function prepararCrear() {
        form.reset();
        opcionActualTemporal();
        campo.id.value = "";
        campo.estado.value = "1";
        campo.constructora.value = "";
        mostrarError(formError, null);
        get("modal-titulo").textContent = "Nuevo proyecto";
    }

    function prepararEditar(p: Proy) {
        form.reset();
        opcionActualTemporal(p);
        campo.id.value = String(p.proyectoID);
        campo.nombre.value = p.nombre ?? "";
        campo.descripcion.value = p.descripcion ?? "";
        campo.ubicacion.value = p.ubicacion ?? "";
        campo.constructora.value =
            p.constructoraID != null ? String(p.constructoraID) : "";
        campo.estado.value = String(p.estadoProyectoID ?? 1);
        campo.inicio.value = p.fechaInicio ?? "";
        campo.fin.value = p.fechaFin ?? "";
        mostrarError(formError, null);
        get("modal-titulo").textContent = "Editar proyecto";
    }

    // ---------- Galería de fotos ----------
    function urlImg(path: unknown): string | null {
        if (!path) return null;
        const u = String(path);
        if (/^https?:\/\//i.test(u)) return u;
        return BACKEND_PUBLIC + (u.startsWith("/") ? u : "/" + u);
    }

    function normalizar(imagenes: unknown[]): Imagen[] {
        return (imagenes ?? []).map((item) => {
            if (typeof item === "string") return { imagenID: null, url: item };
            const o = item as Record<string, unknown>;
            const id = o.imagenID ?? o.imagenId;
            return {
                imagenID: id != null ? Number(id) : null,
                url: String(o.url ?? ""),
            };
        });
    }

    // Actualiza la imagen de la tarjeta en la página, sin recargar
    function actualizarTarjeta(id: number, lista: Imagen[]) {
        const cont = grid.querySelector<HTMLElement>(
            `.prop-card[data-id="${id}"] .prop-img`,
        );
        if (!cont) return;
        cont.querySelector("img, .prop-img-vacia")?.remove();

        const primera = [...lista].sort(
            (a, b) => (a.imagenID ?? 0) - (b.imagenID ?? 0),
        )[0];
        const src = urlImg(primera?.url);

        if (src) {
            const img = document.createElement("img");
            img.src = src;
            img.alt = "Imagen del proyecto";
            cont.prepend(img);
        } else {
            const vacia = document.createElement("div");
            vacia.className = "prop-img-vacia";
            const icono = document.createElement("i");
            icono.className = "bi bi-buildings";
            icono.setAttribute("aria-hidden", "true");
            const texto = document.createElement("span");
            texto.textContent = "Sin imagen";
            vacia.append(icono, texto);
            cont.prepend(vacia);
        }
    }

    // Aviso de éxito (se oculta solo)
    let okTimer: number | undefined;
    function mostrarOk(msg: string | null) {
        window.clearTimeout(okTimer);
        fotosOk.hidden = !msg;
        fotosOk.textContent = msg ?? "";
        if (msg) okTimer = window.setTimeout(() => mostrarOk(null), 3500);
    }

    function pintarGaleria(lista: Imagen[]) {
        galeria.replaceChildren();

        if (!lista.length) {
            const vacio = document.createElement("span");
            vacio.className = "vacio";
            vacio.textContent = "Sin fotos aún. Sube la primera.";
            galeria.appendChild(vacio);
            return;
        }

        lista.forEach((item) => {
            const src = urlImg(item.url);
            if (!src) return;
            const wrap = document.createElement("div");
            wrap.className = "galeria-item";

            const img = document.createElement("img");
            img.src = src;
            img.alt = "Foto del proyecto";
            img.loading = "lazy";
            wrap.appendChild(img);

            if (item.imagenID != null) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "btn-del-img";
                btn.textContent = "×";
                btn.setAttribute("aria-label", "Eliminar foto");
                btn.dataset.skyDelImg = String(item.imagenID);
                wrap.appendChild(btn);
            }
            galeria.appendChild(wrap);
        });
    }

    // Requiere la ruta Astro: src/pages/api/inmobiliarias/proyectos/[id]/detalle.ts
    async function cargarGaleria(id: number) {
        mostrarError(fotosError, null);
        try {
            const { ok, status, data } = await pedir(`${API}/${id}/detalle`, {
                method: "GET",
            });
            if (!ok) {
                pintarGaleria([]);
                mostrarError(
                    fotosError,
                    mensajeError(
                        data,
                        status,
                        "No se pudieron cargar las fotos",
                    ),
                );
                return;
            }
            const proy = (data.proyecto ?? data.data ?? data) as {
                imagenes?: unknown[];
            };
            const lista = normalizar(proy.imagenes ?? []);
            pintarGaleria(lista);
            actualizarTarjeta(id, lista);
        } catch {
            pintarGaleria([]);
            mostrarError(fotosError, "Error de red al cargar las fotos");
        }
    }

    function abrirFotos(p: Proy) {
        proyectoFotosId = p.proyectoID;
        mostrarOk(null);
        get("titulo-fotos").textContent =
            `Fotos — "${p.nombre || "#" + p.proyectoID}"`;
        inputFoto.value = "";
        pintarGaleria([]);
        abrir("fotos");
        cargarGaleria(p.proyectoID);
    }

    // ---------- Acciones de las tarjetas (Editar / Fotos / Eliminar) ----------
    grid.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
            "[data-accion]",
        );
        if (!btn) return;
        const p = proyectos.get(Number(btn.dataset.id));
        if (!p) return;

        if (btn.dataset.accion === "editar") {
            prepararEditar(p);
            abrir("proyecto");
        } else if (btn.dataset.accion === "fotos") {
            abrirFotos(p);
        } else if (btn.dataset.accion === "eliminar") {
            pendiente = { tipo: "proyecto", id: p.proyectoID };
            get("titulo-eliminar").textContent = "Eliminar proyecto";
            get("texto-eliminar").textContent =
                `¿Eliminar el proyecto "${p.nombre || "#" + p.proyectoID}"? También se borrarán sus avances y su imagen. Esta acción no se puede deshacer.`;
            mostrarError(eliminarError, null);
            abrir("eliminar");
        }
    });

    get("btn-nuevo-proyecto").addEventListener("click", () => {
        prepararCrear();
        abrir("proyecto");
    });

    // ---------- Guardar (crear / editar) ----------
    const btnGuardar = get<HTMLButtonElement>("btn-guardar-proyecto");
    btnGuardar.addEventListener("click", () =>
        conBloqueo(btnGuardar, async () => {
            mostrarError(formError, null);

            if (!form.reportValidity()) return;

            const nombre = campo.nombre.value.trim();
            if (!nombre) {
                mostrarError(formError, "El nombre no puede estar vacío.");
                return;
            }
            if (
                campo.inicio.value &&
                campo.fin.value &&
                campo.fin.value < campo.inicio.value
            ) {
                mostrarError(
                    formError,
                    "La fecha de fin no puede ser anterior a la de inicio.",
                );
                return;
            }

            const id = campo.id.value.trim();
            const creando = !id;

            const payload = {
                nombre,
                descripcion: campo.descripcion.value.trim() || null,
                ubicacion: campo.ubicacion.value.trim() || null,
                estadoProyectoID: Number(campo.estado.value),
                fechaInicio: campo.inicio.value || null,
                fechaFin: campo.fin.value || null,
                constructoraID: campo.constructora.value ? Number(campo.constructora.value) : null,
            };

            btnGuardar.textContent = "Guardando…";
            try {
                const r = await pedir(creando ? API : `${API}/${id}`, {
                    method: creando ? "POST" : "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                });
                if (!r.ok) {
                    mostrarError(
                        formError,
                        mensajeError(r.data, r.status, "No se pudo guardar"),
                    );
                    return;
                }

                window.location.reload();
            } catch {
                mostrarError(formError, "Error de red al guardar");
            }
        }),
    );

    // ---------- Confirmar eliminar (proyecto o foto) ----------
    const btnEliminar = get<HTMLButtonElement>("btn-confirmar-eliminar");
    btnEliminar.addEventListener("click", () =>
        conBloqueo(btnEliminar, async () => {
            if (!pendiente) return;
            mostrarError(eliminarError, null);
            btnEliminar.textContent = "Eliminando…";

            const url =
                pendiente.tipo === "proyecto"
                    ? `${API}/${pendiente.id}`
                    : `${API}/${pendiente.proyectoId}/imagenes/${pendiente.imagenId}`;

            try {
                const r = await pedir(url, { method: "DELETE" });
                if (!r.ok) {
                    mostrarError(
                        eliminarError,
                        mensajeError(r.data, r.status, "No se pudo eliminar"),
                    );
                    return;
                }
                if (pendiente.tipo === "proyecto") {
                    window.location.reload();
                } else {
                    const pid = pendiente.proyectoId;
                    pendiente = null;
                    cerrar("eliminar");
                    await cargarGaleria(pid);
                    mostrarOk("Foto eliminada correctamente.");
                }
            } catch {
                mostrarError(eliminarError, "Error de red al eliminar");
            }
        }),
    );

    // ---------- Eliminar foto (abre la confirmación) ----------
    galeria.addEventListener("click", (ev) => {
        const del = (ev.target as HTMLElement | null)?.closest<HTMLElement>(
            "[data-sky-del-img]",
        );
        if (!del || proyectoFotosId == null) return;
        const imagenId = del.dataset.skyDelImg;
        if (!imagenId) return;

        pendiente = { tipo: "foto", proyectoId: proyectoFotosId, imagenId };
        get("titulo-eliminar").textContent = "Eliminar foto";
        get("texto-eliminar").textContent =
            "¿Eliminar esta foto? Esta acción no se puede deshacer.";
        mostrarError(eliminarError, null);
        abrir("eliminar");
    });

    // ---------- Subir foto ----------
    const btnSubir = get<HTMLButtonElement>("btn-subir-foto");
    btnSubir.addEventListener("click", () =>
        conBloqueo(btnSubir, async () => {
            if (proyectoFotosId == null) return;
            mostrarError(fotosError, null);
            mostrarOk(null);

            const file = inputFoto.files?.[0];
            if (!file) {
                mostrarError(fotosError, "Elige una imagen.");
                return;
            }
            if (!TIPOS_FOTO.includes(file.type)) {
                mostrarError(
                    fotosError,
                    "Formato no soportado (usa jpg, png o webp).",
                );
                return;
            }
            if (file.size > MAX_FOTO_BYTES) {
                mostrarError(
                    fotosError,
                    "La imagen no puede superar los 5 MB.",
                );
                return;
            }

            btnSubir.textContent = "Subiendo…";
            const fd = new FormData();
            fd.append("imagen", file);
            try {
                const r = await pedir(`${API}/${proyectoFotosId}/imagenes`, {
                    method: "POST",
                    body: fd,
                });
                if (!r.ok) {
                    mostrarError(
                        fotosError,
                        mensajeError(
                            r.data,
                            r.status,
                            "No se pudo subir la foto",
                        ),
                    );
                    return;
                }
                inputFoto.value = "";
                await cargarGaleria(proyectoFotosId);
                mostrarOk("Foto subida correctamente.");
            } catch {
                mostrarError(fotosError, "Error de red al subir");
            }
        }),
    );
    function opcionActualTemporal(p?: Proy) {
    campo.constructora.querySelector("option[data-temporal]")?.remove();
    if (!p || p.constructoraID == null) return;

    const yaExiste = Array.from(campo.constructora.options).some(
        (o) => o.value === String(p.constructoraID),
    );
    if (yaExiste) return;

    const op = document.createElement("option");
    op.value = String(p.constructoraID);
    op.textContent = `${p.constructoraNombre ?? "Constructora #" + p.constructoraID} (no activa)`;
    op.dataset.temporal = "1";
    campo.constructora.appendChild(op);
}
</script>
