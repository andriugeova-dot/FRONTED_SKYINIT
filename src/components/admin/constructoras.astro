---
import "./constructoras.css";
import "./propiedades.css"
---

<div class="page" id="page-constructoras">
  <header class="page-header">
    <div>
      <h1>Constructoras</h1>
      <p>Constructoras vinculadas a tu inmobiliaria</p>
    </div>
    <button type="button" class="btn-nueva" id="btn-nueva">+ Nueva constructora</button>
  </header>

  <div class="stats">
    <div class="stat-card">
      <span class="stat-label">Total</span>
      <span class="stat-value" id="stat-total">—</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Activas</span>
      <span class="stat-value" id="stat-activas">—</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Pendientes</span>
      <span class="stat-value" id="stat-pendientes">—</span>
    </div>
  </div>

  <div class="toolbar">
    <input type="search" id="filtro-q" placeholder="Buscar nombre o ciudad…" />
    <select id="filtro-estado">
      <option value="">Todos los estados</option>
      <option value="Activo">Activo</option>
      <option value="Pendiente">Pendiente</option>
      <option value="Inactivo">Inactivo</option>
    </select>
  </div>



  <div id="grid-cards" class="prop-grid">
  <p class="empty">Cargando…</p>
</div>
</div>

<!-- Modal -->
<div id="modal" class="modal" hidden>
  <div class="modal-backdrop" data-cerrar></div>
  <div class="modal-card">
    <h3 id="modal-titulo">Nueva constructora</h3>
    <p id="form-error" class="form-error" hidden></p>
    <input type="hidden" id="f-id" value="" />

    <label>Nombre *</label>
    <input type="text" id="f-nombre" />

    <label>Descripción *</label>
    <textarea id="f-descripcion" rows="3"></textarea>

    <div class="fila">
      <div>
        <label>Ciudad</label>
        <input type="text" id="f-ciudad" />
      </div>
      <div>
        <label>Estado</label>
        <select id="f-estado">
          <option value="Activo">Activo</option>
          <option value="Pendiente">Pendiente</option>
          <option value="Inactivo">Inactivo</option>
        </select>
      </div>
    </div>

    <div class="fila">
      <div>
        <label>Teléfono</label>
        <input type="text" id="f-telefono" />
      </div>
      <div>
        <label>Correo</label>
        <input type="email" id="f-correo" />
      </div>
    </div>

    <label>Contacto</label>
    <input type="text" id="f-contacto" />

    <div class="modal-actions">
      <button type="button" class="btn-outline" data-cerrar>Cancelar</button>
      <button type="button" class="btn-primary" id="btn-guardar">Guardar</button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var lista = [];

  function urlLogo(logo) {
    if (!logo) return "";
    if (String(logo).indexOf("http") === 0) return logo;
    return (
      "http://localhost:8001" +
      (logo.charAt(0) === "/" ? logo : "/" + logo)
    );
  }

  function claseEstado(e) {
    var s = String(e || "").toLowerCase();
    if (s.indexOf("activ") >= 0) return "est-disponible";
    if (s.indexOf("pend") >= 0) return "est-reservada";
    return "est-fuera";
  }

  function pintarStats() {
    var total = lista.length;
    var activas = lista.filter(function (c) {
      return String(c.estado || "").toLowerCase().indexOf("activ") >= 0;
    }).length;
    var pendientes = lista.filter(function (c) {
      return String(c.estado || "").toLowerCase().indexOf("pend") >= 0;
    }).length;
    document.getElementById("stat-total").textContent = String(total);
    document.getElementById("stat-activas").textContent = String(activas);
    document.getElementById("stat-pendientes").textContent = String(pendientes);
  }

  function pintarCards(items) {
    var grid = document.getElementById("grid-cards");
    if (!items.length) {
      grid.innerHTML =
        '<p class="empty">No hay constructoras para mostrar</p>';
      return;
    }

    grid.innerHTML = items
      .map(function (c) {
        var id = c.constructoraID;
        var desc = String(c.descripcion || "");
        if (desc.length > 100) desc = desc.slice(0, 100) + "…";
        var src = urlLogo(c.logo);
        var img = src
          ? '<img src="' +
            src +
            '" alt="' +
            (c.nombre || "") +
            '" loading="lazy" />'
          : '<div class="prop-img-vacia"><i class="bi bi-buildings" aria-hidden="true"></i><span>Sin logo</span></div>';

        return (
          '<article class="prop-card" data-id="' +
          id +
          '">' +
          '<div class="prop-img">' +
          img +
          '<span class="prop-badge ' +
          claseEstado(c.estado) +
          '">' +
          (c.estado || "—") +
          "</span>" +
          "</div>" +
          '<div class="prop-body">' +
          '<h3 class="prop-title">' +
          (c.nombre || "") +
          "</h3>" +
          '<p class="prop-loc"><i class="bi bi-geo-alt" aria-hidden="true"></i> ' +
          (c.ciudad || "Sin ciudad") +
          "</p>" +
          '<p class="prop-loc"><i class="bi bi-envelope" aria-hidden="true"></i> ' +
          (c.correo || "Sin correo") +
          "</p>" +
          (desc
            ? '<p class="card-c-desc">' + desc + "</p>"
            : "") +
          '<dl class="prop-meta una-col">' +
          "<div><dt>Contacto</dt><dd>" +
          (c.contacto || "—") +
          "</dd></div>" +
          "</dl>" +
          "</div>" +
          '<div class="prop-actions">' +
          '<button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" data-edit="' +
          id +
          '">' +
          '<i class="bi bi-pencil" aria-hidden="true"></i> Editar' +
          "</button>" +
          "</div>" +
          "</article>"
        );
      })
      .join("");
  }

  function aplicarFiltro() {
    var q = (document.getElementById("filtro-q").value || "")
      .toLowerCase()
      .trim();
    var est = document.getElementById("filtro-estado").value;
    var filtradas = lista.filter(function (c) {
      var okQ =
        !q ||
        String(c.nombre || "").toLowerCase().indexOf(q) >= 0 ||
        String(c.ciudad || "").toLowerCase().indexOf(q) >= 0 ||
        String(c.correo || "").toLowerCase().indexOf(q) >= 0;
      var okE = !est || String(c.estado || "") === est;
      return okQ && okE;
    });
    pintarCards(filtradas);
  }

  function cargar() {
    return fetch("/api/admin/constructoras", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (json) {
        lista = json.data || [];
        pintarStats();
        if (!document.getElementById("filtro-estado").dataset.init) {
          document.getElementById("filtro-estado").value = "Activo";
          document.getElementById("filtro-estado").dataset.init = "1";
        }
        aplicarFiltro();
      })
      .catch(function () {
        document.getElementById("grid-cards").innerHTML =
          '<p class="empty">Error al cargar</p>';
      });
  }

  function abrirModal() {
    var modal = document.getElementById("modal");
    document.getElementById("form-error").hidden = true;
    document.body.appendChild(modal);
    modal.hidden = false;
  }

  function cerrarModal() {
    document.getElementById("modal").hidden = true;
  }

  function limpiar() {
    document.getElementById("f-id").value = "";
    document.getElementById("f-nombre").value = "";
    document.getElementById("f-descripcion").value = "";
    document.getElementById("f-ciudad").value = "";
    document.getElementById("f-estado").value = "Activo";
    document.getElementById("f-telefono").value = "";
    document.getElementById("f-correo").value = "";
    document.getElementById("f-contacto").value = "";
    document.getElementById("modal-titulo").textContent = "Nueva constructora";
  }

  function rellenar(c) {
    document.getElementById("f-id").value = c.constructoraID;
    document.getElementById("f-nombre").value = c.nombre || "";
    document.getElementById("f-descripcion").value = c.descripcion || "";
    document.getElementById("f-ciudad").value = c.ciudad || "";
    document.getElementById("f-estado").value = c.estado || "Activo";
    document.getElementById("f-telefono").value = c.telefono || "";
    document.getElementById("f-correo").value = c.correo || "";
    document.getElementById("f-contacto").value = c.contacto || "";
    document.getElementById("modal-titulo").textContent = "Editar constructora";
  }

  document.getElementById("btn-nueva").addEventListener("click", function () {
    limpiar();
    abrirModal();
  });

  document.querySelectorAll("[data-cerrar]").forEach(function (el) {
    el.addEventListener("click", cerrarModal);
  });

  document.getElementById("filtro-q").addEventListener("input", aplicarFiltro);
  document
    .getElementById("filtro-estado")
    .addEventListener("change", aplicarFiltro);

  document.getElementById("grid-cards").addEventListener("click", function (e) {
    var btn = e.target.closest("[data-edit]");
    if (!btn) return;
    var id = Number(btn.getAttribute("data-edit"));
    var c = lista.find(function (x) {
      return Number(x.constructoraID) === id;
    });
    if (!c) return;
    rellenar(c);
    abrirModal();
  });

  document.getElementById("btn-guardar").addEventListener("click", function () {
    var err = document.getElementById("form-error");
    err.hidden = true;

    var id = document.getElementById("f-id").value;
    var payload = {
      nombre: document.getElementById("f-nombre").value.trim(),
      descripcion: document.getElementById("f-descripcion").value.trim(),
      ciudad: document.getElementById("f-ciudad").value.trim() || null,
      estado: document.getElementById("f-estado").value,
      telefono: document.getElementById("f-telefono").value.trim() || null,
      correo: document.getElementById("f-correo").value.trim() || null,
      contacto: document.getElementById("f-contacto").value.trim() || null,
    };

    if (!payload.nombre || !payload.descripcion) {
      err.textContent = "Nombre y descripción son obligatorios";
      err.hidden = false;
      return;
    }

    var url = id
      ? "/api/admin/constructoras?id=" + id
      : "/api/admin/constructoras";
    var method = id ? "PUT" : "POST";

    fetch(url, {
      method: method,
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    })
      .then(function (r) {
        return r.json().then(function (data) {
          if (!r.ok) {
            throw new Error(
              data.message || data.mensaje || data.error || "Error",
            );
          }
          cerrarModal();
          return cargar();
        });
      })
      .catch(function (e) {
        err.textContent = e.message || "Error al guardar";
        err.hidden = false;
      });
  });

  cargar();
})();
</script>