---
import "./login.css";
---

<div class="login-page">
  <div class="login-container">
    <h2>SkyInit</h2>

    <div id="mensajeError" class="colorerror d-none" role="alert"></div>

    <form id="formLogin">
      <div class="input-group">
        <label for="correo">Correo</label>
        <input
          type="email"
          id="correo"
          name="Correo"
          placeholder="ejemplo@email.com"
          autocomplete="email"
          required
        />
      </div>

      <div class="input-group">
        <label for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          name="Password"
          placeholder="****"
          autocomplete="current-password"
          required
        />
      </div>

      <button type="submit" class="btn btn-login" id="btnLogin">
        Iniciar Sesión
      </button>

      <div class="divider">── o continuar con ──</div>

      <!-- UI preparada; OAuth Google no está en el MVP actual -->
      <a
        href="#"
        class="btn google-btn"
        id="btnGoogle"
        title="Próximamente"
        aria-disabled="true"
      >
        <img
          src="https://developers.google.com/identity/images/g-logo.png"
          alt=""
          width="18"
          height="18"
        />
        <span>Continuar con Google</span>
      </a>

      <p class="forgot">
        <a href="#" id="linkForgot" title="Próximamente">¿Olvidaste tu contraseña?</a>
      </p>
    </form>

    <div class="extra">
      ¿No tienes cuenta?
      <a href="/registro">Regístrate</a>
    </div>
  </div>
</div>

<script>
  import { loginRequest, rutaPorRol } from "../../utils/api";

  const images = [
    "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80",
    "https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=1920&q=80",
    "https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=1920&q=80",
  ];

  let index = 0;
  function changeBackground() {
    document.body.style.backgroundImage = `url(${images[index]})`;
    index = (index + 1) % images.length;
  }
  changeBackground();
  setInterval(changeBackground, 5000);

  const formulario = document.getElementById("formLogin") as HTMLFormElement;
  const mensajeError = document.getElementById("mensajeError") as HTMLDivElement;
  const btnLogin = document.getElementById("btnLogin") as HTMLButtonElement;

  // Placeholders fuera de MVP: no navegan
  document.getElementById("btnGoogle")?.addEventListener("click", (e) => {
    e.preventDefault();
  });
  document.getElementById("linkForgot")?.addEventListener("click", (e) => {
    e.preventDefault();
  });

  formulario.addEventListener("submit", async (e) => {
    e.preventDefault();
    mensajeError.classList.add("d-none");
    btnLogin.disabled = true;

    const Correo = (document.getElementById("correo") as HTMLInputElement).value.trim();
    const Password = (document.getElementById("password") as HTMLInputElement).value;

    try {
      const data = await loginRequest({ Correo, Password });

      if (data.error) {
        mensajeError.textContent = data.error;
        mensajeError.classList.remove("d-none");
        return;
      }

      const params = new URLSearchParams(window.location.search);
      const redirect = params.get('redirect');
      const solicitar = params.get('solicitar');

      if (redirect === '/servicios' && solicitar) {
        const nombre = params.get('nombre') ?? '';
        const q = new URLSearchParams({ solicitar });
        if (nombre) q.set('nombre', nombre);
        window.location.href = `/servicios?${q.toString()}`;
      } else {
        window.location.href = rutaPorRol(data.usuario?.rol);
      }
    } catch {
      mensajeError.textContent = "Error al conectar con el servidor";
      mensajeError.classList.remove("d-none");
    } finally {
      btnLogin.disabled = false;
    }
  });
</script>