---
import "./login.css";
---

<div class="auth-page">
  <!-- Fondos -->
  <div class="bg-layer" aria-hidden="true">
  <img
    src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80"
    class="bg-img active"
    alt=""
  />
  <img
    src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2000&q=80"
    class="bg-img"
    alt=""
  />
  <img
    src="https://images.unsplash.com/photo-1600585152220-90363fe7e115?auto=format&fit=crop&w=2000&q=80"
    class="bg-img"
    alt=""
  />
  <div class="bg-overlay"></div>
</div>

  <header class="auth-header">
    <div class="brand">
      <h1>SkyInit</h1>
      <p>Encuentra tu hogar ideal</p>
    </div>
  </header>

  <main class="auth-main">
    <div class="glass-card card-enter-login">
      <div class="card-title">
        <h2>Bienvenido</h2>
        <p>Ingresa a tu cuenta para explorar propiedades</p>
      </div>

      <form id="formLogin" class="auth-form">
        <div class="field">
          <label for="login-correo">Correo electrónico</label>
          <input
            id="login-correo"
            type="email"
            class="custom-input"
            placeholder="ejemplo@email.com"
            autocomplete="email"
            required
          />
        </div>

        <div class="field">
          <label for="login-password">Contraseña</label>
          <input
            id="login-password"
            type="password"
            class="custom-input"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </div>

        <div id="login-error" class="msg-error d-none" role="alert"></div>

        <button type="submit" id="btnLogin" class="btn-brand">Iniciar sesión</button>
      </form>

      <div class="divider"><span>o continuar con</span></div>

      <button type="button" id="btnGoogle" class="btn-google" title="Próximamente">
        Continuar con Google
      </button>

      <p class="auth-footer-links">
        <a href="/recuperar-password" id="linkForgot">¿Olvidaste tu contraseña?</a>
      </p>
      <p class="auth-footer-links">
        ¿No tienes cuenta?
        <a href="/registro">Regístrate</a>
      </p>
    </div>
  </main>

  <footer class="auth-footer">&copy; 2026 SkyInit. Todos los derechos reservados.</footer>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<script>
  import { loginRequest, rutaPorRol } from "../../utils/api";

  // Fondos
  const imgs = document.querySelectorAll(".bg-img");
  let i = 0;
  setInterval(() => {
    imgs[i].classList.remove("active");
    i = (i + 1) % imgs.length;
    imgs[i].classList.add("active");
  }, 7500);

  // Login → API
  const form = document.getElementById("formLogin") as HTMLFormElement;
  const errorEl = document.getElementById("login-error") as HTMLDivElement;
  const btn = document.getElementById("btnLogin") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("d-none");
    btn.disabled = true;

    const Correo = (document.getElementById("login-correo") as HTMLInputElement).value.trim();
    const Password = (document.getElementById("login-password") as HTMLInputElement).value;

    try {
      const data = await loginRequest({ Correo, Password });
      if (data.error) {
        errorEl.textContent = data.error;
        errorEl.classList.remove("d-none");
        return;
      }
      window.location.href = rutaPorRol(data.usuario?.rol);
    } catch {
      errorEl.textContent = "Error al conectar con el servidor";
      errorEl.classList.remove("d-none");
    } finally {
      btn.disabled = false;
    }
  });
</script>