---
interface Props {
  servicio: {
    ServicioID: number;
    Nombre: string;
    Descripcion: string;
    Precio: string | number;
    Estado: 'Activo' | 'Inactivo';
    Imagen?: string | null;
  };
}

const { servicio } = Astro.props;

const precioFormateado = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
  maximumFractionDigits: 0,
}).format(Number(servicio.Precio));
---

<div class="service-card" data-id={servicio.ServicioID}>
  <div class="service-img-wrapper">
    <img src={imagenUrl} alt={`Fotografía del servicio ${servicio.Nombre}`} loading="lazy" />
    <span class={`badge-status ${servicio.Estado === 'Activo' ? 'badge-activo' : 'badge-inactivo'}`}>
      {servicio.Estado}
    </span>
  </div>

  <div class="service-card-body">
    <h3 class="service-title">{servicio.Nombre}</h3>
    <p class="service-desc">{servicio.Descripcion}</p>
    <div class="service-price">{precioFormateado}</div>
  </div>

  <div class="service-actions">
    <button 
      class="btn btn-sm btn-outline-primary flex-grow-1 btn-editar" 
      data-id={servicio.ServicioID}
      aria-label={`Editar servicio ${servicio.Nombre}`}
    >
      <i class="bi bi-pencil me-1"></i> Editar
    </button>

    <button 
      class="btn btn-sm btn-outline-secondary btn-estado" 
      data-id={servicio.ServicioID} 
      data-estado={servicio.Estado}
      aria-label={`${servicio.Estado === 'Activo' ? 'Desactivar' : 'Activar'} servicio ${servicio.Nombre}`}
    >
      {servicio.Estado === 'Activo' ? 'Desactivar' : 'Activar'}
    </button>

    <button 
      class="btn btn-sm btn-outline-danger btn-eliminar" 
      data-id={servicio.ServicioID}
      data-nombre={servicio.Nombre}
      aria-label={`Eliminar servicio ${servicio.Nombre}`}
    >
      <i class="bi bi-trash"></i>
    </button>
  </div>
</div>