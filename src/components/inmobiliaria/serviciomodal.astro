---
---

<div class="modal fade" id="modalServicio" tabindex="-1" aria-labelledby="modalServicioLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header text-white" style="background-color: var(--teal-primary);">
        <h5 class="modal-title" id="modalServicioLabel">Nuevo Servicio de Mantenimiento</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <form id="formServicio" novalidate>
        <div class="modal-body p-4">
          <input type="hidden" id="servicioId" name="ServicioID" value="" />

          <div class="row g-3">
            <!-- Nombre -->
            <div class="col-md-12">
              <label for="nombre" class="form-label font-weight-bold">Nombre del servicio <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="nombre" name="Nombre" required minlength="3" maxlength="150" placeholder="Ej. Plomería residencial e inspección" />
              <span class="field-error" id="error-nombre"></span>
            </div>

            <!-- Precio -->
            <div class="col-md-6">
              <label for="precio" class="form-label">Precio Estimado (COP) <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" class="form-control" id="precio" name="Precio" required min="1" step="1000" placeholder="80000" />
              </div>
              <span class="field-error" id="error-precio"></span>
            </div>

            <!-- Estado -->
            <div class="col-md-6">
              <label for="estado" class="form-label">Estado inicial</label>
              <select class="form-select" id="estado" name="Estado">
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
              </select>
              <span class="field-error" id="error-estado"></span>
            </div>

            <!-- Descripción -->
            <div class="col-md-12">
              <label for="descripcion" class="form-label">Descripción del servicio <span class="text-danger">*</span></label>
              <textarea class="form-control" id="descripcion" name="Descripcion" rows="4" required minlength="20" placeholder="Mínimo 20 caracteres detallando el servicio, herramientas y alcance..."></textarea>
              <span class="field-error" id="error-descripcion"></span>
            </div>

            <!-- Subida de Imagen -->
            <div class="col-md-12">
              <label for="imagenInput" class="form-label">Imagen representativa (JPG, PNG, WEBP - Máx 2 MB)</label>
              <input type="file" class="form-control" id="imagenInput" accept="image/jpeg,image/png,image/webp" />
              <span class="field-error" id="error-imagen"></span>

              <div class="mt-3">
                <p class="form-label text-muted small mb-1">Previsualización:</p>
                <div class="img-preview-box">
                  <img id="imgPreview" src="/img/servicios-placeholder.webp" alt="Vista previa de la imagen del servicio" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-sky-primary" id="btnGuardarServicio">
            <span class="spinner-border spinner-border-sm d-none" id="spinnerGuardar" role="status" aria-hidden="true"></span>
            Guardar Servicio
          </button>
        </div>
      </form>
    </div>
  </div>
</div>