---
import { isAuthenticatedSSR, getTokenSSR, COOKIE_NAME } from "../../utils/auth";
import "./menu.css";

interface Props {
  /** Si es true, renderiza su propio <header> sólido sin hero.
   *  Si es false (por defecto), se inserta dentro del <header id="header"> de la página. */
  soloNav?: boolean;
}

const { soloNav = false } = Astro.props;

const autenticado = isAuthenticatedSSR(Astro.cookies);
const token = getTokenSSR(Astro.cookies);

let nombre = "Usuario";
let foto: string | null = null;

if (token) {
  try {
    const res = await fetch("http://localhost:8001/auth/perfil", {
      headers: { Cookie: `${COOKIE_NAME}=${token}` },
    });
    if (res.ok) {
      const json = await res.json();
      const u = json.usuario ?? json;
      nombre = u.nombre ?? "Usuario";
      if (u.fotoPerfil) {
        foto = u.fotoPerfil.startsWith("http")
          ? u.fotoPerfil
          : `http://localhost:8001${u.fotoPerfil.startsWith("/") ? u.fotoPerfil : "/" + u.fotoPerfil}`;
      }
    }
  } catch { /* defaults */ }
}

const iniciales = nombre
  .split(/\s+/)
  .map((p: string) => p[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

{
  soloNav ? (
    <header id="header" class="header--solo-nav">

<div class="topbar">
  <span class="logo">SkyInit</span>

  <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú">&#9776;</button>

  <nav id="menu">
    <a href="/">Inicio</a>
    <a href="/propiedades">Propiedades</a>
    <a href="/proyectos">Proyectos</a>
    <a href="/servicios">Servicios</a>
    <a href="/constructoras">Constructoras</a>

    {autenticado ? (
      <div class="user-profile" id="navUserProfile">
        {foto ? (
          <img src={foto} alt="Perfil" class="profile-pic" id="btnUserMenu" referrerpolicy="no-referrer" />
        ) : (
          <button type="button" class="profile-pic profile-iniciales" id="btnUserMenu">
            {iniciales}
          </button>
        )}
        <div id="user-menu" class="user-menu">
          <div class="user-menu-name">{nombre}</div>
          <a href="/usuario">⚙️ Ajustes</a>
          <button type="button" id="btnLogout">🚪 Cerrar sesión</button>
        </div>
      </div>
    ) : (
      <a href="/login" class="btn-registrar">Iniciar Sesión</a>
    )}
  </nav>
</div>
    </header>
  ) : (

<div class="topbar">
  <span class="logo">SkyInit</span>

  <button type="button" class="menu-toggle" id="menuToggle" aria-label="Abrir menú">&#9776;</button>

  <nav id="menu">
    <a href="/">Inicio</a>
    <a href="/propiedades">Propiedades</a>
    <a href="/proyectos">Proyectos</a>
    <a href="/servicios">Servicios</a>
    <a href="/constructoras">Constructoras</a>

    {autenticado ? (
      <div class="user-profile" id="navUserProfile">
        {foto ? (
          <img src={foto} alt="Perfil" class="profile-pic" id="btnUserMenu" referrerpolicy="no-referrer" />
        ) : (
          <button type="button" class="profile-pic profile-iniciales" id="btnUserMenu">
            {iniciales}
          </button>
        )}
        <div id="user-menu" class="user-menu">
          <div class="user-menu-name">{nombre}</div>
          <a href="/usuario">⚙️ Ajustes</a>
          <button type="button" id="btnLogout">🚪 Cerrar sesión</button>
        </div>
      </div>
    ) : (
      <a href="/login" class="btn-registrar">Iniciar Sesión</a>
    )}
  </nav>
</div>
  )
}

<script>
  import { logoutRequest } from "../../utils/api";

  // Toggle menú móvil
  document.getElementById("menuToggle")?.addEventListener("click", () => {
    document.getElementById("menu")?.classList.toggle("active");
  });

  // Toggle menú usuario
  document.getElementById("btnUserMenu")?.addEventListener("click", (e) => {
    e.stopPropagation();
    document.getElementById("user-menu")?.classList.toggle("active");
  });

  document.addEventListener("click", () => {
    document.getElementById("user-menu")?.classList.remove("active");
  });

  // Logout
  document.getElementById("btnLogout")?.addEventListener("click", async () => {
    try { await logoutRequest(); } finally { window.location.href = "/"; }
  });

  // Fallback client-side: si la imagen SSR falla (ej. foto Google bloqueada por error),
  // cargar perfil desde el API del lado cliente y reemplazar por iniciales
  const profileImg = document.querySelector<HTMLImageElement>(".profile-pic[src]");
  if (profileImg) {
    profileImg.addEventListener("error", async () => {
      // Intentar cargar foto nuevamente via API cliente
      try {
        const res = await fetch("/api/perfil", { credentials: "same-origin" });
        if (res.ok) {
          const data = await res.json();
          const u = data.usuario ?? data;
          const nuevaFoto: string | null = u.fotoPerfil
            ? (u.fotoPerfil.startsWith("http") ? u.fotoPerfil : `http://localhost:8001${u.fotoPerfil.startsWith("/") ? u.fotoPerfil : "/" + u.fotoPerfil}`)
            : null;
          if (nuevaFoto && nuevaFoto !== profileImg.src) {
            profileImg.src = nuevaFoto;
          } else {
            // Mostrar iniciales como fallback
            const nombre: string = u.nombre ?? "U";
            const ini = nombre.split(/\s+/).map((p: string) => p[0]).join("").slice(0, 2).toUpperCase();
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "profile-pic profile-iniciales";
            btn.id = "btnUserMenu";
            btn.textContent = ini;
            btn.addEventListener("click", (e) => {
              e.stopPropagation();
              document.getElementById("user-menu")?.classList.toggle("active");
            });
            profileImg.replaceWith(btn);
          }
        }
      } catch { /* mantener imagen rota */ }
    });
  }
</script>
