---
import "./usuarios.css";
---

<div class="page" id="page-usuarios">
    <header class="page-header">
        <div>
        <h1>Usuarios</h1>
        <p>Gestiona cuentas, roles y estado de la plataforma</p>
        </div>
        <button type="button" class="btn-nueva" id="btn-nueva">+ Nuevo usuario</button>
    </header>
    <div class="toolbar">
        <input type="search" id="filtro-q" placeholder="Buscar nombre o correo…" />
        <select id="filtro-rol">
            <option value="">Todos los roles</option>
        </select>
        <select id="filtro-estado">
            <option value="">Todos los estados</option>
            <option value="Activa">Activa</option>
            <option value="Inactiva">Inactiva</option>
            <option value="Suspendida">Suspendida</option>
        </select>
    </div>

    <div class="stats">
        <div class="stat-card">
        <span class="stat-label">Total</span>
        <span class="stat-value" id="stat-total">—</span>
        </div>
        <div class="stat-card">
        <span class="stat-label">Activos</span>
        <span class="stat-value" id="stat-activos">—</span>
        </div>
        <div class="stat-card">
        <span class="stat-label">Inactivos</span>
        <span class="stat-value" id="stat-inactivos">—</span>
        </div>
    </div>

    <div class="table-wrap">
        <table class="tabla">
        <thead>
            <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Inmobiliaria</th>
            <th>Estado</th>
            <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tbody">
            <tr><td colspan="7" class="loading">Cargando…</td></tr>
        </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div id="modal" class="modal" hidden>
    <div class="modal-backdrop" data-cerrar></div>
    <div class="modal-card">
        <h3 id="modal-titulo">Nuevo usuario</h3>
        <p id="form-error" class="form-error" hidden></p>

        <input type="hidden" id="f-id" value="" />

        <label>Nombre *</label>
        <input type="text" id="f-nombre" />

        <label>Correo *</label>
        <input type="email" id="f-correo" />

        <label id="lbl-password">Contraseña *</label>
        <input type="password" id="f-password" autocomplete="new-password" />
        <p class="hint" id="hint-password">Mín. 8 caracteres. En edición, déjala vacía para no cambiarla.</p>

        <label>Teléfono</label>
        <input type="text" id="f-telefono" />

        <label>Rol *</label>
        <select id="f-rol"></select>

        <label>Inmobiliaria</label>
        <select id="f-inmobiliaria">
        <option value="">— Ninguna —</option>
        </select>

        <label>Estado</label>
        <select id="f-estado">
        <option value="Activa">Activa</option>
        <option value="Inactiva">Inactiva</option>
        <option value="Suspendida">Suspendida</option>
        </select>

        <div class="modal-actions">
        <button type="button" class="btn-outline" data-cerrar>Cancelar</button>
        <button type="button" class="btn-primary" id="btn-guardar">Guardar</button>
        </div>
    </div>
</div>

<script is:inline>
(function () {
  var lista = [];
  var roles = [];
  var inmobiliarias = [];

  function esSuperAdmin(u) {
    var rol = String(u.nombreRol || u.rol || "").toLowerCase();
    var rolId = Number(u.rolID || u.RolID || 0);
    return rol.indexOf("superadmin") >= 0 || rol.indexOf("super admin") >= 0 || rolId === 4;
    // Si tu RolID de SuperAdmin es otro, cámbialo aquí
  }

  function badgeEstado(e) {
    var s = String(e || "").toLowerCase();
    if (s.indexOf("activ") >= 0) return '<span class="badge badge-ok">' + e + "</span>";
    if (s.indexOf("susp") >= 0) return '<span class="badge badge-warn">' + e + "</span>";
    return '<span class="badge badge-off">' + (e || "—") + "</span>";
  }

  function pintarStats() {
    var total = lista.length;
    var activos = lista.filter(function (u) {
      return String(u.estadoCuenta || "").toLowerCase().indexOf("activ") >= 0;
    }).length;
    var inactivos = total - activos;
    var elT = document.getElementById("stat-total");
    var elA = document.getElementById("stat-activos");
    var elI = document.getElementById("stat-inactivos");
    if (elT) elT.textContent = String(total);
    if (elA) elA.textContent = String(activos);
    if (elI) elI.textContent = String(inactivos);
  }

  function pintarTabla(items) {
    items = items || lista;
    var tbody = document.getElementById("tbody");
    if (!tbody) return;
    if (!items.length) {
      tbody.innerHTML =
        '<tr><td colspan="7" class="loading">Sin resultados</td></tr>';
      return;
    }
    tbody.innerHTML = items
      .map(function (u) {
        var id = u.usuarioID || u.UsuarioID;
        var bloqueado = esSuperAdmin(u);
        var acciones = bloqueado
          ? '<span class="hint-sa">Protegido</span>'
          : '<button type="button" class="btn-sm" data-edit="' +
            id +
            '">Editar</button>';
        return (
          "<tr>" +
          "<td>" + id + "</td>" +
          "<td>" + (u.nombre || "") + "</td>" +
          "<td>" + (u.correo || "") + "</td>" +
          "<td>" + (u.nombreRol || u.rol || "—") + "</td>" +
          "<td>" + (u.inmobiliariaNombre || "—") + "</td>" +
          "<td>" + badgeEstado(u.estadoCuenta) + "</td>" +
          "<td>" + acciones + "</td>" +
          "</tr>"
        );
      })
      .join("");
  }

  function aplicarFiltro() {
    var q = (document.getElementById("filtro-q").value || "")
      .toLowerCase()
      .trim();
    var rol = document.getElementById("filtro-rol").value;
    var est = document.getElementById("filtro-estado").value;
    var filtrados = lista.filter(function (u) {
      var texto = ((u.nombre || "") + " " + (u.correo || "")).toLowerCase();
      var okQ = !q || texto.indexOf(q) >= 0;
      var okR = !rol || String(u.rolID || u.RolID) === String(rol);
      var okE = !est || String(u.estadoCuenta || "") === est;
      return okQ && okR && okE;
    });
    pintarTabla(filtrados);
  }

  function cargar() {
    return fetch("/api/superadmin/usuarios", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (json) {
        lista = json.data || [];
        pintarStats();
        aplicarFiltro();
      })
      .catch(function () {
        document.getElementById("tbody").innerHTML =
          '<tr><td colspan="7" class="loading">Error al cargar</td></tr>';
      });
  }

  function cargarRoles() {
    return fetch("/api/superadmin/usuarios?roles=1", {
      credentials: "same-origin",
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (json) {
        roles = json.data || [];
        var optsFiltro =
          '<option value="">Todos los roles</option>' +
          roles
            .map(function (r) {
              var id = r.rolID || r.RolID;
              var nom = r.nombreRol || r.NombreRol || "";
              return '<option value="' + id + '">' + nom + "</option>";
            })
            .join("");
        var optsForm =
          '<option value="">— Rol —</option>' +
          roles
            .map(function (r) {
              var id = r.rolID || r.RolID;
              var nom = r.nombreRol || r.NombreRol || "";
              // No ofrecer SuperAdmin al crear/editar otros
              if (String(nom).toLowerCase().indexOf("super") >= 0) return "";
              return '<option value="' + id + '">' + nom + "</option>";
            })
            .join("");
        document.getElementById("filtro-rol").innerHTML = optsFiltro;
        document.getElementById("f-rol").innerHTML = optsForm;
      });
  }

  function cargarInmobiliarias() {
    return fetch("/api/superadmin/inmobiliarias", {
      credentials: "same-origin",
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (json) {
        inmobiliarias = json.data || [];
        document.getElementById("f-inmobiliaria").innerHTML =
          '<option value="">— Ninguna —</option>' +
          inmobiliarias
            .map(function (i) {
              return (
                '<option value="' +
                i.inmobiliariaID +
                '">' +
                (i.nombre || "") +
                "</option>"
              );
            })
            .join("");
      });
  }

  function abrirModal() {
    var modal = document.getElementById("modal");
    document.getElementById("form-error").hidden = true;
    document.body.appendChild(modal);
    modal.hidden = false;
  }

  function cerrarModal() {
    document.getElementById("modal").hidden = true;
  }

  function limpiar() {
    document.getElementById("f-id").value = "";
    document.getElementById("f-nombre").value = "";
    document.getElementById("f-correo").value = "";
    document.getElementById("f-correo").disabled = false;
    document.getElementById("f-password").value = "";
    document.getElementById("f-telefono").value = "";
    document.getElementById("f-rol").value = "";
    document.getElementById("f-inmobiliaria").value = "";
    document.getElementById("f-estado").value = "Activa";
    document.getElementById("lbl-password").textContent = "Contraseña *";
    document.getElementById("modal-titulo").textContent = "Nuevo usuario";
  }

  function rellenar(u) {
    if (esSuperAdmin(u)) {
      alert("Las cuentas SuperAdmin no se pueden editar desde aquí.");
      return;
    }
    document.getElementById("f-id").value = u.usuarioID || u.UsuarioID;
    document.getElementById("f-nombre").value = u.nombre || "";
    document.getElementById("f-correo").value = u.correo || "";
    document.getElementById("f-correo").disabled = true;
    document.getElementById("f-password").value = "";
    document.getElementById("f-telefono").value = u.telefono || "";
    document.getElementById("f-rol").value = String(u.rolID || u.RolID || "");
    document.getElementById("f-inmobiliaria").value = u.inmobiliariaID
      ? String(u.inmobiliariaID)
      : "";
    document.getElementById("f-estado").value = u.estadoCuenta || "Activa";
    document.getElementById("lbl-password").textContent =
      "Contraseña (opcional)";
    document.getElementById("modal-titulo").textContent = "Editar usuario";
    abrirModal();
  }

  document.getElementById("btn-nueva").addEventListener("click", function () {
    limpiar();
    abrirModal();
  });

  document.querySelectorAll("[data-cerrar]").forEach(function (el) {
    el.addEventListener("click", cerrarModal);
  });

  document.getElementById("filtro-q").addEventListener("input", aplicarFiltro);
  document
    .getElementById("filtro-rol")
    .addEventListener("change", aplicarFiltro);
  document
    .getElementById("filtro-estado")
    .addEventListener("change", aplicarFiltro);

  document.getElementById("tbody").addEventListener("click", function (e) {
    var btn = e.target.closest("[data-edit]");
    if (!btn) return;
    var id = Number(btn.getAttribute("data-edit"));
    var u = lista.find(function (x) {
      return Number(x.usuarioID || x.UsuarioID) === id;
    });
    if (!u) return;
    rellenar(u);
  });

  document.getElementById("btn-guardar").addEventListener("click", function () {
    var err = document.getElementById("form-error");
    err.hidden = true;

    var id = document.getElementById("f-id").value;
    if (id) {
      var actual = lista.find(function (x) {
        return Number(x.usuarioID || x.UsuarioID) === Number(id);
      });
      if (actual && esSuperAdmin(actual)) {
        err.textContent = "No se puede editar un SuperAdmin";
        err.hidden = false;
        return;
      }
    }

    var nombre = document.getElementById("f-nombre").value.trim();
    var correo = document.getElementById("f-correo").value.trim();
    var password = document.getElementById("f-password").value;
    var telefono = document.getElementById("f-telefono").value.trim();
    var rolID = document.getElementById("f-rol").value;
    var inmobiliariaID = document.getElementById("f-inmobiliaria").value;
    var estadoCuenta = document.getElementById("f-estado").value;

    if (!nombre || !correo || !rolID) {
      err.textContent = "Nombre, correo y rol son obligatorios";
      err.hidden = false;
      return;
    }
    if (!id && !password) {
      err.textContent = "La contraseña es obligatoria al crear";
      err.hidden = false;
      return;
    }

    var payload = {
      nombre: nombre,
      correo: correo,
      telefono: telefono || null,
      rolID: Number(rolID),
      inmobiliariaID: inmobiliariaID ? Number(inmobiliariaID) : null,
      estadoCuenta: estadoCuenta,
    };
    if (password) payload.password = password;

    var url = id
      ? "/api/superadmin/usuarios?id=" + id
      : "/api/superadmin/usuarios";
    var method = id ? "PUT" : "POST";

    fetch(url, {
      method: method,
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    })
      .then(function (r) {
        return r.json().then(function (data) {
          if (!r.ok) throw new Error(data.message || data.error || "Error");
          cerrarModal();
          return cargar();
        });
      })
      .catch(function (e) {
        err.textContent = e.message || "Error al guardar";
        err.hidden = false;
      });
  });

  Promise.all([cargarRoles(), cargarInmobiliarias()]).then(cargar);
})();
</script>