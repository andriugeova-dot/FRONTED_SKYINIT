---
import "../admin/dashboard.css";
import { COOKIE_NAME, getTokenSSR } from "../../utils/auth";

const BACKEND = import.meta.env.BACKEND_URL ?? "http://localhost:8001";
const token = getTokenSSR(Astro.cookies);

type Resumen = {
    totales: {
        usuarios: number;
        inmobiliarias: number;
        constructoras: number;
        propiedades: number;
        proyectos: number;
    };
    usuariosPorRol: { rolID: number; nombreRol: string; total: number }[];
    propiedadesPorEstado: { estado: string; total: number }[];
    proyectosPorEstado: { estadoProyectoID: number; total: number }[];
    constructorasPorEstado: { estado: string; total: number }[];
};

let resumen: Resumen | null = null;
let errorCarga: string | null = null;

if (token) {
    try {
        const res = await fetch(`${BACKEND}/superadmin/dashboard`, {
        headers: {
            Cookie: `${COOKIE_NAME}=${token}`,
            Authorization: `Bearer ${token}`,
            Accept: "application/json",
        },
        });
        if (res.ok) resumen = await res.json();
        else errorCarga = `No se pudieron cargar las estadísticas (${res.status})`;
    } catch {
        errorCarga = "No se pudo conectar con el backend";
    }
    } else {
    errorCarga = "Sesión no válida";
}

const nombreEstadoProy = (id: number) =>
      id === 3 ? "Finalizados" : id === 2 ? "En construcción" : "Planificados";

const iconoEstadoProp = (estado: string) => {
    if (estado === "Disponible") return "bi-house-check";
    if (estado === "Reservada") return "bi-hourglass-split";
    if (estado === "Mantenimiento") return "bi-cone-striped";
    return "bi-slash-circle";
};
---

<div class="panel-body">
    <div class="topbar-panel">
        <h1>Panel SuperAdmin</h1>
        <p>Resumen global de la plataforma SkyInit.</p>
    </div>

    {errorCarga && (
        <div class="alert-error" role="alert">
        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
        {errorCarga}
        </div>
    )}

    {resumen && (
        <>
        <section class="stats-grid" aria-label="Totales">
            <div class="stat-card">
            <i class="bi bi-people-fill stat-icon" aria-hidden="true"></i>
            <div class="stat-info">
                <span class="stat-label">Usuarios</span>
                <span class="stat-value">{resumen.totales.usuarios}</span>
            </div>
            </div>
            <div class="stat-card">
            <i class="bi bi-building stat-icon" aria-hidden="true"></i>
            <div class="stat-info">
                <span class="stat-label">Inmobiliarias</span>
                <span class="stat-value">{resumen.totales.inmobiliarias}</span>
            </div>
            </div>
            <div class="stat-card">
            <i class="bi bi-hammer stat-icon" aria-hidden="true"></i>
            <div class="stat-info">
                <span class="stat-label">Constructoras</span>
                <span class="stat-value">{resumen.totales.constructoras}</span>
            </div>
            </div>
            <div class="stat-card">
            <i class="bi bi-houses stat-icon" aria-hidden="true"></i>
            <div class="stat-info">
                <span class="stat-label">Propiedades</span>
                <span class="stat-value">{resumen.totales.propiedades}</span>
            </div>
            </div>
            <div class="stat-card">
            <i class="bi bi-building-fill-up stat-icon" aria-hidden="true"></i>
            <div class="stat-info">
                <span class="stat-label">Proyectos</span>
                <span class="stat-value">{resumen.totales.proyectos}</span>
            </div>
            </div>
        </section>

        <section class="card">
            <h2><i class="bi bi-grid-1x2" aria-hidden="true"></i> Accesos rápidos</h2>
            <div class="accesos-grid">
            <a href="/superadmin/usuarios" class="acceso-btn">
                <i class="bi bi-people-fill" aria-hidden="true"></i> Usuarios
            </a>
            <a href="/superadmin/inmobiliarias" class="acceso-btn">
                <i class="bi bi-building" aria-hidden="true"></i> Inmobiliarias
            </a>
            <a href="/superadmin/constructoras" class="acceso-btn">
                <i class="bi bi-hammer" aria-hidden="true"></i> Constructoras
            </a>
            <a href="/superadmin/perfil" class="acceso-btn">
                <i class="bi bi-person-fill" aria-hidden="true"></i> Perfil
            </a>
            </div>
        </section>

        <div class="estados-grid">
            <section class="card">
            <h2><i class="bi bi-people" aria-hidden="true"></i> Usuarios por rol</h2>
            <div class="breakdown-list">
                {resumen.usuariosPorRol.map((u) => (
                <div class="breakdown-row">
                    <span class="breakdown-dot">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                    </span>
                    <span class="breakdown-label">{u.nombreRol}</span>
                    <span class="breakdown-value">{u.total}</span>
                </div>
                ))}
            </div>
            </section>

            <section class="card">
            <h2><i class="bi bi-hammer" aria-hidden="true"></i> Constructoras por estado</h2>
            <div class="breakdown-list">
                {resumen.constructorasPorEstado.length === 0 ? (
                <p class="empty-hint">Sin datos</p>
                ) : (
                resumen.constructorasPorEstado.map((c) => (
                    <div class="breakdown-row">
                    <span class="breakdown-dot">
                        <i class="bi bi-circle-fill" aria-hidden="true"></i>
                    </span>
                    <span class="breakdown-label">{c.estado}</span>
                    <span class="breakdown-value">{c.total}</span>
                    </div>
                ))
                )}
            </div>
            </section>
        </div>

        <div class="estados-grid">
            <section class="card">
            <h2><i class="bi bi-houses" aria-hidden="true"></i> Propiedades por estado</h2>
            <div class="breakdown-list">
                {resumen.propiedadesPorEstado.map((p) => (
                <div class="breakdown-row">
                    <span class="breakdown-dot">
                    <i class={`bi ${iconoEstadoProp(p.estado ?? "")}`} aria-hidden="true"></i>
                    </span>
                    <span class="breakdown-label">{p.estado}</span>
                    <span class="breakdown-value">{p.total}</span>
                </div>
                ))}
            </div>
            </section>

            <section class="card">
            <h2><i class="bi bi-building-fill-up" aria-hidden="true"></i> Proyectos por estado</h2>
            <div class="breakdown-list">
                {resumen.proyectosPorEstado.map((p) => (
                <div class="breakdown-row">
                    <span class="breakdown-dot">
                    <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
                    </span>
                    <span class="breakdown-label">{nombreEstadoProy(p.estadoProyectoID)}</span>
                    <span class="breakdown-value">{p.total}</span>
                </div>
                ))}
            </div>
            </section>
        </div>
        </>
    )}
</div>