---
import "./perfil.css"
---

<div class="perfil-page">
    <h1>Perfil Constructora</h1>


    <div id="alerta" class="alerta d-none" role="alert"></div>

    <div class="perfil-grid">
        <!-- LOGO -->
        <section class="card logo-card">
        <h2>Logo</h2>
        <div class="logo-preview">
            <img id="logoImg" src="" alt="Logo" class="d-none" />
            <div id="logoPlaceholder" class="logo-placeholder">Sin logo</div>
        </div>
        <label class="btn-file">
            Elegir imagen
            <input type="file" id="inputLogo" accept="image/jpeg,image/png,image/webp" hidden />
        </label>
        <button type="button" class="btn btn-primary" id="btnSubirLogo" disabled>
            Subir logo
        </button>
        <p class="hint">JPG, PNG o WebP · máx. 5 MB</p>
        </section>

        <!-- DATOS -->
        <section class="card">
            <h2>Datos</h2>
            <form id="formPerfil">
                <div class="campo">
                <label for="nombre">Nombre *</label>
                <input type="text" id="nombre" name="nombre" required />
                </div>

                <div class="campo">
                <label for="descripcion">Descripción *</label>
                <textarea id="descripcion" name="descripcion" rows="3" required></textarea>
                </div>

                <div class="fila">
                <div class="campo">
                    <label for="contacto">Contacto</label>
                    <input type="text" id="contacto" name="contacto" />
                </div>
                <div class="campo">
                    <label for="telefono">Teléfono</label>
                    <input
                        type="text"
                        id="telefono"
                        name="tel_constructora_sky"
                        autocomplete="off"
                        data-lpignore="true"
                    />
                </div>
                </div>

                <div class="fila">
                    <div class="campo">
                        <label for="correo">Correo</label>
                        <input type="email" id="correo" name="correo" disabled readonly autocomplete="off" />
                    </div>
                    <div class="campo">
                        <label for="ciudad">Ciudad</label>
                        <input type="text" id="ciudad" name="ciudad" disabled readonly />
                    </div>
                </div>

                <div class="campo inmo-section">
                    <label>Inmobiliarias asociadas</label>
                    <div id="lista-inmobiliarias" class="inmo-list"></div>
                </div>
                <button type="submit" class="btn btn-primary" id="btnGuardar">
                Guardar cambios
                </button>
            </form>
            </section>
    </div>
</div>

<script>
    const BACKEND_PUBLIC = "http://localhost:8001";

    const alerta = document.getElementById("alerta") as HTMLDivElement;
    const logoImg = document.getElementById("logoImg") as HTMLImageElement;
    const logoPlaceholder = document.getElementById("logoPlaceholder") as HTMLDivElement;
    const inputLogo = document.getElementById("inputLogo") as HTMLInputElement;
    const btnSubirLogo = document.getElementById("btnSubirLogo") as HTMLButtonElement;
    const form = document.getElementById("formPerfil") as HTMLFormElement;

    function mostrarAlerta(msg: string, ok: boolean) {
        alerta.textContent = msg;
        alerta.classList.remove("d-none", "ok", "error");
        alerta.classList.add(ok ? "ok" : "error");
    }

    function urlLogo(path: string | null | undefined): string | null {
        if (!path) return null;
        if (path.startsWith("http")) return path;
        return `${BACKEND_PUBLIC}${path.startsWith("/") ? path : "/" + path}`;
    }

    function pintarLogo(path: string | null) {
        const src = urlLogo(path);
        if (src) {
        logoImg.src = src;
        logoImg.classList.remove("d-none");
        logoPlaceholder.classList.add("d-none");
        } else {
        logoImg.classList.add("d-none");
        logoPlaceholder.classList.remove("d-none");
        }
    }

    async function cargarPerfil() {
        try {
        const res = await fetch("/api/panel/constructora/perfil");
        const json = await res.json();
        if (!res.ok) {
            mostrarAlerta(json.error || json.message || "No se pudo cargar el perfil", false);
            return;
        }
        const d = json.data ?? json;
        const tel = document.getElementById("telefono") as HTMLInputElement;
            tel.value = "";
            tel.value = String(d.telefono ?? "");
        setTimeout(() => {
        tel.value = String(d.telefono ?? "");
        }, 50);
        setTimeout(() => {
        tel.value = String(d.telefono ?? "");
        }, 400);
        (document.getElementById("nombre") as HTMLInputElement).value = d.nombre ?? "";
        (document.getElementById("descripcion") as HTMLTextAreaElement).value =
            d.descripcion ?? "";
        (document.getElementById("contacto") as HTMLInputElement).value = d.contacto ?? "";
        (document.getElementById("correo") as HTMLInputElement).value = d.correo ?? "";
        (document.getElementById("ciudad") as HTMLInputElement).value = d.ciudad ?? "";

        const cont = document.getElementById("lista-inmobiliarias") as HTMLDivElement;
        const lista = d.inmobiliarias ?? [];

            if (!lista.length) {
            cont.innerHTML =
                '<div class="inmo-empty-box">Sin inmobiliarias vinculadas</div>';
            } else {
            cont.innerHTML = lista
                .map((i: { nombre?: string; ciudad?: string; estado?: string }) => {
                const nombre = i.nombre ?? "Inmobiliaria";
                const ciudad = i.ciudad ?? "—";
                const estado = i.estado ?? "";

                return (
                    '<article class="inmo-card">' +
                    '<div class="inmo-card-icon"><i class="bi bi-buildings"></i></div>' +
                    '<div class="inmo-card-body">' +
                        '<p class="inmo-card-name">' + nombre + "</p>" +
                        '<p class="inmo-card-city">' + ciudad + "</p>" +
                    "</div>" +
                    (estado
                        ? '<span class="inmo-card-badge">' + estado + "</span>"
                        : "") +
                    "</article>"
                );
                })
                .join("");
            }

        pintarLogo(d.logo ?? d.Logo ?? null);

        } catch {
        mostrarAlerta("Error de conexión al cargar el perfil", false);
        }
    }

    inputLogo.addEventListener("change", () => {
        btnSubirLogo.disabled = !inputLogo.files?.length;
        const file = inputLogo.files?.[0];
        if (file) {
        const preview = URL.createObjectURL(file);
        logoImg.src = preview;
        logoImg.classList.remove("d-none");
        logoPlaceholder.classList.add("d-none");
        }
    });

    btnSubirLogo.addEventListener("click", async () => {
        const file = inputLogo.files?.[0];
        if (!file) return;

        const fd = new FormData();
        fd.append("logo", file); // nombre del campo que espera Deno

        btnSubirLogo.disabled = true;
        try {
        const res = await fetch("/api/panel/constructora/logo", {
            method: "POST",
            body: fd,
        });
        const json = await res.json();
        if (!res.ok) {
            mostrarAlerta(json.error || json.message || "Error al subir el logo", false);
            return;
        }
        mostrarAlerta("Logo actualizado. Recarga para verlo en el menú.", true);
        if (json.url) pintarLogo(json.url);
        inputLogo.value = "";
        } catch {
        mostrarAlerta("Error de conexión al subir el logo", false);
        } finally {
        btnSubirLogo.disabled = !inputLogo.files?.length;
        }
    });

    form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const body = {
                nombre: (document.getElementById("nombre") as HTMLInputElement).value.trim(),
                descripcion: (document.getElementById("descripcion") as HTMLTextAreaElement).value.trim(),
                contacto: (document.getElementById("contacto") as HTMLInputElement).value.trim(),
                telefono: (document.getElementById("telefono") as HTMLInputElement).value.trim(),
            };

            try {
                const res = await fetch("/api/panel/constructora/perfil", {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                credentials: "same-origin",
                body: JSON.stringify(body),
                });
                const json = await res.json();
                if (!res.ok) {
                mostrarAlerta(json.message || json.error || "Error al guardar", false);
                return;
                }
                mostrarAlerta(json.message || "Datos guardados correctamente", true);
            } catch {
                mostrarAlerta("Error de conexión al guardar", false);
            }
            });

    cargarPerfil();
</script>