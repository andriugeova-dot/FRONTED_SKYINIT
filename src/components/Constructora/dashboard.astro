---
---

<div class="dash">
    <header class="dash-header">
        <div>
        <h1>Dashboard</h1>
        <p class="dash-sub">Resumen de tu constructora</p>
        </div>
        <div class="dash-actions">
        <a href="/constructora/proyectos" class="btn-outline">Proyectos</a>
        <a href="/constructora/propiedades" class="btn-primary">Propiedades</a>
        </div>
    </header>

    <div id="dash-error" class="dash-alert d-none"></div>
    <div id="dash-loading" class="dash-loading">Cargando...</div>

    <section id="dash-content" class="d-none">
        <div class="kpi-grid">
        <article class="kpi-card">
            <span class="kpi-label">Propiedades</span>
            <strong id="kpi-propiedades" class="kpi-value">0</strong>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Proyectos</span>
            <strong id="kpi-proyectos" class="kpi-value">0</strong>
        </article>
        <article class="kpi-card kpi-accent">
            <span class="kpi-label">Avance promedio</span>
            <strong id="kpi-avance" class="kpi-value">0%</strong>
        </article>
        </div>

        <div class="panels-grid">
        <article class="panel-card">
            <h2>Propiedades por estado</h2>
            <ul id="lista-prop-estado" class="stat-list"></ul>
        </article>
        <article class="panel-card">
            <h2>Proyectos por estado</h2>
            <ul id="lista-proy-estado" class="stat-list"></ul>
        </article>
        </div>
    </section>
</div>

<style>
    .dash {
        padding: 1.5rem 1.75rem 2.5rem;
        max-width: 1100px;
    }
    .dash-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .dash-header h1 {
        margin: 0;
        font-size: 1.75rem;
        color: #1a241c;
    }
    .dash-sub {
        margin: 0.25rem 0 0;
        color: #6b7c72;
        font-size: 0.95rem;
    }
    .dash-actions {
        display: flex;
        gap: 0.6rem;
        align-items: center;
    }
    .btn-primary,
    .btn-outline {
        display: inline-block;
        padding: 0.55rem 1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
    }
    .btn-primary {
        background: #c8ad72;
        color: #1a241c;
    }
    .btn-outline {
        border: 1px solid #c8ad72;
        color: #253229;
        background: transparent;
    }
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .kpi-card {
        background: #fff;
        border: 1px solid #e5e9e5;
        border-radius: 14px;
        padding: 1.15rem 1.25rem;
        box-shadow: 0 2px 10px rgba(37, 50, 41, 0.04);
    }
    .kpi-accent {
        background: #253229;
        border-color: #253229;
    }
    .kpi-accent .kpi-label,
    .kpi-accent .kpi-value {
        color: #f5f1e8;
    }
    .kpi-accent .kpi-value {
        color: #c8ad72;
    }
    .kpi-label {
        display: block;
        font-size: 0.8rem;
        color: #6b7c72;
        margin-bottom: 0.35rem;
    }
    .kpi-value {
        font-size: 1.85rem;
        color: #253229;
    }
    .panels-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
    }
    .panel-card {
        background: #fff;
        border: 1px solid #e5e9e5;
        border-radius: 14px;
        padding: 1.2rem 1.25rem;
    }
    .panel-card h2 {
        margin: 0 0 0.85rem;
        font-size: 1rem;
        color: #253229;
    }
    .stat-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .stat-list li {
        display: flex;
        justify-content: space-between;
        padding: 0.55rem 0;
        border-bottom: 1px solid #eef1ee;
        font-size: 0.92rem;
        color: #3d4a42;
    }
    .stat-list li:last-child {
        border-bottom: none;
    }
    .stat-list strong {
        color: #253229;
    }
    .dash-loading {
        color: #6b7c72;
        padding: 1rem 0;
    }
    .dash-alert {
        background: #fef2f2;
        color: #991b1b;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
    }
    .d-none {
        display: none !important;
    }
</style>

<script>
    async function cargarDashboard() {
        const loading = document.getElementById("dash-loading");
        const content = document.getElementById("dash-content");
        const errorEl = document.getElementById("dash-error");

        try {
        const res = await fetch("/api/panel/constructora/dashboard", {
            credentials: "same-origin",
        });
        const json = await res.json();

        if (!res.ok || !json.success) {
            throw new Error(json.message || json.error || "No se pudo cargar el dashboard");
        }

        const d = json.data;

        document.getElementById("kpi-propiedades")!.textContent = String(d.totalPropiedades ?? 0);
        document.getElementById("kpi-proyectos")!.textContent = String(d.totalProyectos ?? 0);
        const avance = Number(d.avancePromedioProyectos ?? 0);
        document.getElementById("kpi-avance")!.textContent = `${avance.toFixed(1)}%`;

        const ulProp = document.getElementById("lista-prop-estado")!;
        ulProp.innerHTML = "";
        const props = d.propiedadesPorEstado ?? [];
        if (props.length === 0) {
            ulProp.innerHTML = "<li><span>Sin datos</span><strong>0</strong></li>";
        } else {
            for (const row of props) {
            const li = document.createElement("li");
            li.innerHTML = `<span>${row.estado ?? "—"}</span><strong>${row.total}</strong>`;
            ulProp.appendChild(li);
            }
        }

        const ulProy = document.getElementById("lista-proy-estado")!;
        ulProy.innerHTML = "";
        const proys = d.proyectosPorEstado ?? [];
        if (proys.length === 0) {
            ulProy.innerHTML = "<li><span>Sin datos</span><strong>0</strong></li>";
        } else {
            for (const row of proys) {
            const li = document.createElement("li");
            li.innerHTML = `<span>${row.estado ?? "—"}</span><strong>${row.total}</strong>`;
            ulProy.appendChild(li);
            }
        }

        loading?.classList.add("d-none");
        content?.classList.remove("d-none");
        } catch (err: any) {
        loading?.classList.add("d-none");
        errorEl!.textContent = err.message || "Error al cargar";
        errorEl!.classList.remove("d-none");
        }
    }

    cargarDashboard();
</script>