---
import "./propiedades.css";

interface Propiedad {
    propiedadID: number,
    titulo: string,
    descripcion: string | null;
    precio: string;
    habitaciones: number | null;
    direccion: string;
    ciudad: string | null;
    tipoOperacion: string;  
    imagenPrincipal: string | null;
}

interface Usuario {
    nombre?: string;
    fotoPerfil?: string | null;
}

interface Filtros {
    query: string;
    tipoOperacion: string;
    habitaciones: string;
    ciudad: string;
}

interface Props {
    propiedades: Propiedad[];
    usuario: Usuario | null;
    filtros: Filtros;
}

const { propiedades, usuario, filtros } = Astro.props;

const formatoPesos = new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    minimumFractionDigits: 0,
});

function claseBadge(tipo: string) {
    const t = (tipo ?? "").toLowerCase();
    if (t.includes("venta")) return "badge-venta";
    if (t.includes("arriendo")) return "badge-arriendo";
    return "badge-default";
}

const BACKEND_URL = "http://localhost:8001";
function resolverImagenTarjeta(url: string | null) {
    if (!url) return "/img/no-image.png";
    return url.startsWith("/uploads") ? `${BACKEND_URL}${url}` : url;
}
---
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Propiedades - SkyInit</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
</head>
<header id="header">
    <div class="topbar">
        <div class="logo">SkyInit</div>
        <div class="menu-toggle" id="menuToggle">&#9776;</div>
        <nav id="menu">
            <a href="/">Inicio</a>
            <a href="/propiedades">Propiedades</a>
            <a href="/proyectos">Proyectos</a>
            <a href="/servicios">Servicios</a>
            <a href="/constructoras">Constructoras</a>
            {usuario ? (
                <div class="user-profile">
                    <img
                        src={usuario.fotoPerfil ?? "/img/default-avatar.svg"}
                        alt="Avatar"
                        class="profile-pic"
                        id="profilePic"
                    />
                    <div id="user-menu" class="user-menu">
                        <div class="user-menu-name">{usuario.nombre}</div>
                        <a href="/perfil">⚙️ Ajustes</a>
                        <a href="#" id="btnLogout">🚪 Cerrar sesión</a>
                    </div>
                </div>
            ) : (
                <a href="/login" class="btn-registrar">Iniciar Sesión</a>
            )}
        </nav>
    </div>

    <div class="hero-inner">
        <div class="hero-eyebrow">Catálogo completo</div>
        <h1>Encuentra tu <em>propiedad ideal</em></h1>
        <p class="hero-sub">Explora casas, apartamentos y encuentra el hogar que se ajusta a lo que buscas.</p>
    </div>
</header>

<section class="search-container">
    <form action="/propiedades" method="get" class="search-box">
        <input type="text" name="query" value={filtros.query} placeholder="Buscar por título o descripción..." />

        <select name="tipoOperacion">
            <option value="">-- Tipo de operación --</option>
            <option value="1" selected={filtros.tipoOperacion === "1"}>Venta</option>
            <option value="2" selected={filtros.tipoOperacion === "2"}>Arriendo</option>
            <option value="3" selected={filtros.tipoOperacion === "3"}>Empeño</option>
        </select>

        <select name="habitaciones">
            <option value="">-- Habitaciones --</option>
            <option value="1" selected={filtros.habitaciones === "1"}>1</option>
            <option value="2" selected={filtros.habitaciones === "2"}>2</option>
            <option value="3" selected={filtros.habitaciones === "3"}>3+</option>
        </select>

        <input type="text" name="ciudad" value={filtros.ciudad} placeholder="Ciudad" />

        <button type="submit">Buscar</button>
    </form>
</section>

<section class="contenedor resultados-section">
    <div class="header-destacadas">
        <div class="textos-destacadas">
            <span class="etiqueta-destacadas">Catálogo</span>
            <h2 class="titulo-destacadas">{propiedades.length} propiedades disponibles</h2>
            <p class="sub-destacadas">
                Explora el listado completo y encuentra la opción que mejor se adapte a ti
            </p>
        </div>
    </div>

    <div class="properties">
        {propiedades.length > 0 ? (
            propiedades.map((propiedad) => (
                <div class="property-card">
                    <div class="property-image">
                        <img src={resolverImagenTarjeta(propiedad.imagenPrincipal)} alt={propiedad.titulo} />

                        <span class={`badge-tipo ${claseBadge(propiedad.tipoOperacion)}`}>
                            {propiedad.tipoOperacion}
                        </span>

                        <button type="button" class="btn-favorito favorito-inactivo" data-id={propiedad.propiedadID}>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                        </button>
                    </div>

                    <div class="property-info">
                        <div class="precio-container">
                            <h3>{formatoPesos.format(Number(propiedad.precio))}</h3>
                        </div>

                        <h2>{propiedad.titulo}</h2>

                        <p class="location">
                            <svg class="icono-pin" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                            </svg>
                            <span>{propiedad.ciudad ?? propiedad.direccion}</span>
                        </p>

                        <p class="description">{propiedad.descripcion}</p>

                        <div class="details">
                            <span>🛏️ {propiedad.habitaciones ?? 0} Habitaciones</span>
                        </div>

                        <a
                            href={`/propiedades#propiedad-${propiedad.propiedadID}`}
                            class="link-detalle-propiedad enlace-absoluto"
                            data-id={propiedad.propiedadID}
                        ></a>
                    </div>
                </div>
            ))
        ) : (
            <p class="sin-resultados">No se encontraron propiedades con los filtros seleccionados.</p>
        )}
    </div>
</section>

<div id="modalRegistro" class="modal-overlay">
    <div class="modal-box modal-box-login">
        <button class="modal-close" id="cerrarModalRegistro">X</button>
        <div class="modal-info">
            <h2>Debes estar registrado</h2>
            <p>Para guardar favoritos debes iniciar sesion</p>
            <div class="acciones-login">
                <a href="/login" class="btn-contacto">Iniciar Sesion</a>
            </div>
        </div>
    </div>
</div>

<div id="modalPropiedad" class="modal">
    <div class="modal-content modal-content-propiedad">
        <span class="modal-close">&times;</span>
        <div id="modal-body">
            <h2 id="modalTitulo"></h2>
            <img id="modalImagen" src="" alt="Imagen propiedad" class="modal-img-propiedad" />
            <p id="modalDescripcion"></p>

            <div class="modal-detalles-grid">
                <p id="modalPrecio"></p>
                <p id="modalUbicacion"></p>
                <p id="modalTipoOperacion"></p>
                <p id="modalHabitaciones"></p>
            </div>

            <div class="modal-contacto">
                <div class="modal-agente" id="modalAgenteWrap">
                    <img id="modalAgenteFoto" src="/img/default-avatar.svg" alt="Foto del agente" class="modal-avatar" />
                    <div class="modal-contacto-info">
                        <span class="modal-contacto-label">Agente encargado</span>
                        <p id="modalAgenteNombre"></p>
                        <p id="modalAgenteTelefono"></p>
                    </div>
                </div>

                <div class="modal-constructora" id="modalConstructoraWrap">
                    <div class="modal-contacto-info">
                        <span class="modal-contacto-label">Constructora</span>
                        <p id="modalConstructoraNombre"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

<script>
    const BACKEND_URL = "http://localhost:8001";

    // Menús
    document.getElementById("menuToggle")?.addEventListener("click", () => {
        document.getElementById("menu")?.classList.toggle("active");
    });
    document.getElementById("profilePic")?.addEventListener("click", () => {
        document.getElementById("user-menu")?.classList.toggle("active");
    });
    document.getElementById("btnLogout")?.addEventListener("click", async (e) => {
        e.preventDefault();
        await fetch("/api/logout", { method: "POST" });
        window.location.href = "/login";
    });

    // Fondo del hero (decorativo)
    const heroImages = [
        "https://images.unsplash.com/photo-1600585154340-be6161a56a0c",
        "https://images.unsplash.com/photo-1568605114967-8130f3a36994",
        "https://images.unsplash.com/photo-1570129477492-45c003edd2be",
    ];
    let heroIndex = 0;
    const heroHeader = document.getElementById("header") as HTMLElement;

    function cambiarFondoHero() {
        heroHeader.style.backgroundImage = `url(${heroImages[heroIndex]})`;
        heroIndex = (heroIndex + 1) % heroImages.length;
    }
    cambiarFondoHero();
    setInterval(cambiarFondoHero, 5000);

    // Favoritos (el backend aún no tiene el endpoint)
    const modalRegistro = document.getElementById("modalRegistro") as HTMLElement;

    document.querySelectorAll(".btn-favorito").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const propiedadId = btn.getAttribute("data-id");
            try {
                const response = await fetch("/api/favoritos/toggle", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ propiedadID: Number(propiedadId) }),
                });

                if (response.ok) {
                    btn.classList.toggle("favorito-activo");
                    btn.classList.toggle("favorito-inactivo");
                } else if (response.status === 401) {
                    modalRegistro.classList.add("open");
                } else {
                    alert("Favoritos aún no está disponible.");
                }
            } catch {
                alert("No se pudo conectar con el servidor.");
            }
        });
    });

    document.getElementById("cerrarModalRegistro")?.addEventListener("click", () => {
        modalRegistro.classList.remove("open");
    });
    modalRegistro.addEventListener("click", (e) => {
        if (e.target === modalRegistro) modalRegistro.classList.remove("open");
    });

    // Modal de detalle
    const modal = document.getElementById("modalPropiedad") as HTMLElement;
    const closeBtn = document.querySelector("#modalPropiedad .modal-close") as HTMLElement;

    const formatoPesos = new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: "COP",
        minimumFractionDigits: 0,
    });

    function resolverImagen(url?: string | null) {
        if (!url) return "/img/no-image.png";
        return url.startsWith("/uploads") ? `${BACKEND_URL}${url}` : url;
    }

    document.querySelectorAll<HTMLElement>(".link-detalle-propiedad").forEach((enlace) => {
        enlace.addEventListener("click", async (e) => {
            e.preventDefault();
            const propiedadId = enlace.dataset.id;

            try {
                const response = await fetch(`${BACKEND_URL}/api/propiedades/${propiedadId}`);
                if (!response.ok) throw new Error("No se pudo cargar la info");

                const { propiedad } = await response.json();

                (document.getElementById("modalTitulo") as HTMLElement).textContent = propiedad.titulo;
                 (document.getElementById("modalImagen") as HTMLImageElement).src = resolverImagen(propiedad.imagenes?.[0]);
                (document.getElementById("modalDescripcion") as HTMLElement).textContent = propiedad.descripcion ?? "";
                (document.getElementById("modalPrecio") as HTMLElement).textContent = formatoPesos.format(Number(propiedad.precio));
                (document.getElementById("modalUbicacion") as HTMLElement).textContent =
                    `Ubicación: ${propiedad.direccion}${propiedad.ciudad ? `, ${propiedad.ciudad}` : ""}`;
                (document.getElementById("modalTipoOperacion") as HTMLElement).textContent = `Operación: ${propiedad.tipoOperacion}`;
                (document.getElementById("modalHabitaciones") as HTMLElement).textContent = propiedad.habitaciones
                    ? `Habitaciones: ${propiedad.habitaciones}`
                    : "Habitaciones: No especificado";

         const agenteWrap = document.getElementById("modalAgenteWrap") as HTMLElement;
         const nombreEl = document.getElementById("modalAgenteNombre") as HTMLElement;
         const telEl = document.getElementById("modalAgenteTelefono");

         const agenteNombre = propiedad.agenteNombre ?? propiedad.agente?.nombre ?? null;
         const agenteCorreo = propiedad.agenteCorreo ?? propiedad.agente?.correo ?? "";
         const agenteTelefono = propiedad.agenteTelefono ?? propiedad.agente?.telefono ?? "";

           if (agenteNombre || agenteCorreo || agenteTelefono) {
                if (agenteNombre) {
                    nombreEl.textContent = agenteCorreo
                        ? `${agenteNombre} (${agenteCorreo})`
                        : agenteNombre;
                } else if (agenteCorreo) {
                    nombreEl.textContent = agenteCorreo;
                } else {
                    nombreEl.textContent = "Agente";
                }

                if (telEl) {
                    telEl.textContent = agenteTelefono ? `Tel: ${agenteTelefono}` : "";
                }
                agenteWrap.style.display = "flex";
            } else {
                nombreEl.textContent = "Sin agente asignado";
                if (telEl) telEl.textContent = "";
                agenteWrap.style.display = "flex";
            }
                    const constructoraWrap = document.getElementById("modalConstructoraWrap") as HTMLElement;
                    if (propiedad.constructoraNombre) {
                        (document.getElementById("modalConstructoraNombre") as HTMLElement).textContent = propiedad.constructoraNombre;
                        constructoraWrap.style.display = "flex";
                    } else {
                        constructoraWrap.style.display = "none";
                    }

                    modal.classList.add("active");
            } catch (error) {
                console.error("Error cargando los detalles:", error);
                alert("Hubo un error al cargar la informacion de la propiedad");
            }
        });
    });
    closeBtn.addEventListener("click", () => modal.classList.remove("active"));
    window.addEventListener("click", (e) => {
        if (e.target === modal) modal.classList.remove("active");
    });
    </script>