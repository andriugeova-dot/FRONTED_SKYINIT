---
// Componente: Explorador de propiedades para el rol Usuario
---

<div class="prop-explorer">
    <!-- ENCABEZADO -->
    <div class="page-header">
        <div>
            <h1 class="page-titulo"><i class="bi bi-house-door-fill"></i> Explorar Propiedades</h1>
            <p class="page-desc">Busca y filtra propiedades disponibles para arriendo o venta.</p>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="filtros-bar">
        <div class="filtro-group">
            <label>Ciudad</label>
            <input type="text" id="filtroCiudad" class="filtro-input" placeholder="Ej: Bogotá, Medellín..." />
        </div>
        <div class="filtro-group">
            <label>Tipo de operación</label>
            <select id="filtroTipo" class="filtro-input">
                <option value="">Todos</option>
                <option value="1">Venta</option>
                <option value="2">Arriendo</option>
            </select>
        </div>
        <div class="filtro-group">
            <label>Habitaciones</label>
            <select id="filtroHabitaciones" class="filtro-input">
                <option value="">Cualquiera</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4+</option>
            </select>
        </div>
        <div class="filtro-group">
            <label>Precio máx. (COP)</label>
            <input type="number" id="filtroPrecioMax" class="filtro-input" placeholder="Sin límite" />
        </div>
        <button id="btnBuscar" class="btn-buscar">
            <i class="bi bi-search"></i> Buscar
        </button>
    </div>

    <!-- ESTADO DE CARGA -->
    <div id="estadoCarga" class="estado-carga" style="display:none;">
        <div class="spinner"></div>
        <span>Buscando propiedades...</span>
    </div>

    <!-- MENSAJE VACÍO -->
    <div id="sinResultados" class="sin-resultados" style="display:none;">
        <i class="bi bi-search"></i>
        <p>No se encontraron propiedades con los filtros seleccionados.</p>
        <button id="btnLimpiar" class="btn-limpiar">Limpiar filtros</button>
    </div>

    <!-- GRID DE PROPIEDADES -->
    <div id="gridPropiedades" class="grid-propiedades"></div>
</div>

<!-- MODAL DETALLE -->
<div id="modalPropiedad" class="modal-overlay" style="display:none;">
    <div class="modal-card">
        <button class="modal-close" id="btnCerrarModal">
            <i class="bi bi-x-lg"></i>
        </button>
        <div id="modalContenido"></div>
    </div>
</div>

<style>
.prop-explorer { display: flex; flex-direction: column; gap: 1.5rem; }

/* Header */
.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}
.page-titulo {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.page-titulo i { color: #3b82f6; }
.page-desc { margin: 0; font-size: 0.85rem; color: #6b7280; }

/* Filtros */
.filtros-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
    background: #fff;
    border: 1.5px solid #e5e7eb;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
}
.filtro-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    min-width: 150px;
}
.filtro-group label {
    font-size: 0.74rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.filtro-input {
    height: 38px;
    padding: 0 12px;
    border: 1.5px solid #d1d5db;
    border-radius: 9px;
    font-size: 0.85rem;
    color: #1f2937;
    background: #f9fafb;
    outline: none;
    transition: border-color 0.2s;
}
.filtro-input:focus { border-color: #3b82f6; background: #fff; }
.btn-buscar {
    height: 38px;
    padding: 0 20px;
    background: #1a2e3b;
    color: #fff;
    border: none;
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: background 0.2s;
    white-space: nowrap;
}
.btn-buscar:hover { background: #0f4c6b; }

/* Grid */
.grid-propiedades {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
}

/* Card propiedad */
.prop-card {
    background: #fff;
    border-radius: 14px;
    border: 1.5px solid #e5e7eb;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
}
.prop-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.1);
}
.prop-card-img {
    width: 100%;
    height: 175px;
    object-fit: cover;
    background: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 2.5rem;
}
.prop-card-img img { width: 100%; height: 100%; object-fit: cover; }
.prop-card-body { padding: 1rem 1.25rem; }
.prop-card-tipo {
    display: inline-flex;
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}
.tipo-venta   { background: #eff6ff; color: #3b82f6; }
.tipo-arriendo { background: #ecfdf5; color: #10b981; }
.prop-card-titulo {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.prop-card-ciudad {
    font-size: 0.78rem;
    color: #6b7280;
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 10px;
}
.prop-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px solid #f3f4f6;
}
.prop-precio {
    font-size: 1rem;
    font-weight: 700;
    color: #1a2e3b;
}
.prop-hab {
    font-size: 0.78rem;
    color: #6b7280;
    display: flex;
    align-items: center;
    gap: 4px;
}

/* Estados */
.estado-carga {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 3rem;
    color: #6b7280;
    font-size: 0.9rem;
}
.spinner {
    width: 22px;
    height: 22px;
    border: 2.5px solid #e5e7eb;
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.sin-resultados {
    text-align: center;
    padding: 3rem;
    color: #6b7280;
    background: #fff;
    border-radius: 14px;
    border: 1.5px dashed #d1d5db;
}
.sin-resultados i { font-size: 2.5rem; margin-bottom: 1rem; display: block; }
.btn-limpiar {
    margin-top: 1rem;
    padding: 8px 18px;
    background: transparent;
    border: 1.5px solid #d1d5db;
    border-radius: 9px;
    cursor: pointer;
    font-size: 0.85rem;
    color: #374151;
    transition: all 0.2s;
}
.btn-limpiar:hover { background: #f3f4f6; }

/* Modal */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}
.modal-card {
    background: #fff;
    border-radius: 18px;
    max-width: 540px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    position: relative;
}
.modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #f3f4f6;
    border: none;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    transition: background 0.2s;
}
.modal-close:hover { background: #e5e7eb; }
.modal-prop-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 1.25rem;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: #d1d5db;
}
.modal-prop-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
.modal-prop-titulo { font-size: 1.2rem; font-weight: 700; color: #1f2937; margin: 0 0 6px; }
.modal-prop-precio { font-size: 1.1rem; font-weight: 700; color: #3b82f6; margin: 0 0 1rem; }
.modal-detalles { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem; }
.modal-detalle-item { display: flex; flex-direction: column; gap: 3px; }
.modal-detalle-label { font-size: 0.72rem; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; }
.modal-detalle-valor { font-size: 0.88rem; color: #374151; font-weight: 500; }
.modal-descripcion { font-size: 0.85rem; color: #6b7280; line-height: 1.55; margin-bottom: 1.25rem; }
.btn-favorito {
    width: 100%;
    padding: 10px;
    border-radius: 11px;
    border: none;
    background: #fef2f2;
    color: #ef4444;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s;
}
.btn-favorito:hover { background: #ef4444; color: #fff; }
.btn-favorito.guardado { background: #ef4444; color: #fff; }

@media (max-width: 600px) {
    .filtros-bar { flex-direction: column; }
    .filtro-group { min-width: 100%; }
    .btn-buscar { width: 100%; justify-content: center; }
}
</style>

<script>
const API = "/api/usuario/propiedades";
const FAV_API = "/api/usuario/favoritos";

let propiedadesCargadas: any[] = [];

async function buscar() {
    const ciudad = (document.getElementById("filtroCiudad") as HTMLInputElement).value.trim();
    const tipo = (document.getElementById("filtroTipo") as HTMLSelectElement).value;
    const habitaciones = (document.getElementById("filtroHabitaciones") as HTMLSelectElement).value;
    const precioMax = (document.getElementById("filtroPrecioMax") as HTMLInputElement).value;

    const params = new URLSearchParams();
    if (ciudad) params.set("ciudad", ciudad);
    if (tipo) params.set("tipoOperacionID", tipo);
    if (habitaciones) params.set("habitaciones", habitaciones);
    if (precioMax) params.set("precioMax", precioMax);

    document.getElementById("estadoCarga")!.style.display = "flex";
    document.getElementById("sinResultados")!.style.display = "none";
    document.getElementById("gridPropiedades")!.innerHTML = "";

    try {
        const res = await fetch(`${API}?${params.toString()}`, { credentials: "same-origin" });
        const data = await res.json();
        propiedadesCargadas = data.propiedades ?? [];
        renderPropiedades(propiedadesCargadas);
    } catch {
        propiedadesCargadas = [];
        renderPropiedades([]);
    } finally {
        document.getElementById("estadoCarga")!.style.display = "none";
    }
}

function formatPrecio(precio: string | number): string {
    const n = Number(precio);
    if (isNaN(n)) return String(precio);
    return new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);
}

function renderPropiedades(lista: any[]) {
    const grid = document.getElementById("gridPropiedades")!;
    if (!lista.length) {
        document.getElementById("sinResultados")!.style.display = "block";
        return;
    }
    grid.innerHTML = lista.map((p, i) => {
        const tipoClass = p.tipoOperacion?.toLowerCase().includes("arriendo") ? "tipo-arriendo" : "tipo-venta";
        const imgHtml = p.imagenes?.[0]
            ? `<img src="http://localhost:8001${p.imagenes[0]}" alt="" />`
            : `<i class="bi bi-house"></i>`;
        return `
        <div class="prop-card" data-idx="${i}">
            <div class="prop-card-img">${imgHtml}</div>
            <div class="prop-card-body">
                <span class="prop-card-tipo ${tipoClass}">${p.tipoOperacion ?? "Propiedad"}</span>
                <p class="prop-card-titulo">${p.titulo}</p>
                <p class="prop-card-ciudad"><i class="bi bi-geo-alt-fill"></i>${p.ciudad ?? "Sin ciudad"}</p>
                <div class="prop-card-footer">
                    <span class="prop-precio">${formatPrecio(p.precio)}</span>
                    ${p.habitaciones ? `<span class="prop-hab"><i class="bi bi-door-open-fill"></i>${p.habitaciones} hab.</span>` : ""}
                </div>
            </div>
        </div>`;
    }).join("");

    grid.querySelectorAll(".prop-card").forEach(card => {
        card.addEventListener("click", () => {
            const idx = Number((card as HTMLElement).dataset.idx);
            abrirModal(propiedadesCargadas[idx]);
        });
    });
}

function abrirModal(p: any) {
    const imgHtml = p.imagenes?.[0]
        ? `<div class="modal-prop-img"><img src="http://localhost:8001${p.imagenes[0]}" alt="" /></div>`
        : `<div class="modal-prop-img"><i class="bi bi-house"></i></div>`;

    document.getElementById("modalContenido")!.innerHTML = `
        ${imgHtml}
        <p class="modal-prop-titulo">${p.titulo}</p>
        <p class="modal-prop-precio">${formatPrecio(p.precio)}</p>
        <div class="modal-detalles">
            <div class="modal-detalle-item">
                <span class="modal-detalle-label">Ciudad</span>
                <span class="modal-detalle-valor">${p.ciudad ?? "—"}</span>
            </div>
            <div class="modal-detalle-item">
                <span class="modal-detalle-label">Tipo</span>
                <span class="modal-detalle-valor">${p.tipoOperacion ?? "—"}</span>
            </div>
            <div class="modal-detalle-item">
                <span class="modal-detalle-label">Habitaciones</span>
                <span class="modal-detalle-valor">${p.habitaciones ?? "—"}</span>
            </div>
            <div class="modal-detalle-item">
                <span class="modal-detalle-label">Estado</span>
                <span class="modal-detalle-valor">${p.estado ?? "—"}</span>
            </div>
            ${p.agenteNombre ? `<div class="modal-detalle-item">
                <span class="modal-detalle-label">Agente</span>
                <span class="modal-detalle-valor">${p.agenteNombre}</span>
            </div>` : ""}
            ${p.constructoraNombre ? `<div class="modal-detalle-item">
                <span class="modal-detalle-label">Constructora</span>
                <span class="modal-detalle-valor">${p.constructoraNombre}</span>
            </div>` : ""}
        </div>
        ${p.descripcion ? `<p class="modal-descripcion">${p.descripcion}</p>` : ""}
        <button class="btn-favorito" id="btnFavModal" data-id="${p.propiedadID}">
            <i class="bi bi-heart-fill"></i> Guardar en favoritos
        </button>
    `;

    document.getElementById("modalPropiedad")!.style.display = "flex";

    document.getElementById("btnFavModal")?.addEventListener("click", async () => {
        const btn = document.getElementById("btnFavModal") as HTMLButtonElement;
        btn.disabled = true;
        try {
            const res = await fetch(FAV_API, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                credentials: "same-origin",
                body: JSON.stringify({ propiedadID: p.propiedadID }),
            });
            const data = await res.json();
            if (res.ok) {
                btn.innerHTML = `<i class="bi bi-heart-fill"></i> Guardado en favoritos`;
                btn.classList.add("guardado");
            } else {
                btn.textContent = data.error ?? "Error al guardar";
            }
        } catch {
            btn.textContent = "Error al conectar";
        } finally {
            btn.disabled = false;
        }
    });
}

document.getElementById("btnCerrarModal")?.addEventListener("click", () => {
    document.getElementById("modalPropiedad")!.style.display = "none";
});
document.getElementById("modalPropiedad")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) {
        (e.currentTarget as HTMLElement).style.display = "none";
    }
});
document.getElementById("btnBuscar")?.addEventListener("click", buscar);
document.getElementById("btnLimpiar")?.addEventListener("click", () => {
    (document.getElementById("filtroCiudad") as HTMLInputElement).value = "";
    (document.getElementById("filtroTipo") as HTMLSelectElement).value = "";
    (document.getElementById("filtroHabitaciones") as HTMLSelectElement).value = "";
    (document.getElementById("filtroPrecioMax") as HTMLInputElement).value = "";
    buscar();
});

// Carga inicial
buscar();
</script>
