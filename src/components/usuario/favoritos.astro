<div class="panel-body">

    <div class="topbar-panel">
        <h1>Mis Propiedades Favoritas</h1>
        <p>Aquí puedes ver y gestionar tus favoritos.</p>
    </div>

    <div id="estadoCarga" class="estado-carga">
        <div class="spinner"></div>
        <span>Cargando favoritos...</span>
    </div>

    <p id="sinFavoritos" class="sin-favoritos" style="display:none;">
        Todavía no has guardado ninguna propiedad como favorita.
    </p>

    <section id="listaFavoritos" class="favoritos-grid"></section>

</div>

<style is:global>
* { box-sizing: border-box; }

.panel-body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    font-family: 'Inter', 'Segoe UI', sans-serif;
    background: #F8F6F0;
    min-height: 100%;
}

/* TOPBAR */
.topbar-panel { margin-bottom: 4px; }
.topbar-panel h1 {
    color: #14532d;
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 6px;
}
.topbar-panel p { color: #666; margin: 0; font-size: 15px; }

/* GRID — 3 columnas fijas, tarjetas grandes */
.favoritos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

/* CARD grande */
.fav-card {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
}
.fav-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.13);
}

/* Imagen más alta */
.fav-image {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: #e8f0ea;
}
.fav-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}
.fav-card:hover .fav-image img {
    transform: scale(1.06);
}
.fav-image .img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

/* Badge tipo propiedad */
.fav-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(20, 83, 45, 0.88);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 4px 12px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
}

/* Info */
.fav-info {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
}
.fav-info h4 {
    margin: 0;
    font-size: 1.15rem;
    color: #1a1a1a;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.fav-ciudad {
    margin: 0;
    color: #2e8b57;
    font-size: 0.88rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
}
.fav-precio {
    margin: 4px 0 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #14532d;
}
.fav-tipo {
    margin: 0;
    font-size: 0.8rem;
    color: #6b7280;
    font-weight: 500;
}

.btn-quitar {
    margin-top: 12px;
    align-self: flex-start;
    border: 1.5px solid #dc2626;
    background: transparent;
    color: #dc2626;
    padding: 8px 16px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.83rem;
    transition: background 0.2s, color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.btn-quitar:hover { background: #dc2626; color: white; }

/* ESTADOS */
.estado-carga {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 3rem;
    color: #6b7280;
    font-size: 0.9rem;
}
.spinner {
    width: 22px;
    height: 22px;
    border: 2.5px solid #e5e7eb;
    border-top-color: #22c55e;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.sin-favoritos {
    font-style: italic;
    color: #666;
    text-align: center;
    margin-top: 20px;
    background: white;
    padding: 40px;
    border-radius: 16px;
    box-shadow: 0 5px 15px rgba(0,0,0,.06);
}

/* RESPONSIVE */
@media (max-width: 1100px) {
    .favoritos-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 680px) {
    .favoritos-grid { grid-template-columns: 1fr; }
    .fav-image { height: 200px; }
}
</style>

<script>
const FAV_API = "/api/usuario/favoritos";
const BACKEND = "http://localhost:8001";

function formatPrecio(precio: string | number): string {
    const n = Number(precio);
    if (isNaN(n)) return String(precio);
    return new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);
}

function resolverImg(img: string | null | undefined): string | null {
    if (!img) return null;
    if (img.startsWith("http") || img.startsWith("data:")) return img;
    return `${BACKEND}${img.startsWith("/") ? img : "/" + img}`;
}

async function cargarFavoritos() {
    try {
        const res = await fetch(FAV_API, { credentials: "same-origin" });
        const data = await res.json();
        const lista = data.favoritos ?? data.data ?? [];
        renderFavoritos(lista);
    } catch {
        renderFavoritos([]);
    } finally {
        document.getElementById("estadoCarga")!.style.display = "none";
    }
}

function renderFavoritos(lista: any[]) {
    if (!lista.length) {
        document.getElementById("sinFavoritos")!.style.display = "block";
        return;
    }

    const contenedor = document.getElementById("listaFavoritos")!;
    contenedor.innerHTML = lista.map(f => {
        const p = f.propiedad ?? f;
        const imgSrc = resolverImg(p.imagen ?? p.imagenes?.[0] ?? p.imagenPrincipal ?? null);
        const imgHtml = imgSrc
            ? `<img src="${imgSrc}" alt="${p.titulo ?? ""}" loading="lazy" />`
            : `<div class="img-placeholder">🏠</div>`;

        const tipo = p.tipo ?? p.tipoPropiedad ?? null;
        const badgeHtml = tipo
            ? `<span class="fav-badge">${tipo}</span>`
            : "";

        return `
        <div class="fav-card">
            <div class="fav-image">
                ${imgHtml}
                ${badgeHtml}
            </div>
            <div class="fav-info">
                <h4>${p.titulo ?? "Sin título"}</h4>
                <p class="fav-ciudad">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    ${p.ciudad ?? p.direccion ?? "Sin ciudad"}
                </p>
                <p class="fav-precio">${formatPrecio(p.precio ?? 0)}</p>
                <button class="btn-quitar" data-prop="${p.propiedadID}">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                    Quitar de favoritos
                </button>
            </div>
        </div>`;
    }).join("");

    contenedor.querySelectorAll(".btn-quitar").forEach(btn => {
        btn.addEventListener("click", async () => {
            const propID = (btn as HTMLElement).dataset.prop;
            if (!propID) return;
            const res = await fetch(`${FAV_API}/${propID}`, { method: "DELETE", credentials: "same-origin" }).catch(() => null);
            if (res?.ok) {
                (btn as HTMLElement).closest(".fav-card")?.remove();
                if (!document.querySelectorAll(".fav-card").length) {
                    document.getElementById("sinFavoritos")!.style.display = "block";
                }
            }
        });
    });
}

cargarFavoritos();
</script>