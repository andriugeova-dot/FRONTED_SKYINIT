---
import { COOKIE_NAME, getTokenSSR } from "../../utils/auth";

const token = getTokenSSR(Astro.cookies);

let usuario = { nombre: "Usuario", correo: "", fotoPerfil: null as string | null, telefono: "" };
let totalFavoritos = 0;
let totalSolicitudes = 0;

if (token) {
    try {
        const headers = { Cookie: `${COOKIE_NAME}=${token}` };

        const [resPerfil, resFavs, resSols] = await Promise.allSettled([
            fetch("http://localhost:8001/auth/perfil",           { headers }),
            fetch("http://localhost:8001/api/usuario/favoritos", { headers }),
            fetch("http://localhost:8001/api/usuario/solicitudes",{ headers }),
        ]);

        if (resPerfil.status === "fulfilled" && resPerfil.value.ok) {
            const j = await resPerfil.value.json();
            const u = j.usuario ?? j;
            usuario = { nombre: u.nombre ?? "Usuario", correo: u.correo ?? "", fotoPerfil: u.fotoPerfil ?? null, telefono: u.telefono ?? "" };
        }
        if (resFavs.status === "fulfilled" && resFavs.value.ok) {
            const j = await resFavs.value.json();
            totalFavoritos = (j.favoritos ?? j.data ?? []).length;
        }
        if (resSols.status === "fulfilled" && resSols.value.ok) {
            const j = await resSols.value.json();
            totalSolicitudes = (j.solicitudes ?? j.data ?? []).length;
        }
    } catch { /* defaults */ }
}

function obtenerIniciales(nombre: string): string {
    const p = nombre.trim().split(/\s+/).filter(Boolean);
    if (!p.length) return "U";
    if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
    return (p[0][0] + p[1][0]).toUpperCase();
}

const fotoSrc = usuario.fotoPerfil
    ? (usuario.fotoPerfil.startsWith("http") ? usuario.fotoPerfil : `http://localhost:8001${usuario.fotoPerfil}`)
    : null;
---

<div class="panel-body">

    <!-- TOPBAR -->
    <div class="topbar-panel">
        <h1>Bienvenido, {usuario.nombre}</h1>
        <p>Gestiona tu cuenta y tus propiedades favoritas.</p>
    </div>

    <!-- ESTADÍSTICAS -->
    <section class="stats-grid">
        <div class="stat-card">
            <h2>{totalFavoritos}</h2>
            <p>Propiedades Favoritas</p>
        </div>
        <div class="stat-card">
            <h2>{totalSolicitudes}</h2>
            <p>Solicitudes Activas</p>
        </div>
    </section>

    <!-- ACCESOS RÁPIDOS -->
    <section class="card">
        <h2>Accesos rápidos</h2>
        <div class="accesos-grid">
            <a href="/usuario/propiedades" class="acceso-btn">🏠 Explorar propiedades</a>
            <a href="/usuario/favoritos"   class="acceso-btn">⭐ Mis Favoritos</a>
            <a href="/usuario/solicitudes" class="acceso-btn">🛠️ Mis Solicitudes</a>
            <a href="/usuario/perfil"      class="acceso-btn">👤 Mi Perfil</a>
        </div>
    </section>

    <!-- PERFIL -->
    <section class="card">
        <h2>Mi Perfil</h2>
        <div class="profile">
            <div class="profile-image">
                {fotoSrc
                    ? <img src={fotoSrc} alt={`Avatar de ${usuario.nombre}`} class="profile-pic-img" />
                    : <span class="profile-iniciales">{obtenerIniciales(usuario.nombre)}</span>
                }
            </div>
            <div class="profile-info">
                <p><strong>Nombre:</strong> {usuario.nombre}</p>
                <p><strong>Correo:</strong> {usuario.correo || "—"}</p>
                <p><strong>Teléfono:</strong> {usuario.telefono || "No registrado"}</p>
                <a href="/usuario/perfil" class="btn">✏️ Editar Perfil</a>
            </div>
        </div>
    </section>

</div>

<style>
* { box-sizing: border-box; }

.panel-body {
    display: flex;
    flex-direction: column;
    gap: 25px;
    font-family: 'Inter', 'Segoe UI', sans-serif;
    background: #F8F6F0;
    min-height: 100%;
}

/* TOPBAR */
.topbar-panel { margin-bottom: 5px; }
.topbar-panel h1 {
    color: #14532d;
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 6px;
}
.topbar-panel p { color: #666; margin: 0; font-size: 15px; }

/* STATS */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.stat-card {
    background: white;
    border-radius: 20px;
    padding: 25px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0,0,0,.08);
    transition: transform .25s;
}
.stat-card:hover { transform: translateY(-4px); }
.stat-card h2 {
    color: #14532d;
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1;
}
.stat-card p { color: #666; font-weight: 500; margin: 0; font-size: 15px; }

/* CARD GENÉRICA */
.card {
    background: white;
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 5px 15px rgba(0,0,0,.08);
}
.card h2 { color: #0F4C5C; margin: 0 0 20px; font-size: 20px; }

/* ACCESOS RÁPIDOS */
.accesos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
}
.acceso-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f1f8f4;
    border: 1.5px solid #c8e6c9;
    color: #14532d;
    text-decoration: none;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    transition: all .25s;
}
.acceso-btn:hover {
    background: #14532d;
    color: white;
    border-color: #14532d;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(20,83,45,.2);
}

/* PERFIL */
.profile {
    display: flex;
    align-items: center;
    gap: 25px;
    flex-wrap: wrap;
}

.profile-image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: #D9EEF2;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 50px;
    flex-shrink: 0;
    overflow: hidden;
    border: 3px solid #a7f3d0;
}
.profile-pic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}
.profile-iniciales {
    font-size: 2.5rem;
    font-weight: 700;
    color: #14532d;
}

.profile-info { flex: 1; }
.profile-info p { margin-bottom: 10px; color: #444; font-size: 15px; }
.profile-info p strong { color: #14532d; }

.btn {
    border: none;
    background: #2e8b57;
    color: white;
    padding: 10px 18px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    transition: .3s;
    text-decoration: none;
    display: inline-block;
    font-size: 14px;
}
.btn:hover { background: #14532d; color: white; }

/* RESPONSIVE */
@media (max-width: 900px) {
    .stats-grid { grid-template-columns: 1fr; }
    .profile { flex-direction: column; text-align: center; }
    .profile-info { text-align: center; }
}
</style>
