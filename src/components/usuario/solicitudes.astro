<div class="solicitudes-page">
    <div class="page-header">
        <div>
            <h1 class="page-titulo"><i class="bi bi-file-earmark-text-fill"></i> Mis Solicitudes</h1>
            <p class="page-desc">Solicitudes de mantenimiento e interacciones con propiedades.</p>
        </div>
        <a href="/servicios" class="btn-nueva-solicitud">
            <i class="bi bi-plus-circle-fill"></i> Nueva solicitud
        </a>
    </div>

    <div id="estadoCarga" class="estado-carga">
        <div class="spinner"></div>
        <span>Cargando solicitudes...</span>
    </div>

    <div id="sinSolicitudes" class="sin-resultados" style="display:none;">
        <i class="bi bi-file-earmark-x"></i>
        <p>No tienes solicitudes registradas aún.</p>
        <a href="/servicios" class="btn-ir-servicios">
            <i class="bi bi-tools"></i> Ver servicios disponibles
        </a>
    </div>

    <div id="listaSolicitudes" class="sol-grid"></div>
</div>

<style is:global>
.solicitudes-page { display: flex; flex-direction: column; gap: 1.75rem; }

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
}
.page-titulo {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.page-titulo i { color: #f59e0b; }
.page-desc { margin: 0; font-size: 0.85rem; color: #6b7280; }

.btn-nueva-solicitud {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a2e3b;
    color: #fff;
    text-decoration: none;
    padding: 9px 18px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.2s;
}
.btn-nueva-solicitud:hover { background: #0f4c6b; color: #fff; }

/* ── GRID 3 columnas ── */
.sol-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

/* ── TARJETA ── */
.sol-card {
    background: #fff;
    border-radius: 18px;
    border: 1.5px solid #e5e7eb;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
    position: relative;
}
.sol-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.09);
    transform: translateY(-4px);
}

/* Franja de color superior según estado */
.sol-card-top {
    height: 6px;
    width: 100%;
}
.sol-card-top.top-pendiente  { background: #fcd34d; }
.sol-card-top.top-en-proceso { background: #60a5fa; }
.sol-card-top.top-completado { background: #34d399; }
.sol-card-top.top-cancelado  { background: #f87171; }
.sol-card-top.top-default    { background: #d1d5db; }

.sol-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
}

/* Cabecera con icono y estado */
.sol-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

.sol-icono {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: #fffbeb;
    color: #f59e0b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
}

.sol-estado {
    display: inline-flex;
    padding: 4px 13px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
}
.estado-pendiente  { background: #fffbeb; color: #d97706; border: 1px solid #fcd34d; }
.estado-en-proceso { background: #eff6ff; color: #3b82f6; border: 1px solid #bfdbfe; }
.estado-completado { background: #ecfdf5; color: #10b981; border: 1px solid #a7f3d0; }
.estado-cancelado  { background: #fef2f2; color: #ef4444; border: 1px solid #fca5a5; }
.estado-default    { background: #f3f4f6; color: #6b7280; border: 1px solid #e5e7eb; }

/* Contenido */
.sol-servicio {
    font-size: 1rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0;
    line-height: 1.35;
}

.sol-inmobiliaria {
    font-size: 0.82rem;
    color: #6b7280;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 5px;
}
.sol-inmobiliaria i { color: #9ca3af; }

.sol-notas {
    font-size: 0.8rem;
    color: #9ca3af;
    margin: 0;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.45;
}

/* Pie */
.sol-card-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: 6px;
}
.sol-fecha {
    font-size: 0.75rem;
    color: #9ca3af;
    display: flex;
    align-items: center;
    gap: 4px;
}

/* ESTADOS DE CARGA */
.estado-carga {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 3rem;
    color: #6b7280;
    font-size: 0.9rem;
}
.spinner {
    width: 22px;
    height: 22px;
    border: 2.5px solid #e5e7eb;
    border-top-color: #f59e0b;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.sin-resultados {
    text-align: center;
    padding: 3rem;
    color: #6b7280;
    background: #fff;
    border-radius: 14px;
    border: 1.5px dashed #d1d5db;
}
.sin-resultados i { font-size: 3rem; color: #fcd34d; display: block; margin-bottom: 1rem; }
.sin-resultados p { margin: 0 0 1.25rem; }
.btn-ir-servicios {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a2e3b;
    color: #fff;
    text-decoration: none;
    padding: 9px 20px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background 0.2s;
}
.btn-ir-servicios:hover { background: #0f4c6b; color: #fff; }

/* RESPONSIVE */
@media (max-width: 1100px) {
    .sol-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
    .sol-grid { grid-template-columns: 1fr; }
}
</style>

<script>
const SOL_API = "/api/usuario/solicitudes";

function formatFecha(fecha: string): string {
    if (!fecha) return "";
    return new Date(fecha).toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric" });
}

function estadoClass(estado: string): string {
    const e = (estado ?? "").toLowerCase();
    if (e.includes("pendiente"))   return "estado-pendiente";
    if (e.includes("proceso") || e.includes("progreso")) return "estado-en-proceso";
    if (e.includes("complet") || e.includes("finaliz"))  return "estado-completado";
    if (e.includes("cancel"))      return "estado-cancelado";
    return "estado-default";
}

function topClass(estado: string): string {
    return estadoClass(estado).replace("estado-", "top-");
}

async function cargarSolicitudes() {
    try {
        const res = await fetch(SOL_API, { credentials: "same-origin" });
        const data = await res.json();
        const lista = data.solicitudes ?? [];
        renderSolicitudes(lista);
    } catch {
        renderSolicitudes([]);
    } finally {
        document.getElementById("estadoCarga")!.style.display = "none";
    }
}

function renderSolicitudes(lista: any[]) {
    if (!lista.length) {
        document.getElementById("sinSolicitudes")!.style.display = "block";
        return;
    }
    const contenedor = document.getElementById("listaSolicitudes")!;
    contenedor.innerHTML = lista.map(s => {
        const estado = s.estadoReparacion ?? s.estado ?? "Pendiente";
        const fecha = formatFecha(s.fechaSolicitud ?? "");
        return `
        <div class="sol-card">
            <div class="sol-card-top ${topClass(estado)}"></div>
            <div class="sol-card-body">
                <div class="sol-card-head">
                    <div class="sol-icono"><i class="bi bi-tools"></i></div>
                    <span class="sol-estado ${estadoClass(estado)}">${estado}</span>
                </div>

                <p class="sol-servicio">${s.nombreServicio ?? s.servicio ?? "Servicio de mantenimiento"}</p>

                <p class="sol-inmobiliaria">
                    <i class="bi bi-building"></i>
                    ${s.inmobiliaria ?? s.nombreInmobiliaria ?? "Inmobiliaria"}
                </p>

                ${s.notas ? `<p class="sol-notas">"${s.notas}"</p>` : ""}

                ${fecha ? `
                <div class="sol-card-footer">
                    <span class="sol-fecha">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="color:#9ca3af"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                        ${fecha}
                    </span>
                </div>` : ""}
            </div>
        </div>`;
    }).join("");
}

cargarSolicitudes();
</script>