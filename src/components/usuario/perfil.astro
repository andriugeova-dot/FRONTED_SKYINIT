---
import { COOKIE_NAME, getTokenSSR } from "../../utils/auth";

const token = getTokenSSR(Astro.cookies);

let usuario = {
    nombre: "",
    correo: "",
    telefono: "",
    fotoPerfil: null as string | null,
    fechaRegistro: "",
};

if (token) {
    try {
        const res = await fetch("http://localhost:8001/auth/perfil", {
            headers: { Cookie: `${COOKIE_NAME}=${token}` },
        });
        if (res.ok) {
            const json = await res.json();
            const u = json.usuario ?? json;
            usuario = {
                nombre: u.nombre ?? "",
                correo: u.correo ?? "",
                telefono: u.telefono ?? "",
                fotoPerfil: u.fotoPerfil ?? null,
                fechaRegistro: u.fechaRegistro ?? "",
            };
        }
    } catch { /* defaults */ }
}

function obtenerIniciales(nombre: string): string {
    const p = nombre.trim().split(/\s+/).filter(Boolean);
    if (!p.length) return "U";
    if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
    return (p[0][0] + p[1][0]).toUpperCase();
}

const fotoSrc = usuario.fotoPerfil
    ? `http://localhost:8001${usuario.fotoPerfil}`
    : null;

const fechaFormateada = usuario.fechaRegistro
    ? new Date(usuario.fechaRegistro).toLocaleDateString("es-CO", {
        day: "numeric", month: "long", year: "numeric",
      })
    : "";
---

<div class="perfil-page">
    <div class="page-header">
        <h1 class="page-titulo"><i class="bi bi-person-circle"></i> Mi Perfil</h1>
        <p class="page-desc">Gestiona tu información personal y configuración de cuenta.</p>
    </div>

    <div class="perfil-layout">
        <!-- TARJETA AVATAR -->
        <div class="avatar-card">
            <div class="avatar-grande" id="avatarPreview">
                {fotoSrc
                    ? <img src={fotoSrc} alt="" id="avatarImg" />
                    : <span id="avatarIniciales">{obtenerIniciales(usuario.nombre)}</span>
                }
            </div>
            <h2 class="avatar-nombre">{usuario.nombre || "Usuario"}</h2>
            <span class="avatar-rol">
                <i class="bi bi-shield-fill-check"></i> Usuario
            </span>
            {fechaFormateada && (
                <p class="avatar-fecha">Miembro desde {fechaFormateada}</p>
            )}
        </div>

        <!-- FORMULARIO DE EDICIÓN -->
        <div class="form-card">
            <h3 class="form-titulo">Información personal</h3>

            <div id="alertaPerfil" class="alerta" style="display:none;"></div>

            <form id="formPerfil" class="form-perfil">
                <div class="campo-grupo">
                    <label for="perfilNombre">Nombre completo</label>
                    <input
                        id="perfilNombre"
                        type="text"
                        class="campo-input"
                        value={usuario.nombre}
                        placeholder="Tu nombre completo"
                        required
                    />
                </div>

                <div class="campo-grupo">
                    <label for="perfilCorreo">Correo electrónico</label>
                    <input
                        id="perfilCorreo"
                        type="email"
                        class="campo-input campo-deshabilitado"
                        value={usuario.correo}
                        disabled
                        title="El correo no se puede modificar"
                    />
                    <span class="campo-hint"><i class="bi bi-lock-fill"></i> El correo no puede modificarse.</span>
                </div>

                <div class="campo-grupo">
                    <label for="perfilTelefono">Teléfono</label>
                    <input
                        id="perfilTelefono"
                        type="tel"
                        class="campo-input"
                        value={usuario.telefono}
                        placeholder="Ej: 3001234567"
                    />
                </div>

                <div class="form-divider"></div>
                <h3 class="form-titulo">Cambiar contraseña</h3>
                <p class="form-subtitulo">Deja en blanco si no deseas cambiar tu contraseña.</p>

                <div class="campo-grupo">
                    <label for="perfilPasswordActual">Contraseña actual</label>
                    <div class="campo-password">
                        <input id="perfilPasswordActual" type="password" class="campo-input" placeholder="••••••••" />
                        <button type="button" class="btn-ver" data-target="perfilPasswordActual">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="campo-grupo">
                    <label for="perfilPasswordNuevo">Nueva contraseña</label>
                    <div class="campo-password">
                        <input id="perfilPasswordNuevo" type="password" class="campo-input" placeholder="Mín. 8 chars, mayúsc., núm., símbolo" />
                        <button type="button" class="btn-ver" data-target="perfilPasswordNuevo">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="campo-grupo">
                    <label for="perfilPasswordConfirmar">Confirmar nueva contraseña</label>
                    <div class="campo-password">
                        <input id="perfilPasswordConfirmar" type="password" class="campo-input" placeholder="Repite la nueva contraseña" />
                        <button type="button" class="btn-ver" data-target="perfilPasswordConfirmar">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-acciones">
                    <button type="submit" id="btnGuardar" class="btn-guardar">
                        <i class="bi bi-floppy-fill"></i> Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.perfil-page { display: flex; flex-direction: column; gap: 1.5rem; }

.page-titulo {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.page-titulo i { color: #10b981; }
.page-desc { margin: 0; font-size: 0.85rem; color: #6b7280; }

/* Layout */
.perfil-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.5rem;
    align-items: start;
}

/* Avatar card */
.avatar-card {
    background: #fff;
    border: 1.5px solid #e5e7eb;
    border-radius: 16px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
}

.avatar-grande {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a2e3b, #0f4c6b);
    border: 3px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
    color: #fff;
    overflow: hidden;
    flex-shrink: 0;
}
.avatar-grande img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}
.avatar-nombre { font-size: 1rem; font-weight: 700; color: #1f2937; margin: 0; }
.avatar-rol {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #ecfdf5;
    color: #10b981;
    border: 1px solid #a7f3d0;
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}
.avatar-fecha { font-size: 0.75rem; color: #9ca3af; margin: 0; }

/* Form card */
.form-card {
    background: #fff;
    border: 1.5px solid #e5e7eb;
    border-radius: 16px;
    padding: 2rem;
}
.form-titulo {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 1.25rem;
}
.form-subtitulo { font-size: 0.8rem; color: #9ca3af; margin: -0.75rem 0 1rem; }
.form-divider {
    border: none;
    border-top: 1.5px solid #f3f4f6;
    margin: 1.75rem 0 1.5rem;
}

.form-perfil { display: flex; flex-direction: column; gap: 1.1rem; }

.campo-grupo { display: flex; flex-direction: column; gap: 5px; }
.campo-grupo label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}
.campo-input {
    height: 42px;
    padding: 0 14px;
    border: 1.5px solid #d1d5db;
    border-radius: 10px;
    font-size: 0.88rem;
    color: #1f2937;
    background: #f9fafb;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    width: 100%;
    box-sizing: border-box;
}
.campo-input:focus { border-color: #10b981; background: #fff; }
.campo-deshabilitado { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
.campo-hint {
    font-size: 0.73rem;
    color: #9ca3af;
    display: flex;
    align-items: center;
    gap: 4px;
}

.campo-password { position: relative; }
.campo-password .campo-input { padding-right: 42px; }
.btn-ver {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    color: #9ca3af;
    font-size: 0.9rem;
    padding: 0;
    line-height: 1;
    transition: color 0.2s;
}
.btn-ver:hover { color: #6b7280; }

/* Alerta */
.alerta {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
}
.alerta-ok    { background: #ecfdf5; color: #10b981; border: 1px solid #a7f3d0; }
.alerta-error { background: #fef2f2; color: #ef4444; border: 1px solid #fca5a5; }

/* Acciones */
.form-acciones { display: flex; justify-content: flex-end; margin-top: 0.5rem; }
.btn-guardar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a2e3b;
    color: #fff;
    border: none;
    padding: 11px 24px;
    border-radius: 11px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}
.btn-guardar:hover { background: #0f4c6b; }
.btn-guardar:disabled { opacity: 0.6; cursor: not-allowed; }

@media (max-width: 768px) {
    .perfil-layout { grid-template-columns: 1fr; }
    .avatar-card { flex-direction: row; text-align: left; flex-wrap: wrap; }
}
</style>

<script>
// Toggle ver contraseña
document.querySelectorAll(".btn-ver").forEach(btn => {
    btn.addEventListener("click", () => {
        const targetId = (btn as HTMLElement).dataset.target!;
        const input = document.getElementById(targetId) as HTMLInputElement;
        const icon = btn.querySelector("i")!;
        if (input.type === "password") {
            input.type = "text";
            icon.className = "bi bi-eye-slash";
        } else {
            input.type = "password";
            icon.className = "bi bi-eye";
        }
    });
});

// Guardar perfil
document.getElementById("formPerfil")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const alerta = document.getElementById("alertaPerfil")!;
    const btn = document.getElementById("btnGuardar") as HTMLButtonElement;

    const nombre = (document.getElementById("perfilNombre") as HTMLInputElement).value.trim();
    const telefono = (document.getElementById("perfilTelefono") as HTMLInputElement).value.trim();
    const passwordActual = (document.getElementById("perfilPasswordActual") as HTMLInputElement).value;
    const passwordNuevo = (document.getElementById("perfilPasswordNuevo") as HTMLInputElement).value;
    const passwordConfirmar = (document.getElementById("perfilPasswordConfirmar") as HTMLInputElement).value;

    if (!nombre) {
        mostrarAlerta("El nombre es obligatorio.", "error");
        return;
    }

    if (passwordNuevo && passwordNuevo !== passwordConfirmar) {
        mostrarAlerta("Las contraseñas nuevas no coinciden.", "error");
        return;
    }

    if (passwordNuevo && !passwordActual) {
        mostrarAlerta("Debes ingresar tu contraseña actual para cambiarla.", "error");
        return;
    }

    const body: Record<string, string> = { Nombre: nombre };
    if (telefono) body.Telefono = telefono;
    if (passwordActual && passwordNuevo) {
        body.PasswordActual = passwordActual;
        body.PasswordNuevo = passwordNuevo;
    }

    btn.disabled = true;
    btn.innerHTML = `<i class="bi bi-hourglass-split"></i> Guardando...`;

    try {
        const res = await fetch("/api/usuario/perfil", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify(body),
        });
        const data = await res.json();
        if (res.ok) {
            mostrarAlerta("Perfil actualizado correctamente.", "ok");
            // Actualizar nombre en UI
            document.querySelector(".avatar-nombre")!.textContent = nombre;
        } else {
            mostrarAlerta(data.error ?? "Error al guardar.", "error");
        }
    } catch {
        mostrarAlerta("Error al conectar con el servidor.", "error");
    } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="bi bi-floppy-fill"></i> Guardar cambios`;
    }
});

function mostrarAlerta(msg: string, tipo: "ok" | "error") {
    const alerta = document.getElementById("alertaPerfil")!;
    alerta.textContent = msg;
    alerta.className = `alerta alerta-${tipo}`;
    alerta.style.display = "block";
    setTimeout(() => { alerta.style.display = "none"; }, 5000);
}
</script>
