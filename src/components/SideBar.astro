---
import {
    getTokenSSR,
    obtenerRolDesdeToken,
    COOKIE_NAME,
} from "../utils/auth";
import "./SideBar.css";

const token = getTokenSSR(Astro.cookies);
const rol = obtenerRolDesdeToken(token) ?? "Usuario";
const rutaActual = Astro.url.pathname;

// ---------- helpers ----------
function obtenerIniciales(nombre: string): string {
    const p = nombre.trim().split(/\s+/).filter(Boolean);
    if (p.length === 0) return "??";
    if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
    return (p[0][0] + p[1][0]).toUpperCase();
}

function urlImagen(path: string | null | undefined): string | null {
    if (!path) return null;
    if (path.startsWith("http")) return path;
    return `http://localhost:8001${path.startsWith("/") ? path : "/" + path}`;
}

function estaActivo(ruta: string): boolean {
    if (rutaActual === ruta) return true;
    const segmentos = ruta.split("/").filter(Boolean).length;
    if (segmentos === 1) return false;
    return rutaActual.startsWith(ruta + "/");
}

// ---------- datos de usuario / empresa ----------
let nombreMostrar = rol;
let subtitulo = "Panel";
let foto: string | null = null;
let iniciales = "??";

async function cargarPerfil() {
    if (!token) return;
    const headers = { Cookie: `${COOKIE_NAME}=${token}` };

    // Perfil genérico (nombre + foto de usuario)
    try {
        const res = await fetch("http://localhost:8001/auth/perfil", { headers });
        if (res.ok) {
            const json = await res.json();
            const u = json.usuario ?? json.data ?? json;
            if (u?.nombre) {
                nombreMostrar = u.nombre;
                iniciales = obtenerIniciales(u.nombre);
            }
            foto = urlImagen(u?.fotoPerfil ?? u?.FotoPerfil);
            subtitulo = rol;
        }
    } catch {
        /* defaults */
    }

    // Constructora: nombre y logo de la empresa
    if (rol === "Constructora") {
        try {
            const res = await fetch(
                "http://localhost:8001/panel/constructora/perfil",
                { headers },
            );
            if (res.ok) {
                const json = await res.json();
                const c = json.data ?? json;
                if (c?.nombre) {
                    nombreMostrar = c.nombre;
                    iniciales = obtenerIniciales(c.nombre);
                }
                if (c?.logo) foto = urlImagen(c.logo);
                subtitulo = c?.ciudad ? c.ciudad : "Constructora";
            }
        } catch {
            /* defaults */
        }
    }
}

await cargarPerfil();

// ---------- menú por rol ----------
const configuraciones: Record<
    string,
    {
        nombre: string;
        descripcion: string;
        iniciales: string;
        clase: string;
        rutas: {
            dashboard: string;
            propiedades: string;
            favoritos?: string;
            solicitudes?: string;
            proyectos?: string;
            perfil: string;
        };
        items: {
            href: string;
            icon: string;
            label: string;
        }[];
    }
> = {
    // ── USUARIO ──────────────────────────────────────
    Usuario: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "usuario",
        rutas: {
            dashboard:    "/usuario",
            propiedades:  "/usuario/propiedades",
            favoritos:    "/usuario/favoritos",
            solicitudes:  "/usuario/solicitudes",
            perfil:       "/usuario/perfil",
        },
        items: [
            { href: "/usuario",               icon: "bi-grid-1x2-fill",         label: "Inicio" },
            { href: "/usuario/propiedades",   icon: "bi-house-door-fill",       label: "Propiedades" },
            { href: "/usuario/favoritos",     icon: "bi-heart-fill",            label: "Favoritos" },
            { href: "/usuario/solicitudes",   icon: "bi-file-earmark-text-fill",label: "Solicitudes" },
            { href: "/usuario/perfil",        icon: "bi-person-fill",           label: "Mi Perfil" },
            { href: "/",                      icon: "bi-arrow-left-circle-fill", label: "Volver al menú" },
        ],
    },
    // ── CONSTRUCTORA ─────────────────────────────────
    Constructora: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "constructora",
        rutas: {
            dashboard:   "/constructora",
            propiedades: "/constructora/propiedades",
            proyectos:   "/constructora/proyectos",
            perfil:      "/constructora/perfil",
        },
        items: [
            { href: "/constructora",             icon: "bi-grid-1x2-fill",   label: "Dashboard" },
            { href: "/constructora/proyectos",   icon: "bi-buildings-fill",  label: "Proyectos" },
            { href: "/constructora/propiedades", icon: "bi-house-fill",      label: "Propiedades" },
            { href: "/constructora/perfil",      icon: "bi-person-fill",     label: "Perfil" },
        ],
    },
    // ── ADMINISTRADOR ────────────────────────────────
    Administrador: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "administrador",
        rutas: {
            dashboard:   "/admin",
            propiedades: "/admin/propiedades",
            proyectos:   "/admin/proyectos",
            perfil:      "/admin/perfil",
        },
        items: [
            { href: "/admin",              icon: "bi-grid-1x2-fill",  label: "Dashboard" },
            { href: "/admin/proyectos",    icon: "bi-buildings-fill", label: "Proyectos" },
            { href: "/admin/propiedades",  icon: "bi-house-fill",     label: "Propiedades" },
            { href: "/admin/perfil",       icon: "bi-person-fill",    label: "Perfil" },
        ],
    },
    // ── SUPERADMIN ───────────────────────────────────
    SuperAdmin: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "superadmin",
        rutas: {
            dashboard:   "/superadmin",
            propiedades: "/superadmin/propiedades",
            proyectos:   "/superadmin/proyectos",
            perfil:      "/superadmin/perfil",
        },
        items: [
            { href: "/superadmin",             icon: "bi-grid-1x2-fill",  label: "Dashboard" },
            { href: "/superadmin/proyectos",   icon: "bi-buildings-fill", label: "Proyectos" },
            { href: "/superadmin/propiedades", icon: "bi-house-fill",     label: "Propiedades" },
            { href: "/superadmin/perfil",      icon: "bi-person-fill",    label: "Perfil" },
        ],
    },
    // ── AGENTE ──────────────────────────────────────
    Agente: {
        nombre: nombreMostrar,
        descripcion: subtitulo,
        iniciales,
        clase: "agente",
        rutas: {
            dashboard:   "/agente",
            propiedades: "/agente/propiedades",
            proyectos:   "/agente/proyectos",
            perfil:      "/agente/perfil",
        },
        items: [
            { href: "/agente",             icon: "bi-grid-1x2-fill",  label: "Dashboard" },
            { href: "/agente/proyectos",   icon: "bi-buildings-fill", label: "Proyectos" },
            { href: "/agente/propiedades", icon: "bi-house-fill",     label: "Propiedades" },
            { href: "/agente/perfil",      icon: "bi-person-fill",    label: "Perfil" },
        ],
    },
};

const cfg = configuraciones[rol] ?? configuraciones["Constructora"];
---

<aside class={`sidebar ${cfg.clase}`}>
    <!-- LOGO -->
    <div class="logo">
        <div class="logo-marca">
            <span>SI</span>
        </div>
        <div class="logo-nombre">
            <span>SKYINIT</span>
            <strong>Inmobiliaria</strong>
        </div>
    </div>

    <!-- NAV -->
    <nav class="navegacion">
        {cfg.items.map(item => (
            <a
                href={item.href}
                class:list={{
                    "nav-item": true,
                    activo: estaActivo(item.href),
                }}
            >
                <i class={`bi ${item.icon}`}></i>
                <span>{item.label}</span>
            </a>
        ))}
    </nav>

    <!-- USUARIO + LOGOUT -->
    <div class="sidebar-footer">
        <div class="usuario">
            <div class="avatar">
                {
                    foto ? (
                        <img src={foto} alt="" class="avatar-img" />
                    ) : (
                        <span>{cfg.iniciales}</span>
                    )
                }
            </div>
            <div class="usuario-info">
                <strong title={cfg.nombre}>{cfg.nombre}</strong>
                <span title={cfg.descripcion}>{cfg.descripcion}</span>
            </div>
        </div>

        <button type="button" class="btn-logout" id="btnLogout" title="Cerrar sesión">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar sesión</span>
        </button>
    </div>
</aside>

<script>
document.getElementById("btnLogout")?.addEventListener("click", async () => {
    try {
        await fetch("/api/logout", {
            method: "POST",
            credentials: "same-origin",
        });
    } catch {
        /* igual redirigimos */
    }
    window.location.href = "/login";
});
</script>
