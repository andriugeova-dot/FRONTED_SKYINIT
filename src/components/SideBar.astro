---
import {
    getTokenSSR,
    obtenerRolDesdeToken
} from "../utils/auth";

import "./SideBar.css"

const token = getTokenSSR(Astro.cookies);
const rol = obtenerRolDesdeToken(token);

const rutaActual = Astro.url.pathname;

// Configuración según el rol
const configuraciones = {
    Constructora: {
        nombre: "Constructora",
        descripcion: "Panel de constructora",
        iniciales: "CO",
        clase: "constructora",
        rutas: {
            dashboard: "./Constructora/dashboard.astro",
            proyectos: "./Constructora/propiedades.astro",
            propiedades: "./Constructora/proyectos.astro",
            perfil: "./Constructora/perfil.astro"
        }
    },

    Administrador: {
        nombre: "Administrador",
        descripcion: "Panel administrativo",
        iniciales: "AD",
        clase: "administrador",
        rutas: {
            dashboard: "/admin",
            proyectos: "/admin/proyectos",
            propiedades: "/admin/propiedades",
            perfil: "/perfil"
        }
    },

    SuperAdmin: {
        nombre: "Super Admin",
        descripcion: "Administración general",
        iniciales: "SA",
        clase: "superadmin",
        rutas: {
            dashboard: "/superadmin",
            proyectos: "/superadmin/proyectos",
            propiedades: "/superadmin/propiedades",
            perfil: "/perfil"
        }
    },

    Agente: {
        nombre: "Agente inmobiliario",
        descripcion: "Panel inmobiliario",
        iniciales: "AG",
        clase: "agente",
        rutas: {
            dashboard: "/agente",
            proyectos: "/agente/proyectos",
            propiedades: "/agente/propiedades",
            perfil: "/perfil"
        }
    }
};

// Si no encuentra el rol, usa Constructora como respaldo
const configuracion =
    configuraciones[rol as keyof typeof configuraciones] ??
    configuraciones.Constructora;


// Función para saber si una ruta está activa
function estaActivo(ruta: string): boolean {
    return (
        rutaActual === ruta ||
        rutaActual.startsWith(`${ruta}/`)
    );
}
---

<aside class={`sidebar ${configuracion.clase}`}>

    <!-- LOGO -->
    <div class="logo">

        <div class="logo-marca">
            <span>RV</span>
        </div>

        <div class="logo-nombre">
            <span>RESIDENCIAL</span>
            <strong>LA VISTA</strong>
        </div>

    </div>


    <!-- NAVEGACIÓN -->
    <nav class="navegacion">

        <a
            href={configuracion.rutas.dashboard}
            class:list={{
                "nav-item": true,
                activo: estaActivo(configuracion.rutas.dashboard)
            }}
        >
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Dashboard</span>
        </a>


        <a
            href={configuracion.rutas.proyectos}
            class:list={{
                "nav-item": true,
                activo: estaActivo(configuracion.rutas.proyectos)
            }}
        >
            <i class="bi bi-buildings-fill"></i>
            <span>Proyectos</span>
        </a>


        <a
            href={configuracion.rutas.propiedades}
            class:list={{
                "nav-item": true,
                activo: estaActivo(configuracion.rutas.propiedades)
            }}
        >
            <i class="bi bi-house-fill"></i>
            <span>Propiedades</span>
        </a>


        <a
            href={configuracion.rutas.perfil}
            class:list={{
                "nav-item": true,
                activo: estaActivo(configuracion.rutas.perfil)
            }}
        >
            <i class="bi bi-person-fill"></i>
            <span>Perfil</span>
        </a>

    </nav>


    <!-- INFORMACIÓN DEL USUARIO / ROL -->
    <div class="usuario">

        <div class="avatar">
            {configuracion.iniciales}
        </div>

        <div class="usuario-info">

            <strong>
                {configuracion.nombre}
            </strong>

            <span>
                {configuracion.descripcion}
            </span>

        </div>

        <i class="bi bi-chevron-down flecha"></i>

    </div>

</aside>