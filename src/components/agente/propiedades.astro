---
import PanelAgente from "./PanelAgente.astro";
import "./propiedades.css";
---

<PanelAgente
  titulo="Mis propiedades"
  subtitulo="Propiedades que tu inmobiliaria asignó a tu cuenta."
  stats={[
    { id: "statTotal", titulo: "Total", valor: 0 },
    { id: "statDisponibles", titulo: "Disponibles", valor: 0, variante: "ok" },
    { id: "statOtras", titulo: "Otras", valor: 0, variante: "warn" },
  ]}
>
  <section class="filtros" aria-label="Filtros" slot="filtros">
    <div class="filtro-busqueda">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input
        type="search"
        id="inputBuscar"
        placeholder="Buscar por título, ciudad o dirección..."
      />
    </div>
    <select id="selectEstado" aria-label="Filtrar por estado">
      <option value="">Todos los estados</option>
      <option value="Disponible">Disponible</option>
      <option value="Reservada">Reservada</option>
      <option value="En mantenimiento">En mantenimiento</option>
      <option value="Fuera del mercado">Fuera del mercado</option>
    </select>
  </section>

  <p class="contador" id="contador" aria-live="polite" hidden></p>

  <div id="loadingState" class="estado-vacio">
    <i class="bi bi-hourglass-split" aria-hidden="true"></i>
    <h3>Cargando...</h3>
    <p>Estamos trayendo tus propiedades.</p>
  </div>

  <div id="errorState" class="alert-error" role="alert" hidden></div>

  <div id="emptyState" class="estado-vacio" hidden>
    <i class="bi bi-house-add" aria-hidden="true"></i>
    <h3>No hay propiedades</h3>
    <p>Publica la primera con “Nueva propiedad”.</p>
  </div>

  <div id="sinResultados" class="estado-vacio" hidden>
    <i class="bi bi-search" aria-hidden="true"></i>
    <h3>Sin resultados</h3>
    <p>Prueba con otra búsqueda o cambia el filtro.</p>
  </div>

  <div id="gridProps" class="prop-grid" hidden></div>
</PanelAgente>

<!-- Modal crear / editar -->
<div id="modalPropiedad" class="sky-modal" hidden>
  <div class="sky-modal-backdrop" data-cerrar="propiedad"></div>
  <div
    class="sky-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalPropiedadTitulo"
  >
    <h3 id="modalPropiedadTitulo">Nueva propiedad</h3>
    <div id="modalAlert" class="alert-error" role="alert" hidden></div>
    <form id="formPropiedad" class="form-grid" novalidate>
      <input type="hidden" id="campoId" value="" />

      <div class="full">
        <label for="campoTitulo">Título *</label>
        <input type="text" id="campoTitulo" required maxlength="150" />
      </div>

      <div class="full">
        <label for="campoDesc">Descripción</label>
        <textarea id="campoDesc" rows="3"></textarea>
      </div>

      <div>
        <label for="campoHab">Habitaciones</label>
        <input type="number" id="campoHab" min="0" step="1" />
      </div>


      <div>
        <label for="campoEstado">Estado</label>
        <select id="campoEstado">
          <option value="Disponible">Disponible</option>
          <option value="Reservada">Reservada</option>
          <option value="En mantenimiento">En mantenimiento</option>
          <option value="Fuera del mercado">Fuera del mercado</option>
        </select>
      </div>
      
      <p class="form text full">
        El precio, la ubicacion y el tipo de operacion los gestiona tu inmobiliaria.
      </p>
    </form>
    <div class="modal-actions">
      <button type="button" class="btn-outline" data-cerrar="propiedad"
        >Cancelar</button
      >
      <button type="button" class="btn-primary" id="btnGuardarProp"
        >Guardar</button
      >
    </div>
  </div>
</div>

<!-- Modal fotos -->
<div id="modalFotos" class="sky-modal" hidden>
  <div class="sky-modal-backdrop" data-cerrar="fotos"></div>
  <div
    class="sky-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalFotosTitulo"
  >
    <h3 id="modalFotosTitulo">Fotos de la propiedad</h3>
    <div id="fotosAlert" class="alert-error" role="alert" hidden></div>
    <div id="galeriaFotos" class="galeria" aria-live="polite"></div>
    <label for="inputFoto">Agregar imágenes</label>
    <input
      type="file"
      id="inputFoto"
      accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
      multiple
    />
    <p class="form-text">
      JPG, PNG o WEBP. Máximo 5 MB por archivo. Puedes elegir varias.
    </p>
    <div class="modal-actions">
      <button type="button" class="btn-outline" data-cerrar="fotos"
        >Cerrar</button
      >
      <button type="button" class="btn-primary" id="btnSubirFoto">Subir</button>
    </div>
  </div>
</div>

<script>
  interface PropiedadAgente {
    propiedadID: number;
    titulo: string;
    precio: string | number;
    ciudad: string | null;
    estado: string;
    tipoOperacion: string;
    tipoOperacionID?: number;
    habitaciones: number | null;
    direccion: string;
    descripcion: string | null;
    imagenPrincipal?: string | null;
  }

  interface ImagenPropiedad {
    imagenID: number;
    url: string;
  }

  const API = "/api/agente/propiedades";
  const BACKEND_PUBLIC = "http://localhost:8001";
  const MAX_FOTO_BYTES = 5 * 1024 * 1024;
  const TIPOS_IMAGEN = new Set([
    "image/jpeg",
    "image/jpg",
    "image/png",
    "image/webp",
  ]);

  function get<T extends HTMLElement>(id: string): T {
    const node = document.getElementById(id);
    if (!node) throw new Error(`Falta el elemento #${id}`);
    return node as T;
  }

  const grid = get<HTMLElement>("gridProps");
  const loadingState = get<HTMLElement>("loadingState");
  const errorState = get<HTMLElement>("errorState");
  const emptyState = get<HTMLElement>("emptyState");
  const sinResultados = get<HTMLElement>("sinResultados");
  const contador = get<HTMLElement>("contador");
  const inputBuscar = get<HTMLInputElement>("inputBuscar");
  const selectEstado = get<HTMLSelectElement>("selectEstado");
  const statTotal = get<HTMLElement>("statTotal");
  const statDisponibles = get<HTMLElement>("statDisponibles");
  const statOtras = get<HTMLElement>("statOtras");

  const form = get<HTMLFormElement>("formPropiedad");
  const modalAlert = get<HTMLElement>("modalAlert");
  const modalTitulo = get<HTMLElement>("modalPropiedadTitulo");
  const galeriaFotos = get<HTMLElement>("galeriaFotos");
  const fotosAlert = get<HTMLElement>("fotosAlert");
  const modalFotosTitulo = get<HTMLElement>("modalFotosTitulo");
  const inputFoto = get<HTMLInputElement>("inputFoto");
  const btnSubirFoto = get<HTMLButtonElement>("btnSubirFoto");

  const campo = {
    id: get<HTMLInputElement>("campoId"),
    titulo: get<HTMLInputElement>("campoTitulo"),
    desc: get<HTMLTextAreaElement>("campoDesc"),
    hab: get<HTMLInputElement>("campoHab"),
    estado: get<HTMLSelectElement>("campoEstado"),
  };

  let listado: PropiedadAgente[] = [];
  let propiedadFotosId: number | null = null;
  let fotosCambiaron = false;
  let subiendoFoto = false;

  // ---------- Modales (apertura, cierre, foco, Escape) — igual que el panel de inmobiliaria ----------
  const modales = {
    propiedad: get<HTMLElement>("modalPropiedad"),
    fotos: get<HTMLElement>("modalFotos"),
  };
  type NombreModal = keyof typeof modales;

  const pilaModales: NombreModal[] = [];
  const focoPrevio = new Map<NombreModal, HTMLElement | null>();

  function mostrarError(node: HTMLElement, msg: string | null) {
    node.hidden = !msg;
    node.textContent = msg ?? "";
  }

  function abrir(nombre: NombreModal) {
    const modal = modales[nombre];
    focoPrevio.set(nombre, document.activeElement as HTMLElement | null);
    modal.hidden = false;
    pilaModales.push(nombre);
    const primero = modal.querySelector<HTMLElement>(
      "input:not([type=hidden]), textarea, select, button.btn-primary, button",
    );
    primero?.focus();
  }

  function cerrar(nombre: NombreModal) {
    modales[nombre].hidden = true;
    const i = pilaModales.lastIndexOf(nombre);
    if (i >= 0) pilaModales.splice(i, 1);
    focoPrevio.get(nombre)?.focus?.();
    focoPrevio.delete(nombre);
    if (nombre === "fotos") {
      inputFoto.value = "";
      mostrarError(fotosAlert, null);
      const recargar = fotosCambiaron;
      propiedadFotosId = null;
      fotosCambiaron = false;
      if (recargar) void cargar(true);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-cerrar]").forEach((n) => {
    n.addEventListener("click", () => {
      if (n.dataset.cerrar === "fotos" && subiendoFoto) return;
      cerrar(n.dataset.cerrar as NombreModal);
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && pilaModales.length) {
      const top = pilaModales[pilaModales.length - 1];
      if (top === "fotos" && subiendoFoto) return;
      cerrar(top);
    }
  });

  // ---------- Formato ----------
  function dinero(valor: string | number): string {
    const n = Number(valor);
    if (!Number.isFinite(n)) return "—";
    return new Intl.NumberFormat("es-CO", {
      style: "currency",
      currency: "COP",
      maximumFractionDigits: 0,
    }).format(n);
  }

  function urlImg(path: string | null | undefined): string | null {
    if (!path || path.trim() === "") return null;
    if (path.startsWith("http") || path.startsWith("data:")) return path;
    return path.startsWith("/")
      ? `${BACKEND_PUBLIC}${path}`
      : `${BACKEND_PUBLIC}/${path}`;
  }

  function claseEstado(e: string): string {
    return e === "Disponible"
      ? "est-disponible"
      : e === "Reservada"
        ? "est-reservada"
        : e === "En mantenimiento"
          ? "est-mantenimiento"
          : "est-fuera";
  }

  function pintarStats(items: PropiedadAgente[]): void {
    const disponibles = items.filter((p) => p.estado === "Disponible").length;
    statTotal.textContent = String(items.length);
    statDisponibles.textContent = String(disponibles);
    statOtras.textContent = String(items.length - disponibles);
  }

  // ---------- Tarjetas (mismo markup/clases que el panel de inmobiliaria) ----------
  function render(items: PropiedadAgente[]): void {
    grid.replaceChildren();

    sinResultados.hidden = !(items.length === 0 && listado.length > 0);
    grid.hidden = items.length === 0;

    contador.hidden = listado.length === 0;
    contador.textContent =
      items.length === listado.length
        ? `${items.length} ${items.length === 1 ? "propiedad" : "propiedades"}`
        : `Mostrando ${items.length} de ${listado.length}`;

    for (const p of items) {
      const card = document.createElement("article");
      card.className = "prop-card";

      const imgWrap = document.createElement("div");
      imgWrap.className = "prop-img";
      const src = urlImg(p.imagenPrincipal);
      if (src) {
        const img = document.createElement("img");
        img.src = src;
        img.alt = `Foto de ${p.titulo}`;
        img.loading = "lazy";
        imgWrap.appendChild(img);
      } else {
        const vacio = document.createElement("div");
        vacio.className = "prop-img-vacia";
        const icono = document.createElement("i");
        icono.className = "bi bi-house-door";
        icono.setAttribute("aria-hidden", "true");
        const texto = document.createElement("span");
        texto.textContent = "Sin fotos";
        vacio.append(icono, texto);
        imgWrap.appendChild(vacio);
      }
      const badge = document.createElement("span");
      badge.className = `prop-badge ${claseEstado(p.estado)}`;
      badge.textContent = p.estado || "Sin estado";
      imgWrap.appendChild(badge);

      const body = document.createElement("div");
      body.className = "prop-body";

      const h3 = document.createElement("h3");
      h3.className = "prop-title";
      h3.textContent = p.titulo || "Sin título";

      const loc = document.createElement("p");
      loc.className = "prop-loc";
      const locIcono = document.createElement("i");
      locIcono.className = "bi bi-geo-alt";
      locIcono.setAttribute("aria-hidden", "true");
      loc.appendChild(locIcono);
      loc.append(
        " " +
          ([p.direccion, p.ciudad].filter(Boolean).join(", ") ||
            "Sin ubicación"),
      );

      const precio = document.createElement("div");
      precio.className = "prop-price";
      precio.textContent = dinero(p.precio);

      const chips = document.createElement("div");
      chips.className = "prop-chips";
      if (p.tipoOperacion) {
        const chip = document.createElement("span");
        chip.className = "chip";
        chip.textContent = p.tipoOperacion;
        chips.appendChild(chip);
      }
      if (p.habitaciones != null) {
        const chip = document.createElement("span");
        chip.className = "chip";
        const chipIcono = document.createElement("i");
        chipIcono.className = "bi bi-door-open";
        chipIcono.setAttribute("aria-hidden", "true");
        chip.append(chipIcono, ` ${p.habitaciones} hab.`);
        chips.appendChild(chip);
      }

      body.append(h3, loc, precio, chips);

      const actions = document.createElement("div");
      actions.className = "prop-actions";

      const btnEdit = document.createElement("button");
      btnEdit.type = "button";
      btnEdit.className = "btn btn-sm btn-outline-primary flex-grow-1";
      btnEdit.setAttribute("aria-label", `Editar ${p.titulo}`);
      btnEdit.innerHTML =
        '<i class="bi bi-pencil" aria-hidden="true"></i> Editar';
      btnEdit.addEventListener("click", () => abrirEditar(p));

      const btnFotos = document.createElement("button");
      btnFotos.type = "button";
      btnFotos.className = "btn btn-sm btn-outline-secondary";
      btnFotos.setAttribute("aria-label", `Fotos de ${p.titulo}`);
      btnFotos.innerHTML =
        '<i class="bi bi-images" aria-hidden="true"></i> Fotos';
      btnFotos.addEventListener("click", () => abrirFotos(p));

      actions.append(btnEdit, btnFotos);

      card.append(imgWrap, body, actions);
      grid.appendChild(card);
    }
  }

  function filtrar(): void {
    const q = inputBuscar.value.trim().toLowerCase();
    const estado = selectEstado.value;
    const visibles = listado.filter((p) => {
      const texto =
        `${p.titulo} ${p.ciudad ?? ""} ${p.direccion}`.toLowerCase();
      const okTexto = q === "" || texto.includes(q);
      const okEstado = estado === "" || p.estado === estado;
      return okTexto && okEstado;
    });
    render(visibles);
  }

  async function cargar(silencioso = false): Promise<void> {
    if (!silencioso) {
      loadingState.hidden = false;
      mostrarError(errorState, null);
      grid.hidden = true;
      emptyState.hidden = true;
      sinResultados.hidden = true;
      contador.hidden = true;
    }
    try {
      const res = await fetch(API, {
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      });
      if (res.status === 401 || res.status === 403) {
        window.location.href =
          "/login?redirect=" + encodeURIComponent("/agente/propiedades");
        return;
      }
      const json = (await res.json()) as {
        success?: boolean;
        error?: string;
        data?: PropiedadAgente[];
      };
      if (!res.ok || json.success === false) {
        throw new Error(json.error || "No se pudieron cargar las propiedades");
      }
      listado = Array.isArray(json.data) ? json.data : [];
      pintarStats(listado);
      emptyState.hidden = listado.length !== 0;
      filtrar();
    } catch (error) {
      mostrarError(
        errorState,
        error instanceof Error ? error.message : "Error de conexión",
      );
    } finally {
      loadingState.hidden = true;
    }
  }

  // ---------- Galería ----------
  function pintarGaleria(imagenes: ImagenPropiedad[], mensaje?: string): void {
    galeriaFotos.replaceChildren();
    if (mensaje) {
      const aviso = document.createElement("span");
      aviso.className = "vacio";
      aviso.textContent = mensaje;
      galeriaFotos.appendChild(aviso);
      return;
    }
    if (imagenes.length === 0) {
      const aviso = document.createElement("span");
      aviso.className = "vacio";
      aviso.textContent = "Sin fotos aún. Sube la primera.";
      galeriaFotos.appendChild(aviso);
      return;
    }
    for (const img of imagenes) {
      const src = urlImg(img.url);
      if (!src) continue;
      const wrap = document.createElement("div");
      wrap.className = "galeria-item";
      const foto = document.createElement("img");
      foto.src = src;
      foto.alt = "Foto de la propiedad";
      foto.loading = "lazy";
      const quitar = document.createElement("button");
      quitar.type = "button";
      quitar.className = "btn-del-img";
      quitar.textContent = "×";
      quitar.setAttribute("aria-label", "Eliminar foto");
      quitar.addEventListener("click", () => {
        void quitarFoto(img.imagenID);
      });
      wrap.append(foto, quitar);
      galeriaFotos.appendChild(wrap);
    }
  }

  async function cargarGaleria(propiedadID: number): Promise<void> {
    mostrarError(fotosAlert, null);
    pintarGaleria([], "Cargando fotos...");
    try {
      const res = await fetch(`${API}/${propiedadID}`, {
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      });
      const json = (await res.json()) as {
        success?: boolean;
        error?: string;
        data?: { imagenes?: Array<{ imagenID?: number; url?: string }> };
      };
      if (propiedadFotosId !== propiedadID) return;
      if (!res.ok || json.success === false) {
        throw new Error(json.error || "No se pudieron cargar las fotos");
      }
      const imagenes = (json.data?.imagenes ?? [])
        .filter((img) => img && img.url && img.imagenID != null)
        .map((img) => ({
          imagenID: Number(img.imagenID),
          url: String(img.url),
        }));
      pintarGaleria(imagenes);
    } catch (error) {
      if (propiedadFotosId !== propiedadID) return;
      pintarGaleria([]);
      mostrarError(
        fotosAlert,
        error instanceof Error
          ? error.message
          : "Error de red al cargar las fotos",
      );
    }
  }

  function archivoValido(file: File): string | null {
    if (file.type && !TIPOS_IMAGEN.has(file.type))
      return `${file.name}: usa JPG, PNG o WEBP`;
    if (file.size <= 0) return `${file.name}: el archivo está vacío`;
    if (file.size > MAX_FOTO_BYTES) return `${file.name}: supera los 5 MB`;
    return null;
  }

  async function subirFotos(): Promise<void> {
    if (propiedadFotosId == null || subiendoFoto) return;
    mostrarError(fotosAlert, null);
    const files = Array.from(inputFoto.files ?? []);
    if (files.length === 0) {
      mostrarError(fotosAlert, "Elige una o varias imágenes.");
      return;
    }
    const invalidos = files
      .map(archivoValido)
      .filter((msg): msg is string => msg != null);
    if (invalidos.length > 0) {
      mostrarError(fotosAlert, invalidos.join(" "));
      return;
    }

    subiendoFoto = true;
    btnSubirFoto.disabled = true;
    btnSubirFoto.setAttribute("aria-busy", "true");
    btnSubirFoto.textContent = "Subiendo…";
    const errores: string[] = [];
    const propiedadID = propiedadFotosId;
    try {
      for (const file of files) {
        const fd = new FormData();
        fd.append("imagen", file);
        try {
          const res = await fetch(`${API}/${propiedadID}/imagenes`, {
            method: "POST",
            credentials: "same-origin",
            body: fd,
          });
          const json = (await res.json().catch(() => ({}))) as {
            success?: boolean;
            error?: string;
          };
          if (!res.ok || json.success === false) {
            errores.push(`${file.name}: ${json.error || "no se pudo subir"}`);
          }
        } catch {
          errores.push(`${file.name}: error de conexión`);
        }
      }
      inputFoto.value = "";
      fotosCambiaron = true;
      await cargarGaleria(propiedadID);
      if (errores.length > 0) mostrarError(fotosAlert, errores.join(" "));
    } finally {
      subiendoFoto = false;
      btnSubirFoto.disabled = false;
      btnSubirFoto.removeAttribute("aria-busy");
      btnSubirFoto.textContent = "Subir";
    }
  }

  async function quitarFoto(imagenID: number): Promise<void> {
    if (propiedadFotosId == null || subiendoFoto) return;
    if (!confirm("¿Eliminar esta foto? Esta acción no se puede deshacer."))
      return;
    mostrarError(fotosAlert, null);
    const propiedadID = propiedadFotosId;
    try {
      const res = await fetch(`${API}/${propiedadID}/imagenes/${imagenID}`, {
        method: "DELETE",
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      });
      const json = (await res.json()) as { success?: boolean; error?: string };
      if (!res.ok || json.success === false) {
        throw new Error(json.error || "No se pudo eliminar la foto");
      }
      fotosCambiaron = true;
      await cargarGaleria(propiedadID);
    } catch (error) {
      mostrarError(
        fotosAlert,
        error instanceof Error ? error.message : "Error de red al eliminar",
      );
    }
  }

  function abrirFotos(p: PropiedadAgente): void {
    propiedadFotosId = p.propiedadID;
    fotosCambiaron = false;
    modalFotosTitulo.textContent = `Fotos — "${p.titulo || "propiedad"}"`;
    inputFoto.value = "";
    pintarGaleria([]);
    abrir("fotos");
    void cargarGaleria(p.propiedadID);
  }

  // ---------- Formulario crear/editar ----------

  function abrirEditar(p: PropiedadAgente): void {
    campo.id.value = String(p.propiedadID);
    campo.titulo.value = p.titulo || "";
    campo.desc.value = p.descripcion || "";
    campo.hab.value = p.habitaciones == null ? "" : String(p.habitaciones);
    campo.estado.value = p.estado || "Disponible";
    modalTitulo.textContent = "Editar propiedad";
    mostrarError(modalAlert, null);
    abrir("propiedad");
  }

  async function guardar(): Promise<void> {
    mostrarError(modalAlert, null);
    if (!form.reportValidity()) return;

    const id = campo.id.value.trim();
    if (!id) return;

    const payload = {
      titulo: campo.titulo.value.trim(),
      habitaciones: campo.hab.value !== "" ? Number(campo.hab.value) : null,
      descripcion: campo.desc.value.trim() || null,
      estado: campo.estado.value,
    };

    if (!payload.titulo) {
      mostrarError(modalAlert, "El título no puede estar vacío.");
      return;
    }

    const btnGuardar = get<HTMLButtonElement>("btnGuardarProp");
    btnGuardar.disabled = true;
    btnGuardar.textContent = "Guardando…";
    try {
      const res = await fetch(`${API}/${id}`, {
        method: "PUT",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
      });
      const json = (await res.json()) as { success?: boolean; error?: string };
      if (!res.ok || json.success === false)
        throw new Error(json.error || "No se pudo guardar");
      cerrar("propiedad");
      await cargar();
    } catch (error) {
      mostrarError(
        modalAlert,
        error instanceof Error ? error.message : "Error al guardar",
      );
    } finally {
      btnGuardar.disabled = false;
      btnGuardar.textContent = "Guardar";
    }
  }
  // ---------- Eventos ----------
  inputBuscar.addEventListener("input", filtrar);
  selectEstado.addEventListener("change", filtrar);
  get("btnGuardarProp").addEventListener("click", () => {
    void guardar();
  });
  btnSubirFoto.addEventListener("click", () => {
    void subirFotos();
  });

  void cargar();
</script>
