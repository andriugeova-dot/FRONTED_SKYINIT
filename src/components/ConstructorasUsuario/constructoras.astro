---
interface ConstructoraItem {
    constructoraID: number;
    nombre: string;
    descripcion?: string | null;
    ciudad?: string | null;
    telefono?: string | null;
    correo?: string | null;
    logo?: string | null;
    inmobiliariaNombre?: string | null;
    inmobiliariaCiudad?: string | null;
}
interface Grupo {
    nombre: string;
    ciudad: string | null;
    items: ConstructoraItem[];
}
const { grupos = [] } = Astro.props as { grupos: Grupo[] };
---

<section class="resultados-section contenedor">
    <!-- Datos serializados para paginación JS -->
    <script id="constructoras-grupos-data" type="application/json" set:html={JSON.stringify(grupos)}></script>

    <div id="constructoras-grid" class="properties"></div>
    <nav id="paginacion-constructoras" class="paginacion-constructoras" aria-label="Paginación de constructoras"></nav>
</section>

<script>
    const BACKEND_CONST = "http://localhost:8001";
    const ITEMS_POR_PAG_C = 12;
    let paginaC = 1;

    interface ConstructoraItemJS {
        constructoraID: number;
        nombre: string;
        descripcion?: string | null;
        ciudad?: string | null;
        telefono?: string | null;
        correo?: string | null;
        logo?: string | null;
        _grupoNombre: string;
        _grupoCiudad: string | null;
    }

    function logoUrlJS(logo: string | null | undefined): string | null {
        if (!logo) return null;
        if (logo.startsWith("http")) return logo;
        if (logo.startsWith("/")) return `${BACKEND_CONST}${logo}`;
        return `${BACKEND_CONST}/uploads/constructoras/${encodeURIComponent(logo)}`;
    }

    const rawGrupos: any[] = JSON.parse(
        (document.getElementById("constructoras-grupos-data") as HTMLScriptElement).textContent ?? "[]"
    );

    const todosItems: ConstructoraItemJS[] = rawGrupos.flatMap((g) =>
        (g.items ?? []).map((c: any) => ({ ...c, _grupoNombre: g.nombre, _grupoCiudad: g.ciudad }))
    );

    function renderCardC(c: ConstructoraItemJS) {
        const src = logoUrlJS(c.logo);
        const imgHtml = src
            ? `<img src="${src}" alt="${c.nombre}" loading="lazy" referrerpolicy="no-referrer" />`
            : `<div class="card-img-placeholder"><span>${(c.nombre || "C").slice(0, 2).toUpperCase()}</span></div>`;
        return `
            <article class="property-card">
                <div class="property-image constructora-img">
                    ${imgHtml}
                    <span class="badge-tipo badge-venta badge-constructora">${c._grupoNombre}</span>
                </div>
                <div class="property-info">
                    <h2 class="constructora-nombre">${c.nombre}</h2>
                    ${c.ciudad ? `<p class="location"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px;color:#2e8b57"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>${c.ciudad}</p>` : ""}
                    ${c.descripcion ? `<p class="description">${c.descripcion}</p>` : ""}
                    ${(c.telefono || c.correo) ? `<p class="contacto-info">${[c.telefono, c.correo].filter(Boolean).join(" · ")}</p>` : ""}
                </div>
            </article>`;
    }

    function renderGridC(items: ConstructoraItemJS[]) {
        const grid = document.getElementById("constructoras-grid")!;
        if (!items.length) {
            grid.innerHTML = `<p class="sin-resultados">No hay constructoras activas por ahora.</p>`;
            return;
        }
        grid.innerHTML = items.map(renderCardC).join("");
    }

    function renderPaginacionC(total: number) {
        const nav = document.getElementById("paginacion-constructoras")!;
        const totalPaginas = Math.ceil(total / ITEMS_POR_PAG_C);
        if (totalPaginas <= 1) { nav.innerHTML = ""; return; }

        let html = `<div class="paginas">`;
        html += `<button class="pag-btn pag-prev" ${paginaC === 1 ? "disabled" : ""}>&#8592; Anterior</button>`;
        const visible = new Set<number>();
        visible.add(1); visible.add(totalPaginas);
        for (let i = Math.max(2, paginaC - 1); i <= Math.min(totalPaginas - 1, paginaC + 1); i++) visible.add(i);
        const sorted = Array.from(visible).sort((a, b) => a - b);
        let prev = 0;
        for (const n of sorted) {
            if (prev && n - prev > 1) html += `<span class="pag-ellipsis">…</span>`;
            html += `<button class="pag-btn pag-num ${n === paginaC ? "pag-activa" : ""}" data-page="${n}">${n}</button>`;
            prev = n;
        }
        html += `<button class="pag-btn pag-next" ${paginaC === totalPaginas ? "disabled" : ""}>Siguiente &#8594;</button>`;
        html += `<span class="pag-info">Página ${paginaC} de ${totalPaginas} · ${total} constructoras</span>`;
        html += `</div>`;
        nav.innerHTML = html;

        nav.querySelectorAll(".pag-num").forEach((btn) => {
            btn.addEventListener("click", () => {
                paginaC = Number((btn as HTMLElement).dataset.page);
                irAPaginaC();
            });
        });
        nav.querySelector(".pag-prev")?.addEventListener("click", () => {
            if (paginaC > 1) { paginaC--; irAPaginaC(); }
        });
        nav.querySelector(".pag-next")?.addEventListener("click", () => {
            const tp = Math.ceil(todosItems.length / ITEMS_POR_PAG_C);
            if (paginaC < tp) { paginaC++; irAPaginaC(); }
        });
    }

    function irAPaginaC() {
        const inicio = (paginaC - 1) * ITEMS_POR_PAG_C;
        renderGridC(todosItems.slice(inicio, inicio + ITEMS_POR_PAG_C));
        renderPaginacionC(todosItems.length);
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    irAPaginaC();
</script>

<style is:global>
    :root {
        --verde: #2e8b57;
        --verde-dark: #1f5f3d;
    }

    .resultados-section {
        background: #f9fcf3;
        min-height: 70vh;
        padding-top: 40px;
        padding-bottom: 48px;
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 30px;
        padding-right: 30px;
    }

    /* Grid idéntico al de propiedades */
    .properties {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 28px;
        padding-bottom: 16px;
    }

    .property-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .property-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    }

    /* Zona imagen */
    .property-image.constructora-img {
        position: relative;
        width: 100%;
        height: 230px;
        overflow: hidden;
        background: #e8f0ea;
    }

    .property-image.constructora-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .property-card:hover .property-image.constructora-img img {
        transform: scale(1.08);
    }

    /* Placeholder cuando no hay logo */
    .card-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    }

    .card-img-placeholder span {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--verde-dark);
        letter-spacing: -1px;
    }

    /* Badge inmobiliaria (equivalente al badge-tipo) */
    .badge-constructora {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(46, 139, 87, 0.9);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 5px 12px;
        border-radius: 20px;
        z-index: 2;
        backdrop-filter: blur(4px);
    }

    /* Info */
    .property-info {
        padding: 18px 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .constructora-nombre {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1.3;
    }

    .location {
        margin: 0;
        color: var(--verde);
        font-size: 0.88rem;
        font-weight: 600;
    }

    .description {
        margin: 2px 0 0;
        font-size: 0.88rem;
        color: #555;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .contacto-info {
        margin: 4px 0 0;
        font-size: 0.8rem;
        color: #6c757d;
    }

    .sin-resultados {
        text-align: center;
        color: #666;
        padding: 40px;
        grid-column: 1 / -1;
    }

    /* Paginación */
    .paginacion-constructoras {
        display: flex;
        justify-content: center;
        padding: 24px 0 48px;
    }
    .paginas {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .pag-btn {
        padding: 8px 14px;
        border: 1px solid #d4e8d4;
        border-radius: 8px;
        background: #fff;
        color: #2e7d32;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .pag-btn:hover:not(:disabled) { background: #e8f5e9; border-color: #2e7d32; }
    .pag-btn:disabled { opacity: 0.38; cursor: default; }
    .pag-btn.pag-activa { background: #2e7d32; color: #fff; border-color: #2e7d32; }
    .pag-ellipsis { padding: 0 4px; color: #999; font-size: 0.95rem; user-select: none; }
    .pag-info { width: 100%; text-align: center; margin-top: 8px; font-size: 0.82rem; color: #888; font-weight: 500; }
</style>
