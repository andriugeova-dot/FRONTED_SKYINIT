---
interface InmobiliariaInfo {
    inmobiliariaID: number | null;
    nombre: string;
    ciudad: string | null;
}

interface ConstructoraItem {
    constructoraID: number;
    nombre: string;
    descripcion?: string | null;
    ciudad?: string | null;
    telefono?: string | null;
    correo?: string | null;
    logo?: string | null;
    inmobiliariaID?: number | null;
    inmobiliariaNombre?: string | null;
    inmobiliariaCiudad?: string | null;
}

interface ConstructoraAgrupada {
    constructoraID: number;
    nombre: string;
    descripcion: string | null;
    ciudad: string | null;
    telefono: string | null;
    correo: string | null;
    logo: string | null;
    inmobiliarias: InmobiliariaInfo[];
}

interface Grupo {
    nombre: string;
    ciudad: string | null;
    items: ConstructoraItem[];
}

const { grupos = [] } = Astro.props as { grupos: Grupo[] };

// Deduplicar: agrupar por constructoraID
const mapaC = new Map<number, ConstructoraAgrupada>();
for (const g of grupos) {
    for (const c of g.items) {
        if (!mapaC.has(c.constructoraID)) {
            mapaC.set(c.constructoraID, {
                constructoraID: c.constructoraID,
                nombre: c.nombre,
                descripcion: c.descripcion ?? null,
                ciudad: c.ciudad ?? null,
                telefono: c.telefono ?? null,
                correo: c.correo ?? null,
                logo: c.logo ?? null,
                inmobiliarias: [],
            });
        }
        const entry = mapaC.get(c.constructoraID)!;
        if (
            c.inmobiliariaID != null &&
            !entry.inmobiliarias.some((i) => i.inmobiliariaID === c.inmobiliariaID)
        ) {
            entry.inmobiliarias.push({
                inmobiliariaID: c.inmobiliariaID,
                nombre: c.inmobiliariaNombre ?? "Sin nombre",
                ciudad: c.inmobiliariaCiudad ?? null,
            });
        }
    }
}

const constructorasUnicas: ConstructoraAgrupada[] = Array.from(mapaC.values());
---

<section class="resultados-section contenedor">
    <script
        id="constructoras-data"
        type="application/json"
        set:html={JSON.stringify(constructorasUnicas)}
    ></script>

    <div id="constructoras-grid" class="properties"></div>
    <nav
        id="paginacion-constructoras"
        class="paginacion-constructoras"
        aria-label="Paginación de constructoras"
    ></nav>
</section>

<!-- Modal detalle constructora -->
<div id="modal-constructora" class="modal-overlay" aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-titulo">
        <button class="modal-cerrar" id="modal-cerrar" aria-label="Cerrar">&times;</button>

        <div class="modal-header">
            <div id="modal-logo-wrap" class="modal-logo-wrap"></div>
            <div class="modal-header-info">
                <h2 id="modal-titulo" class="modal-nombre"></h2>
                <p id="modal-ciudad" class="modal-ciudad"></p>
            </div>
        </div>

        <div class="modal-body">
            <p id="modal-descripcion" class="modal-descripcion"></p>

            <div class="modal-contacto" id="modal-contacto"></div>

            <div id="modal-inmobiliarias-wrap" class="modal-inmob-section">
                <h3 class="modal-inmob-titulo">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                        ><path
                            d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"
                        ></path></svg
                    >
                    Inmobiliarias asociadas
                </h3>
                <div id="modal-inmobiliarias-lista" class="modal-inmob-lista"></div>
            </div>
        </div>
    </div>
</div>

<script>
    const BACKEND_CONST = "http://localhost:8001";
    const ITEMS_POR_PAG_C = 12;
    let paginaC = 1;

    interface InmobiliariaInfoJS {
        inmobiliariaID: number | null;
        nombre: string;
        ciudad: string | null;
    }

    interface ConstructoraAgrupadaJS {
        constructoraID: number;
        nombre: string;
        descripcion: string | null;
        ciudad: string | null;
        telefono: string | null;
        correo: string | null;
        logo: string | null;
        inmobiliarias: InmobiliariaInfoJS[];
    }

    function logoUrlJS(logo: string | null | undefined): string | null {
        if (!logo) return null;
        if (logo.startsWith("http")) return logo;
        if (logo.startsWith("/")) return `${BACKEND_CONST}${logo}`;
        return `${BACKEND_CONST}/uploads/constructoras/${encodeURIComponent(logo)}`;
    }

    const todosItems: ConstructoraAgrupadaJS[] = JSON.parse(
        (document.getElementById("constructoras-data") as HTMLScriptElement).textContent ?? "[]",
    );

    /* ── TARJETAS ── */
    function renderCardC(c: ConstructoraAgrupadaJS) {
        const src = logoUrlJS(c.logo);
        const imgHtml = src
            ? `<img src="${src}" alt="${c.nombre}" loading="lazy" referrerpolicy="no-referrer" />`
            : `<div class="card-img-placeholder"><span>${(c.nombre || "C").slice(0, 2).toUpperCase()}</span></div>`;

        const nInmob = c.inmobiliarias.length;
        const badgeInmob =
            nInmob > 0
                ? `<span class="badge-inmob-count">${nInmob} inmobiliaria${nInmob > 1 ? "s" : ""}</span>`
                : "";

        return `
            <article class="property-card constructora-clickable" data-id="${c.constructoraID}" tabindex="0" role="button" aria-label="Ver detalle de ${c.nombre}">
                <div class="property-image constructora-img">
                    ${imgHtml}
                    ${badgeInmob}
                </div>
                <div class="property-info">
                    <h2 class="constructora-nombre">${c.nombre}</h2>
                    ${c.ciudad ? `<p class="location"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px;color:#2e8b57"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>${c.ciudad}</p>` : ""}
                    ${c.descripcion ? `<p class="description">${c.descripcion}</p>` : ""}
                    <span class="btn-ver-mas">Ver información →</span>
                </div>
            </article>`;
    }

    function renderGridC(items: ConstructoraAgrupadaJS[]) {
        const grid = document.getElementById("constructoras-grid")!;
        if (!items.length) {
            grid.innerHTML = `<p class="sin-resultados">No hay constructoras activas por ahora.</p>`;
            return;
        }
        grid.innerHTML = items.map(renderCardC).join("");

        // Click / teclado en cada tarjeta
        grid.querySelectorAll<HTMLElement>(".constructora-clickable").forEach((el) => {
            const open = () => {
                const id = Number(el.dataset.id);
                const c = todosItems.find((x) => x.constructoraID === id);
                if (c) abrirModal(c);
            };
            el.addEventListener("click", open);
            el.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    open();
                }
            });
        });
    }

    /* ── MODAL ── */
    function abrirModal(c: ConstructoraAgrupadaJS) {
        const overlay = document.getElementById("modal-constructora")!;
        const src = logoUrlJS(c.logo);

        // Logo
        const logoWrap = document.getElementById("modal-logo-wrap")!;
        logoWrap.innerHTML = src
            ? `<img src="${src}" alt="${c.nombre}" class="modal-logo-img" referrerpolicy="no-referrer" />`
            : `<div class="modal-logo-placeholder">${(c.nombre || "C").slice(0, 2).toUpperCase()}</div>`;

        // Datos básicos
        document.getElementById("modal-titulo")!.textContent = c.nombre;
        const ciudadEl = document.getElementById("modal-ciudad")!;
        ciudadEl.innerHTML = c.ciudad
            ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>${c.ciudad}`
            : "";

        document.getElementById("modal-descripcion")!.textContent = c.descripcion ?? "";

        // Contacto
        const contactoEl = document.getElementById("modal-contacto")!;
        const items: string[] = [];
        if (c.telefono)
            items.push(
                `<span class="contacto-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>${c.telefono}</span>`,
            );
        if (c.correo)
            items.push(
                `<span class="contacto-chip"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>${c.correo}</span>`,
            );
        contactoEl.innerHTML = items.join("");

        // Inmobiliarias
        const listaEl = document.getElementById("modal-inmobiliarias-lista")!;
        const wrap = document.getElementById("modal-inmobiliarias-wrap")!;
        if (c.inmobiliarias.length === 0) {
            wrap.style.display = "none";
        } else {
            wrap.style.display = "";
            listaEl.innerHTML = c.inmobiliarias
                .map(
                    (i) => `
                <div class="inmob-chip">
                    <div class="inmob-chip-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/></svg>
                    </div>
                    <div class="inmob-chip-text">
                        <strong>${i.nombre}</strong>
                        ${i.ciudad ? `<span>${i.ciudad}</span>` : ""}
                    </div>
                </div>`,
                )
                .join("");
        }

        overlay.setAttribute("aria-hidden", "false");
        overlay.classList.add("modal-visible");
        document.body.style.overflow = "hidden";
    }

    function cerrarModal() {
        const overlay = document.getElementById("modal-constructora")!;
        overlay.classList.remove("modal-visible");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    document.getElementById("modal-cerrar")!.addEventListener("click", cerrarModal);
    document.getElementById("modal-constructora")!.addEventListener("click", (e) => {
        if (e.target === e.currentTarget) cerrarModal();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarModal();
    });

    /* ── PAGINACIÓN ── */
    function renderPaginacionC(total: number) {
        const nav = document.getElementById("paginacion-constructoras")!;
        const totalPaginas = Math.ceil(total / ITEMS_POR_PAG_C);
        if (totalPaginas <= 1) {
            nav.innerHTML = "";
            return;
        }

        let html = `<div class="paginas">`;
        html += `<button class="pag-btn pag-prev" ${paginaC === 1 ? "disabled" : ""}>&#8592; Anterior</button>`;
        const visible = new Set<number>();
        visible.add(1);
        visible.add(totalPaginas);
        for (
            let i = Math.max(2, paginaC - 1);
            i <= Math.min(totalPaginas - 1, paginaC + 1);
            i++
        )
            visible.add(i);
        const sorted = Array.from(visible).sort((a, b) => a - b);
        let prev = 0;
        for (const n of sorted) {
            if (prev && n - prev > 1) html += `<span class="pag-ellipsis">…</span>`;
            html += `<button class="pag-btn pag-num ${n === paginaC ? "pag-activa" : ""}" data-page="${n}">${n}</button>`;
            prev = n;
        }
        html += `<button class="pag-btn pag-next" ${paginaC === totalPaginas ? "disabled" : ""}>Siguiente &#8594;</button>`;
        html += `<span class="pag-info">Página ${paginaC} de ${totalPaginas} · ${total} constructoras</span>`;
        html += `</div>`;
        nav.innerHTML = html;

        nav.querySelectorAll(".pag-num").forEach((btn) => {
            btn.addEventListener("click", () => {
                paginaC = Number((btn as HTMLElement).dataset.page);
                irAPaginaC();
            });
        });
        nav.querySelector(".pag-prev")?.addEventListener("click", () => {
            if (paginaC > 1) {
                paginaC--;
                irAPaginaC();
            }
        });
        nav.querySelector(".pag-next")?.addEventListener("click", () => {
            const tp = Math.ceil(todosItems.length / ITEMS_POR_PAG_C);
            if (paginaC < tp) {
                paginaC++;
                irAPaginaC();
            }
        });
    }

    function irAPaginaC() {
        const inicio = (paginaC - 1) * ITEMS_POR_PAG_C;
        renderGridC(todosItems.slice(inicio, inicio + ITEMS_POR_PAG_C));
        renderPaginacionC(todosItems.length);
        window.scrollTo({ top: 0, behavior: "smooth" });
    }

    irAPaginaC();
</script>

<style is:global>
    :root {
        --verde: #2e8b57;
        --verde-dark: #1f5f3d;
    }

    .resultados-section {
        background: #f9fcf3;
        min-height: 70vh;
        padding-top: 40px;
        padding-bottom: 48px;
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 30px;
        padding-right: 30px;
    }

    .properties {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 28px;
        padding-bottom: 16px;
    }

    /* TARJETA */
    .property-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
    }
    .property-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    }
    .property-card:focus-visible {
        outline: 3px solid var(--verde);
        outline-offset: 2px;
    }

    /* Imagen */
    .property-image.constructora-img {
        position: relative;
        width: 100%;
        height: 230px;
        overflow: hidden;
        background: #e8f0ea;
    }
    .property-image.constructora-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }
    .property-card:hover .property-image.constructora-img img {
        transform: scale(1.08);
    }

    .card-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    }
    .card-img-placeholder span {
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--verde-dark);
