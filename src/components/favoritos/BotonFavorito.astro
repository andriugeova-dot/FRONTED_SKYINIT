---
interface Props {
  propiedadID: number;
  activo?: boolean;
  class?: string;
}

const { propiedadID, activo = false, class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    "btn-favorito",
    activo ? "favorito-activo" : "favorito-inactivo",
    className,
  ]}
  data-id={propiedadID}
  aria-label={activo ? "Quitar de favoritos" : "Guardar en favoritos"}
  aria-pressed={activo ? "true" : "false"}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
  </svg>
</button>

<style>
  .btn-favorito {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 36px;
    height: 36px;
    background: #fff;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    color: #1a1a1a;
    z-index: 10;
    transition: transform 0.2s ease;
  }
  .btn-favorito:hover {
    transform: scale(1.1);
  }
  .btn-favorito.favorito-activo {
    color: #28a745;
  }
  .btn-favorito.favorito-activo svg {
    fill: #28a745;
    stroke: #28a745;
  }
  .btn-favorito:disabled {
    opacity: 0.6;
    cursor: wait;
  }
</style>