---
import "../login/login.css";
---

<div class="auth-page">
    <div class="bg-layer" aria-hidden="true">
        <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80"
        class="bg-img active"
        alt=""
        />
        <div class="bg-overlay"></div>
    </div>

    <header class="auth-header">
        <div class="brand">
        <h1>SkyInit</h1>
        <p>Recuperar acceso</p>
        </div>
    </header>

    <main class="auth-main">
        <div class="glass-card">
        <div class="card-title">
            <h2>¿Olvidaste tu contraseña?</h2>
            <p>Te enviaremos un enlace a tu correo para restablecerla</p>
        </div>

        <form id="formOlvide" class="auth-form">
            <div class="field">
            <label for="correo">Correo electrónico</label>
            <input
                id="correo"
                type="email"
                class="custom-input"
                placeholder="ejemplo@email.com"
                required
            />
            </div>

            <div id="msg" class="msg-error d-none" role="alert"></div>

            <button type="submit" id="btnEnviar" class="btn-brand">
            Enviar enlace
            </button>
        </form>

        <p class="auth-footer-links">
            <a href="/login">Volver al inicio de sesión</a>
        </p>
        </div>
    </main>

    <footer class="auth-footer">&copy; 2026 SkyInit</footer>
</div>

<script>
    const form = document.getElementById("formOlvide") as HTMLFormElement;
    const msg = document.getElementById("msg") as HTMLDivElement;
    const btn = document.getElementById("btnEnviar") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        msg.classList.add("d-none");
        btn.disabled = true;

    const Correo = (document.getElementById("correo") as HTMLInputElement).value.trim();

    try {
        const res = await fetch("http://localhost:8001/auth/olvide-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ Correo }),
        });
        const data = await res.json();

        msg.classList.remove("d-none");
        if (res.ok) {
            msg.style.color = "#86efac";
            msg.textContent =
            data.mensaje ||
            "Si el correo está registrado, enviamos las instrucciones.";
        } else {
            msg.style.color = "";
            msg.textContent = data.error || "No se pudo enviar el correo";
            btn.disabled = false;
        }
        } catch {
        msg.classList.remove("d-none");
        msg.textContent = "Error de conexión con el servidor";
        btn.disabled = false;
        }
    });
</script>