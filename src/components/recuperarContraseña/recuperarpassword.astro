---
import "../login/login.css";
---

<div class="auth-page">
  <div class="bg-layer" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80"
      class="bg-img active"
      alt=""
    />
    <div class="bg-overlay"></div>
  </div>

  <header class="auth-header">
    <div class="brand">
      <h1>SkyInit</h1>
      <p>Recuperar acceso</p>
    </div>
  </header>

  <main class="auth-main">
    <div class="glass-card">
      <!-- PASO 1: correo -->
      <div id="paso1">
        <div class="card-title">
          <h2>¿Olvidaste tu contraseña?</h2>
          <p>Te enviaremos un código de 6 dígitos a tu correo</p>
        </div>
        <form id="formCorreo" class="auth-form">
          <div class="field">
            <label for="correo">Correo electrónico</label>
            <input id="correo" type="email" class="custom-input" placeholder="ejemplo@email.com" required />
          </div>
          <div id="msg1" class="msg-error d-none" role="alert"></div>
          <button type="submit" id="btnCorreo" class="btn-brand">Enviar código</button>
        </form>
      </div>

      <!-- PASO 2: código -->
      <div id="paso2" class="d-none">
        <div class="card-title">
          <h2>Verifica tu identidad</h2>
          <p>Ingresa el código de 6 dígitos que enviamos a <strong id="correoMostrado"></strong></p>
        </div>
        <form id="formCodigo" class="auth-form">
          <div class="field">
            <label for="codigo">Código</label>
            <input
              id="codigo"
              type="text"
              class="custom-input"
              inputmode="numeric"
              maxlength="6"
              pattern="[0-9]{6}"
              placeholder="000000"
              required
              autocomplete="one-time-code"
            />
          </div>
          <div id="msg2" class="msg-error d-none" role="alert"></div>
          <button type="submit" id="btnCodigo" class="btn-brand">Verificar código</button>
          <button type="button" id="btnReenviar" class="btn-link" style="margin-top:0.75rem;background:none;border:none;color:#c8ad72;cursor:pointer;">
            Reenviar código
          </button>
        </form>
      </div>

      <p class="auth-footer-links">
        <a href="/login">Volver al login</a>
      </p>
    </div>
  </main>

  <footer class="auth-footer">&copy; 2026 SkyInit</footer>
</div>

<script>
  const paso1 = document.getElementById("paso1") as HTMLElement;
  const paso2 = document.getElementById("paso2") as HTMLElement;
  const formCorreo = document.getElementById("formCorreo") as HTMLFormElement;
  const formCodigo = document.getElementById("formCodigo") as HTMLFormElement;
  const msg1 = document.getElementById("msg1") as HTMLDivElement;
  const msg2 = document.getElementById("msg2") as HTMLDivElement;
  const btnCorreo = document.getElementById("btnCorreo") as HTMLButtonElement;
  const btnCodigo = document.getElementById("btnCodigo") as HTMLButtonElement;
  let correoGuardado = "";

  function showMsg(el: HTMLDivElement, text: string, ok = false) {
    el.classList.remove("d-none");
    el.textContent = text;
    el.style.color = ok ? "#166534" : "";
  }

  async function enviarCodigo() {
    const res = await fetch("/api/auth/olvide-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ Correo: correoGuardado }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "No se pudo enviar el código");
    return data;
  }

  formCorreo.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg1.classList.add("d-none");
    correoGuardado = (document.getElementById("correo") as HTMLInputElement).value.trim();
    btnCorreo.disabled = true;
    try {
      await enviarCodigo();
      (document.getElementById("correoMostrado") as HTMLElement).textContent = correoGuardado;
      paso1.classList.add("d-none");
      paso2.classList.remove("d-none");
    } catch (err: any) {
      showMsg(msg1, err.message || "Error");
    } finally {
      btnCorreo.disabled = false;
    }
  });

  formCodigo.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg2.classList.add("d-none");
    const Codigo = (document.getElementById("codigo") as HTMLInputElement).value.trim();
    btnCodigo.disabled = true;
    try {
      const res = await fetch("/api/auth/verificar-codigo", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ Correo: correoGuardado, Codigo }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Código inválido");
      if (!data.token) throw new Error("No se recibió token");
      window.location.href = "/restablecer-password?token=" + encodeURIComponent(data.token);
    } catch (err: any) {
      showMsg(msg2, err.message || "Error");
    } finally {
      btnCodigo.disabled = false;
    }
  });

  document.getElementById("btnReenviar")?.addEventListener("click", async () => {
    msg2.classList.add("d-none");
    try {
      await enviarCodigo();
      showMsg(msg2, "Código reenviado. Revisa tu correo.", true);
    } catch (err: any) {
      showMsg(msg2, err.message || "Error al reenviar");
    }
  });
</script>