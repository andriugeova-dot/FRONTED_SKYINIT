---
import "./terminos.css";
---

<div class="auth-page">
  <div class="bg-layer" aria-hidden="true">
  <img
    src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=2000&q=80"
    class="bg-img active"
    alt=""
  />
  <img
    src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=80"
    class="bg-img"
    alt=""
  />
  <img
    src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=2000&q=80"
    class="bg-img"
    alt=""
  />
  <img
    src="https://images.unsplash.com/photo-1605276374104-dee2a0ed3cd6?auto=format&fit=crop&w=2000&q=80"
    class="bg-img"
    alt=""
  />
    <div class="bg-overlay"></div>
  </div>

  <header class="auth-header">
    <div class="brand">
      <h1>SkyInit</h1>
      <p>Encuentra tu hogar ideal</p>
    </div>
  </header>

  <main class="auth-main">
    <div class="glass-card card-enter-terminos">
      <div class="card-title">
        <h2>Términos y condiciones</h2>
        <p id="metaTerminos">Cargando documento…</p>
      </div>

      <div class="contenido" id="contenidoTerminos">
        <p class="cargando">Obteniendo documento…</p>
      </div>

      <label class="check-row">
        <input type="checkbox" id="chkAcepto" />
        <span>He leído y acepto los términos y condiciones de SkyInit</span>
      </label>

      <div id="mensajeError" class="msg-error d-none" role="alert"></div>
      <div id="mensajeExito" class="msg-exito d-none" role="status"></div>

      <div class="acciones">
        <button type="button" class="btn-secondary" id="btnCancelar">Volver</button>
        <button type="button" class="btn-brand" id="btnAceptar" disabled>
          Aceptar y crear cuenta
        </button>
      </div>

      <p class="auth-footer-links">
        <a href="/registro" id="linkVolverRegistro">Editar datos del registro</a>
      </p>
    </div>
  </main>

  <footer class="auth-footer">&copy; 2026 SkyInit. Todos los derechos reservados.</footer>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<script>
  import { obtenerTerminosRequest, registroRequest, rutaPorRol } from "../../utils/api";

  // Carrusel de fondo (igual que registro)
  const imgs = document.querySelectorAll(".bg-img");
  let i = 0;
  setInterval(() => {
    imgs[i].classList.remove("active");
    i = (i + 1) % imgs.length;
    imgs[i].classList.add("active");
  }, 7500);

  const meta = document.getElementById("metaTerminos") as HTMLParagraphElement;
  const contenido = document.getElementById("contenidoTerminos") as HTMLDivElement;
  const chk = document.getElementById("chkAcepto") as HTMLInputElement;
  const btnAceptar = document.getElementById("btnAceptar") as HTMLButtonElement;
  const btnCancelar = document.getElementById("btnCancelar") as HTMLButtonElement;
  const mensajeError = document.getElementById("mensajeError") as HTMLDivElement;
  const mensajeExito = document.getElementById("mensajeExito") as HTMLDivElement;

  const raw = sessionStorage.getItem("skyinit_registro");
  if (!raw) {
    window.location.href = "/registro";
    throw new Error("Sin datos de registro");
  }

  chk.addEventListener("change", () => {
    btnAceptar.disabled = !chk.checked;
  });

  function irConFade(url: string) {
    document.querySelector(".auth-page")?.classList.add("page-leave");
    setTimeout(() => {
      window.location.href = url;
    }, 320);
  }

  btnCancelar.addEventListener("click", () => {
    window.location.href = "/registro";
  });

  document.getElementById("linkVolverRegistro")?.addEventListener("click", (e) => {
    e.preventDefault();
    irConFade("/registro");
  });

  (async () => {
    try {
      const data = await obtenerTerminosRequest();
      if (data.error || !data.terminos) {
        meta.textContent = "";
        contenido.innerHTML = `<p class="error-inline">${data.error || "No se pudieron cargar los términos"}</p>`;
        return;
      }
      const t = data.terminos;
      meta.textContent = `Versión ${t.version} · Actualizado ${t.fechaActualizacion}`;
      contenido.textContent = t.contenido;
    } catch {
      meta.textContent = "";
      contenido.innerHTML = `<p class="error-inline">Error al conectar con el servidor</p>`;
    }
  })();

  btnAceptar.addEventListener("click", async () => {
    mensajeError.classList.add("d-none");
    mensajeExito.classList.add("d-none");
    if (!chk.checked) {
      mensajeError.textContent = "Debes aceptar los términos y condiciones";
      mensajeError.classList.remove("d-none");
      return;
    }

    const stored = sessionStorage.getItem("skyinit_registro");
    if (!stored) {
      irConFade("/registro");
      return;
    }

    const datos = JSON.parse(stored) as {
      Nombre: string;
      Correo: string;
      Password: string;
      Confirmar: string;
      Telefono?: string;
    };

    btnAceptar.disabled = true;
    try {
      const data = await registroRequest({ ...datos, AceptoTerminos: true });
      if (data.error) {
        mensajeError.textContent = data.error;
        mensajeError.classList.remove("d-none");
        btnAceptar.disabled = false;
        return;
      }
      sessionStorage.removeItem("skyinit_registro");
      mensajeExito.textContent = data.mensaje || "Cuenta creada correctamente";
      mensajeExito.classList.remove("d-none");
      setTimeout(() => {
        window.location.href = "/"; // menú
      }, 900);
    } catch {
      mensajeError.textContent = "Error al conectar con el servidor";
      mensajeError.classList.remove("d-none");
      btnAceptar.disabled = false;
    }
  });
</script>