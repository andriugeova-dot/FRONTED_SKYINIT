---
import "./proyectos.css";
---

<div class="page">
    <header class="page-header">
        <div>
        <h1>Proyectos</h1>
        <p>Consulta tus Proyectos</p>
        </div>
    </header>

    <div id="grid-proyectos" class="ag-theme-quartz grid-box"></div>
</div>

<!-- MODAL FOTO (div, no dialog) -->
<div id="modal-foto" class="sky-modal" hidden>
    <div class="sky-modal-backdrop" data-cerrar="foto"></div>
    <div class="sky-modal-card">
        <h3>Fotos del proyecto</h3>
        <div id="galeria-fotos" class="galeria"></div>
        <label>Agregar otra foto</label>
        <input type="file" id="input-foto" accept="image/*" />
        <div class="modal-actions">
        <button type="button" class="btn-outline" data-cerrar="foto">Cerrar</button>
        <button type="button" class="btn-primary" id="btn-subir-foto">Subir</button>
        </div>
    </div>
</div>

<!-- MODAL AVANCE -->
<div id="modal-avance" class="sky-modal" hidden>
    <div class="sky-modal-backdrop" data-cerrar="avance"></div>
    <div class="sky-modal-card">
        <h3>Registrar avance</h3>
        <label>Porcentaje (0–100)</label>
        <input type="number" id="input-porcentaje" min="0" max="100" step="0.01" />
        <label>Nota</label>
        <textarea id="input-nota" rows="3"></textarea>
        <div class="modal-actions">
        <button type="button" class="btn-outline" data-cerrar="avance">Cancelar</button>
        <button type="button" class="btn-primary" id="btn-guardar-avance">Guardar</button>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.4/styles/ag-grid.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.4/styles/ag-theme-quartz.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.4/dist/ag-grid-community.min.noStyle.js"></script>

<script is:inline>
    (function () {
        var BACKEND_PUBLIC = "http://localhost:8001";
        var proyectoActivo = null;
        var gridApi = null;

        function abrirModal(cual) {
        var el = document.getElementById(cual === "foto" ? "modal-foto" : "modal-avance");
        if (el) el.hidden = false;
        }
        function cerrarModal(cual) {
        var el = document.getElementById(cual === "foto" ? "modal-foto" : "modal-avance");
        if (el) el.hidden = true;
        }

        function urlImg(path) {
        if (!path) return null;
        if (String(path).indexOf("http") === 0) return path;
        return BACKEND_PUBLIC + (String(path).charAt(0) === "/" ? path : "/" + path);
        }

        function fotoRenderer(params) {
            var data = params.data || {};
            var n = 0;

            if (typeof data.totalImagenes === "number") {
                n = data.totalImagenes;
            } else if (data.imagenes && data.imagenes.length) {
                n = data.imagenes.length;
            } else if (data.imagenUrl) {
                n = 1;
            }

            if (n <= 0) {
                return '<span class="foto-count">0 fotos</span>';
            }
            // miniatura + texto
            var url = urlImg(data.imagenUrl || (data.imagenes && data.imagenes[0]));
            if (url) {
                return (
                '<div style="display:flex;align-items:center;gap:8px;">' +
                '<img class="thumb" src="' + url + '" alt="" />' +
                '<span class="foto-count tiene">' + n + (n === 1 ? " foto" : " fotos") + "</span>" +
                "</div>"
                );
            }
            return '<span class="foto-count tiene">' + n + (n === 1 ? " foto" : " fotos") + "</span>";
        }

        // HTML string + data-attributes (más simple)
        function accionesRenderer(params) {
        var id = params.data && params.data.proyectoID;
        if (!id) return "";
        return (
            '<button type="button" class="btn-sm btn-foto" data-sky-accion="foto" data-sky-id="' +
            id +
            '">Foto</button> ' +
            '<button type="button" class="btn-sm btn-avance" data-sky-accion="avance" data-sky-id="' +
            id +
            '">Avance</button>'
        );
        }

        function pintarGaleria(imagenes) {
            var g = document.getElementById("galeria-fotos");
            if (!g) return;
            g.innerHTML = "";

            // compatible: string[] o { imagenID, url }[]
            var lista = (imagenes || []).map(function (item) {
                if (typeof item === "string") return { imagenID: null, url: item };
                return { imagenID: item.imagenID, url: item.url };
            });

            if (!lista.length) {
                g.innerHTML = '<span class="vacio">Sin fotos aún. Sube la primera.</span>';
                return;
            }

            lista.forEach(function (item) {
                var src = urlImg(item.url);
                if (!src) return;

                var wrap = document.createElement("div");
                wrap.className = "galeria-item";

                var img = document.createElement("img");
                img.src = src;
                img.alt = "";
                img.onerror = function () {
                img.style.opacity = "0.3";
                };
                wrap.appendChild(img);

                if (item.imagenID != null) {
                var btn = document.createElement("button");
                btn.type = "button";
                btn.className = "btn-borrar-img";
                btn.title = "Eliminar";
                btn.textContent = "×";
                btn.setAttribute("data-sky-del-img", String(item.imagenID));
                wrap.appendChild(btn);
                }

                g.appendChild(wrap);
                });
            }

        function cargarGaleriaProyecto(id) {
                return fetch("/api/panel/constructora/proyecto_detalle?id=" + id, {
                    credentials: "same-origin",
                })
                    .then(function (r) {
                    return r.json();
                    })
                    .then(function (json) {
                    var imgs = (json.data && json.data.imagenes) || [];
                    pintarGaleria(imgs);
                    var titulo = document.querySelector("#modal-foto h3");
                    if (titulo) {
                        titulo.textContent = "Fotos del proyecto (" + imgs.length + ")";
                    }
                    })
                    .catch(function () {
                    pintarGaleria([]);
                    });
        }

        function cargar() {
        fetch("/api/panel/constructora/proyectos", { credentials: "same-origin" })
            .then(function (res) {
            return res.text();
            })
            .then(function (text) {
            var json;
            try {
                json = JSON.parse(text);
            } catch (e) {
                console.error("API no JSON", text.slice(0, 200));
                return;
            }
            var rows = Array.isArray(json.data) ? json.data : [];
            if (gridApi) gridApi.setGridOption("rowData", rows);
            });
        }

        // CAPTURE en document: AG Grid no se come el click
        document.addEventListener(
        "click",
        function (e) {
            var t = e.target;
            if (!t || !t.closest) return;

            var cerrar = t.closest("[data-cerrar]");
            if (cerrar) {
            cerrarModal(cerrar.getAttribute("data-cerrar"));
            return;
            }

            var del = t.closest("[data-sky-del-img]");
                if (del) {
                e.preventDefault();
                e.stopPropagation();
                var imagenId = del.getAttribute("data-sky-del-img");
                if (!proyectoActivo || !imagenId) return;
                if (!confirm("¿Eliminar esta foto?")) return;

                fetch(
                    "/api/panel/constructora/proyecto_imagen_delete?id=" +
                    proyectoActivo +
                    "&imagenId=" +
                    imagenId,
                    { method: "DELETE", credentials: "same-origin" }
                )
                    .then(function (res) {
                    if (!res.ok) throw new Error("No se pudo eliminar");
                    return cargarGaleriaProyecto(proyectoActivo).then(function () {
                        cargar(); // refresca contador del grid
                    });
                    })
                    .catch(function (err) {
                    alert(err.message || "Error al eliminar");
                    });
                return;
                }

            var btn = t.closest("[data-sky-accion]");
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            proyectoActivo = Number(btn.getAttribute("data-sky-id"));
            var accion = btn.getAttribute("data-sky-accion");
            console.log("Accion grid:", accion, proyectoActivo);

            if (accion === "foto") {
                proyectoActivo = Number(btn.getAttribute("data-sky-id"));
                document.getElementById("input-foto").value = "";
                pintarGaleria([]); // limpia mientras carga
                abrirModal("foto");
                cargarGaleriaProyecto(proyectoActivo);
                }



            if (accion === "avance") {
            document.getElementById("input-porcentaje").value = "";
            document.getElementById("input-nota").value = "";
            abrirModal("avance");
            }
        },
        true
        );

        document.getElementById("btn-subir-foto").addEventListener("click", function () {
        if (!proyectoActivo) return;
        var fileInput = document.getElementById("input-foto");
        var file = fileInput.files && fileInput.files[0];
        if (!file) {
            alert("Elige una imagen");
            return;
        }
        var fd = new FormData();
        fd.append("imagen", file);
        fetch("/api/panel/constructora/proyecto_imagen?id=" + proyectoActivo, {
            method: "POST",
            body: fd,
            credentials: "same-origin",
        })
            .then(function (res) {
                if (!res.ok) throw new Error("fail");
                document.getElementById("input-foto").value = "";
                return cargarGaleriaProyecto(proyectoActivo).then(function () {
                    cargar();
                });
                })
                .catch(function () {
                alert("No se pudo subir la foto");
                });
            });

        document.getElementById("btn-guardar-avance").addEventListener("click", function () {
        if (!proyectoActivo) return;
        var porcentaje = Number(document.getElementById("input-porcentaje").value);
        var nota = document.getElementById("input-nota").value;
        fetch("/api/panel/constructora/proyecto_avance?id=" + proyectoActivo, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ porcentaje: porcentaje, nota: nota }),
        })
            .then(function (res) {
            return res.json().then(function (data) {
                if (!res.ok) throw new Error(data.message || data.error || "Error");
                cerrarModal("avance");
                cargar();
            });
            })
            .catch(function (err) {
            alert(err.message || "No se pudo guardar el avance");
            });
        });

        function init() {
        var gridDiv = document.getElementById("grid-proyectos");
        if (!gridDiv || typeof agGrid === "undefined") {
            console.error("Grid o agGrid no listos");
            return;
        }
        gridApi = agGrid.createGrid(gridDiv, {
            columnDefs: [
            { headerName: "Foto", field: "imagenUrl", width: 140, cellRenderer: fotoRenderer, sortable: false, filter: false },
            { headerName: "Nombre", field: "nombre", flex: 1, minWidth: 160 },
            { headerName: "Estado", field: "estado", width: 140 },
            { headerName: "Avance %", field: "porcentajeAvance", width: 110 },
            { headerName: "Ubicación", field: "ubicacion", flex: 1, minWidth: 140 },
            { headerName: "Acciones", width: 180, cellRenderer: accionesRenderer, sortable: false, filter: false },
            ],
            defaultColDef: { resizable: true, sortable: true },
            rowHeight: 56,
            rowData: [],
        });
        cargar();
        }

        if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
        } else {
        init();
        }
    })();
</script>