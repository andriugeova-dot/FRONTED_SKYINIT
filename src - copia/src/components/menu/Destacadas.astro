---
import { isAuthenticatedSSR } from "../../utils/auth";

const autenticado = isAuthenticatedSSR(Astro.cookies);

// Tipos
type PropiedadDestacada = {
  propiedadID: number;
  titulo: string;
  precio: number | string;
  ciudad?: string | null;
  direccion?: string | null;
  tipoOperacion?: string | null;
  imagenes?: string[];
  esFavorito?: boolean;
};

let propiedades: PropiedadDestacada[] = [];

try {
  const res = await fetch("http://localhost:8001/api/propiedades/destacadas");
  if (res.ok) {
    const json = await res.json();
    propiedades = json.propiedades ?? json.data ?? json ?? [];
  }
} catch { /* si el backend no responde, muestra vacío */ }

function formatPrecio(n: number | string) {
  const num = typeof n === "string" ? parseFloat(n) : n;
  return new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  }).format(num);
}
---

<section class="contenedor">
  <div class="header-destacadas">
    <div class="textos-destacadas">
      <span class="etiqueta-destacadas">Selección Especial</span>
      <h2 class="titulo-destacadas">Propiedades Destacadas</h2>
      <p class="sub-destacadas">
        Inmuebles seleccionados por nuestros asesores esta semana
      </p>
    </div>
  </div>

  {propiedades.length === 0 ? (
    /* Esqueleto de carga mientras no haya datos */
    <div class="destacadas-carousel">
      <div class="carousel-viewport-destacadas">
        <div class="grid">
          {[1, 2, 3].map(() => (
            <div class="skeleton-card">
              <div class="skeleton-img"></div>
              <div class="skeleton-body">
                <div class="skeleton-line short"></div>
                <div class="skeleton-line medium"></div>
                <div class="skeleton-line short"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <div class="destacadas-carousel">
      <button
        type="button"
        class="carousel-flecha carousel-flecha-prev"
        id="flechaDestacadasPrev"
        aria-label="Ver propiedades anteriores"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="carousel-viewport-destacadas">
        <div class="grid" id="gridDestacadas">
          {propiedades.map((p) => {
            const tipo = (p.tipoOperacion ?? "").toLowerCase();
            const badgeClass = tipo.includes("venta")
              ? "badge-venta"
              : tipo.includes("arriendo")
                ? "badge-arriendo"
                : "badge-default";
            const sufijo = tipo.includes("arriendo") ? "/ mes" : "COP";
            const imagen = p.imagenes?.[0]
              ? (p.imagenes[0].startsWith("http") ? p.imagenes[0] : `http://localhost:8001${p.imagenes[0]}`)
              : "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80";
            const ubicacion = p.ciudad || p.direccion || "Colombia";

            return (
              <div class="card">
                <div class="card-img-container">
                  <img src={imagen} alt={p.titulo} loading="lazy" />
                  <span class={`badge-tipo ${badgeClass}`}>{p.tipoOperacion ?? "Propiedad"}</span>
                  <button
                    type="button"
                    class={`btn-favorito-nuevo${p.esFavorito ? " favorito-activo" : ""}`}
                    data-id={p.propiedadID}
                    aria-label="Guardar favorito"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                </div>
                <div class="card-body">
                  <div class="precio-container">
                    <span class="precio-valor">{formatPrecio(p.precio)}</span>
                    <span class="precio-moneda">{sufijo}</span>
                  </div>
                  <h3 class="card-titulo">{p.titulo}</h3>
                  <div class="ubicacion-container">
                    <svg class="icono-pin" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path>
                    </svg>
                    <span class="ubicacion-texto">{ubicacion}</span>
                  </div>
                  <a href={`/propiedades/${p.propiedadID}`} class="enlace-absoluto" aria-label={p.titulo}></a>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <button
        type="button"
        class="carousel-flecha carousel-flecha-next"
        id="flechaDestacadasNext"
        aria-label="Ver más propiedades"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  )}
</section>

<!-- Modal login para favoritos -->
<div id="modalRegistro" class="modal-overlay">
  <div class="modal-box modal-box-login">
    <button type="button" class="modal-close" id="cerrarModal">✕</button>
    <div class="modal-info">
      <h2>Debes estar registrado</h2>
      <p>Para guardar favoritos debes iniciar sesión</p>
      <div class="acciones-login">
        <a href="/login" class="btn-contacto">Iniciar Sesión</a>
      </div>
    </div>
  </div>
</div>

<script>
  // ── Carrusel ──────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    const track    = document.getElementById("gridDestacadas");
    const viewport = document.querySelector(".carousel-viewport-destacadas");
    const btnPrev  = document.getElementById("flechaDestacadasPrev") as HTMLButtonElement | null;
    const btnNext  = document.getElementById("flechaDestacadasNext") as HTMLButtonElement | null;
    if (!track || !viewport || !btnPrev || !btnNext) return;

    let posicion = 0;

    function obtenerVisibles() {
      const tarjeta = track!.querySelector(".card");
      if (!tarjeta) return 1;
      const gap   = parseFloat(getComputedStyle(track!).gap) || 0;
      const ancho = tarjeta.getBoundingClientRect().width;
      return Math.max(1, Math.round((viewport!.clientWidth + gap) / (ancho + gap)));
    }

    function actualizar() {
      const tarjetas = track!.querySelectorAll(".card");
      if (!tarjetas.length) return;
      const visibles = obtenerVisibles();
      const maxPos   = Math.max(0, tarjetas.length - visibles);
      posicion = Math.min(posicion, maxPos);
      const gap   = parseFloat(getComputedStyle(track!).gap) || 0;
      const ancho = tarjetas[0].getBoundingClientRect().width;
      (track as HTMLElement).style.transform = `translateX(-${posicion * (ancho + gap)}px)`;
      btnPrev!.disabled = posicion <= 0;
      btnNext!.disabled = posicion >= maxPos;
    }

    btnPrev.addEventListener("click", () => {
      posicion = Math.max(0, posicion - obtenerVisibles());
      actualizar();
    });
    btnNext.addEventListener("click", () => {
      const tarjetas = track!.querySelectorAll(".card");
      const maxPos   = Math.max(0, tarjetas.length - obtenerVisibles());
      posicion = Math.min(maxPos, posicion + obtenerVisibles());
      actualizar();
    });
    window.addEventListener("resize", actualizar);
    actualizar();
  });

  // ── Favoritos ─────────────────────────────────────────
  document.querySelectorAll(".btn-favorito-nuevo").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const propiedadId = (btn as HTMLElement).dataset.id;
      const res = await fetch("/api/usuario/favoritos", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `propiedadId=${propiedadId}`,
      }).catch(() => null);

      if (!res || res.status === 401) {
        document.getElementById("modalRegistro")?.classList.add("open");
        return;
      }
      if (res.ok) {
        btn.classList.toggle("favorito-activo");
      }
    });
  });

  // ── Modal ─────────────────────────────────────────────
  document.getElementById("cerrarModal")?.addEventListener("click", () => {
    document.getElementById("modalRegistro")?.classList.remove("open");
  });
  document.getElementById("modalRegistro")?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).id === "modalRegistro") {
      document.getElementById("modalRegistro")?.classList.remove("open");
    }
  });
</script>

<style>
  /* Esqueleto de carga */
  .skeleton-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,.06);
    flex: 0 0 calc((100% - 50px) / 3);
    min-width: 0;
  }
  .skeleton-img {
    width: 100%;
    height: 230px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
  }
  .skeleton-body { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .skeleton-line {
    height: 14px; border-radius: 4px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
  }
  .skeleton-line.short  { width: 60%; }
  .skeleton-line.medium { width: 80%; }
  @keyframes shimmer {
    0%   { background-position:  200% 0; }
    100% { background-position: -200% 0; }
  }
  @media (max-width: 992px) { .skeleton-card { flex: 0 0 calc((100% - 25px) / 2); } }
  @media (max-width: 600px) { .skeleton-card { flex: 0 0 100%; } }
</style>
