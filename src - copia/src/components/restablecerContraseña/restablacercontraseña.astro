---
import "../login/login.css";
---

<div class="auth-page">
    <div class="bg-layer" aria-hidden="true">
        <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80"
        class="bg-img active"
        alt=""
        />
        <div class="bg-overlay"></div>
    </div>

    <header class="auth-header">
        <div class="brand">
        <h1>SkyInit</h1>
        <p>Nueva contraseña</p>
        </div>
    </header>

    <main class="auth-main">
        <div class="glass-card">
        <div class="card-title">
            <h2>Restablecer contraseña</h2>
            <p>Elige una contraseña segura para tu cuenta</p>
        </div>

        <form id="formReset" class="auth-form">
            <div class="field">
            <label for="password">Nueva contraseña</label>
            <input
                id="password"
                type="password"
                class="custom-input"
                placeholder="••••••••"
                required
                minlength="8"
            />
            </div>
            <div class="field">
            <label for="confirmar">Confirmar contraseña</label>
            <input
                id="confirmar"
                type="password"
                class="custom-input"
                placeholder="••••••••"
                required
                minlength="8"
            />
            </div>

            <div id="msg" class="msg-error d-none" role="alert"></div>

            <button type="submit" id="btnReset" class="btn-brand">
            Guardar contraseña
            </button>
        </form>

        <p class="auth-footer-links">
            <a href="/login">Ir al login</a>
        </p>
        </div>
    </main>

    <footer class="auth-footer">&copy; 2026 SkyInit</footer>
</div>

<script>
    const params = new URLSearchParams(window.location.search);
    const token = params.get("token");

    const form = document.getElementById("formReset") as HTMLFormElement;
    const msg = document.getElementById("msg") as HTMLDivElement;
    const btn = document.getElementById("btnReset") as HTMLButtonElement;

    if (!token) {
        msg.classList.remove("d-none");
        msg.textContent = "Enlace inválido. Solicita un nuevo correo de recuperación.";
        form.style.display = "none";
    }

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!token) return;

    msg.classList.add("d-none");
    btn.disabled = true;

    const Password = (document.getElementById("password") as HTMLInputElement).value;
    const Confirmar = (document.getElementById("confirmar") as HTMLInputElement).value;

        if (Password !== Confirmar) {
        msg.classList.remove("d-none");
        msg.textContent = "Las contraseñas no coinciden";
        btn.disabled = false;
        return;
        }

    try {
        const res = await fetch("http://localhost:8001/auth/restablecer-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ Token: token, Password, Confirmar }),
        });
        const data = await res.json();

        msg.classList.remove("d-none");
        if (res.ok) {
            msg.style.color = "#86efac";
            msg.textContent = data.mensaje || "Contraseña actualizada. Redirigiendo...";
            setTimeout(() => {
            window.location.href = "/login";
            }, 1500);
        } else {
            msg.textContent = data.error || "No se pudo actualizar la contraseña";
            btn.disabled = false;
        }
        } catch {
        msg.classList.remove("d-none");
        msg.textContent = "Error de conexión con el servidor";
        btn.disabled = false;
        }
    });
</script>