---
import Layout from "../../layouts/LayoutVistas.astro";
import ServicioCard from "../../components/inmobiliaria/servicioCard.astro";
import ServicioModal from "../../components/inmobiliaria/serviciomodal.astro";

interface ServicioInmobiliaria {
  ServicioID: number;
  InmobiliariaID: number | null;
  Nombre: string;
  Descripcion: string;
  Precio: string | number;
  Estado: "Activo" | "Inactivo";
  Imagen?: string | null;
}

const cookieHeader = Astro.request.headers.get("cookie") || "";
let serviciosIniciales: ServicioInmobiliaria[] = [];
let errorCargaInicial: string | null = null;

try {
  const response = await fetch("http://localhost:8001/api/inmobiliaria/servicios", {
    headers: { Cookie: cookieHeader },
  });
  if (response.ok) {
    const json = await response.json();
    serviciosIniciales = (json.data ?? []) as ServicioInmobiliaria[];
  } else {
    errorCargaInicial = "No se pudieron cargar los servicios iniciales.";
  }
} catch {
  errorCargaInicial = "Error de conexión con el servidor backend.";
}

const totalCount = serviciosIniciales.length;
const activosCount = serviciosIniciales.filter((s) => s.Estado === "Activo").length;
const inactivosCount = serviciosIniciales.filter((s) => s.Estado === "Inactivo").length;
---

<Layout>
  <div class="admin-servicios">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h1 class="page-title">Servicios de mantenimiento</h1>
        <p class="page-subtitle">Gestiona el catálogo de servicios de tu inmobiliaria.</p>
      </div>
      <button class="btn btn-sky-primary d-flex align-items-center gap-2" id="btnNuevoServicio" type="button">
        <i class="bi bi-plus-lg"></i>
        <span>Nuevo servicio</span>
      </button>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-title">Total servicios</div>
          <div class="stat-value" id="statTotal">{totalCount}</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card stat-activos">
          <div class="stat-title">Activos</div>
          <div class="stat-value" id="statActivos">{activosCount}</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card stat-inactivos">
          <div class="stat-title">Inactivos</div>
          <div class="stat-value" id="statInactivos">{inactivosCount}</div>
        </div>
      </div>
    </div>

    <div class="filter-bar mb-4">
      <div class="row g-3">
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="inputBuscar" class="form-control border-start-0" placeholder="Buscar por nombre de servicio..." />
          </div>
        </div>
        <div class="col-md-4">
          <select id="selectEstado" class="form-select">
            <option value="">Todos los estados</option>
            <option value="Activo">Activos</option>
            <option value="Inactivo">Inactivos</option>
          </select>
        </div>
      </div>
    </div>

    <div id="loadingState" class="text-center py-5 d-none">
      <div class="spinner-border text-success" role="status">
        <span class="visually-hidden">Cargando...</span>
      </div>
    </div>

    <div id="errorState" class={`alert alert-danger py-3 ${errorCargaInicial ? "" : "d-none"}`} role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <span id="errorMessage">{errorCargaInicial || "Ocurrió un error al cargar la información."}</span>
    </div>

    <div id="emptyState" class={`text-center py-5 bg-white rounded border ${serviciosIniciales.length === 0 && !errorCargaInicial ? "" : "d-none"}`}>
      <i class="bi bi-tools display-4 text-muted"></i>
      <h3 class="mt-3 text-secondary">No hay servicios registrados</h3>
      <p class="text-muted">Publica el primer servicio con “Nuevo servicio”.</p>
    </div>

    <div id="gridServicios" class="services-grid">
      {serviciosIniciales.map((servicio) => (
        <ServicioCard servicio={servicio} />
      ))}
    </div>
  </div>

  <ServicioModal />

  <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalConfirmarLabel">Confirmar acción</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body" id="modalConfirmarBody">¿Está seguro?</div>
        <div class="modal-footer" id="modalConfirmarFooter">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btnEjecutarConfirmar">Aceptar</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toastFeedback" class="toast align-items-center text-white bg-success border-0" role="alert">
      <div class="d-flex">
        <div class="toast-body" id="toastMessage">Operación realizada con éxito.</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script define:vars={{ initialServices: serviciosIniciales }}>
  document.addEventListener("DOMContentLoaded", () => {
    const API = "/api/inmobiliarias/servicios";
    let listadoServicios = initialServices || [];
    const bsModalForm = new bootstrap.Modal(document.getElementById("modalServicio"));
    const bsModalConfirm = new bootstrap.Modal(document.getElementById("modalConfirmar"));
    const bsToast = new bootstrap.Toast(document.getElementById("toastFeedback"));

    const inputBuscar = document.getElementById("inputBuscar");
    const selectEstado = document.getElementById("selectEstado");
    const gridServicios = document.getElementById("gridServicios");
    const emptyState = document.getElementById("emptyState");
    const loadingState = document.getElementById("loadingState");
    const errorState = document.getElementById("errorState");
    const formServicio = document.getElementById("formServicio");
    const btnNuevoServicio = document.getElementById("btnNuevoServicio");
    const imagenInput = document.getElementById("imagenInput");
    const imgPreview = document.getElementById("imgPreview");
    let currentBase64Image = "";

    function showToast(message, isSuccess = true) {
      const toastEl = document.getElementById("toastFeedback");
      document.getElementById("toastMessage").textContent = message;
      toastEl.className = `toast align-items-center text-white border-0 ${isSuccess ? "bg-success" : "bg-danger"}`;
      bsToast.show();
    }

    function actualizarEstadisticas() {
      document.getElementById("statTotal").textContent = listadoServicios.length;
      document.getElementById("statActivos").textContent = listadoServicios.filter((s) => s.Estado === "Activo").length;
      document.getElementById("statInactivos").textContent = listadoServicios.filter((s) => s.Estado === "Inactivo").length;
    }

    async function fetchServicios() {
      const q = inputBuscar.value.trim();
      const estado = selectEstado.value;
      loadingState.classList.remove("d-none");
      gridServicios.classList.add("d-none");
      emptyState.classList.add("d-none");
      errorState.classList.add("d-none");
      try {
        const res = await fetch(`${API}?q=${encodeURIComponent(q)}&estado=${encodeURIComponent(estado)}`, { credentials: "same-origin" });
        const json = await res.json();
        if (res.ok && json.ok) {
          listadoServicios = json.data || [];
          renderGrid(listadoServicios);
          actualizarEstadisticas();
        } else {
          document.getElementById("errorMessage").textContent = json.message || "Error al filtrar los servicios.";
          errorState.classList.remove("d-none");
        }
      } catch {
        document.getElementById("errorMessage").textContent = "Error de conexión con el servidor.";
        errorState.classList.remove("d-none");
      } finally {
        loadingState.classList.add("d-none");
      }
    }

    function renderGrid(servicios) {
      gridServicios.innerHTML = "";
      if (servicios.length === 0) {
        emptyState.classList.remove("d-none");
        gridServicios.classList.add("d-none");
        return;
      }
      emptyState.classList.add("d-none");
      gridServicios.classList.remove("d-none");
      const formatter = new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 });
      servicios.forEach((s) => {
        const card = document.createElement("div");
        card.className = "service-card";
        const imgUrl = s.Imagen && s.Imagen.trim() !== "" ? s.Imagen : "/img/servicios-placeholder.webp";
        card.innerHTML = `
          <div class="service-img-wrapper">
            <img src="${imgUrl}" alt="" loading="lazy">
            <span class="badge-status ${s.Estado === "Activo" ? "badge-activo" : "badge-inactivo"}">${s.Estado}</span>
          </div>
          <div class="service-card-body">
            <h3 class="service-title"></h3>
            <p class="service-desc"></p>
            <div class="service-price">${formatter.format(Number(s.Precio))}</div>
          </div>
          <div class="service-actions">
            <button class="btn btn-sm btn-outline-primary flex-grow-1 btn-editar" data-id="${s.ServicioID}" type="button"><i class="bi bi-pencil me-1"></i> Editar</button>
            <button class="btn btn-sm btn-outline-secondary btn-estado" data-id="${s.ServicioID}" data-estado="${s.Estado}" type="button">${s.Estado === "Activo" ? "Desactivar" : "Activar"}</button>
            <button class="btn btn-sm btn-outline-danger btn-eliminar" data-id="${s.ServicioID}" data-nombre="" type="button"><i class="bi bi-trash"></i></button>
          </div>`;
        card.querySelector(".service-title").textContent = s.Nombre;
        card.querySelector(".service-desc").textContent = s.Descripcion;
        card.querySelector(".btn-eliminar").dataset.nombre = s.Nombre;
        gridServicios.appendChild(card);
      });
    }

    function debounce(fn, delay) {
      let t;
      return (...args) => { clearTimeout(t); t = setTimeout(() => fn.apply(this, args), delay); };
    }

    inputBuscar.addEventListener("input", debounce(fetchServicios, 300));
    selectEstado.addEventListener("change", fetchServicios);

    imagenInput?.addEventListener("change", (e) => {
      const file = e.target.files[0];
      const errorImg = document.getElementById("error-imagen");
      errorImg.textContent = "";
      if (!file) { imgPreview.src = "/img/servicios-placeholder.webp"; currentBase64Image = ""; return; }
      if (!["image/jpeg", "image/jpg", "image/png", "image/webp"].includes(file.type)) {
        errorImg.textContent = "Formato no válido. Use JPG, PNG o WEBP."; imagenInput.value = ""; return;
      }
      if (file.size > 2 * 1024 * 1024) {
        errorImg.textContent = "La imagen no debe superar los 2 MB."; imagenInput.value = ""; return;
      }
      const reader = new FileReader();
      reader.onload = (evt) => { imgPreview.src = evt.target.result; currentBase64Image = evt.target.result; };
      reader.readAsDataURL(file);
    });

    btnNuevoServicio.addEventListener("click", () => {
      document.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
      formServicio.reset();
      document.getElementById("servicioId").value = "";
      document.getElementById("modalServicioLabel").textContent = "Nuevo servicio de mantenimiento";
      imgPreview.src = "/img/servicios-placeholder.webp";
      currentBase64Image = "";
      bsModalForm.show();
    });

    gridServicios.addEventListener("click", async (e) => {
      const btnEditar = e.target.closest(".btn-editar");
      const btnEstado = e.target.closest(".btn-estado");
      const btnEliminar = e.target.closest(".btn-eliminar");
      if (btnEditar) {
        const servicio = listadoServicios.find((s) => String(s.ServicioID) === String(btnEditar.dataset.id));
        if (!servicio) return;
        document.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
        document.getElementById("servicioId").value = servicio.ServicioID;
        document.getElementById("nombre").value = servicio.Nombre;
        document.getElementById("precio").value = servicio.Precio;
        document.getElementById("estado").value = servicio.Estado;
        document.getElementById("descripcion").value = servicio.Descripcion;
        imgPreview.src = servicio.Imagen || "/img/servicios-placeholder.webp";
        document.getElementById("modalServicioLabel").textContent = "Editar servicio de mantenimiento";
        bsModalForm.show();
      }
      if (btnEstado) await cambiarEstadoServicio(btnEstado.dataset.id, btnEstado.dataset.estado === "Activo" ? "Inactivo" : "Activo");
      if (btnEliminar) solicitarEliminacion(btnEliminar.dataset.id, btnEliminar.dataset.nombre);
    });

    formServicio.addEventListener("submit", async (e) => {
      e.preventDefault();
      document.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
      const id = document.getElementById("servicioId").value;
      const nombre = document.getElementById("nombre").value.trim();
      const precio = parseFloat(document.getElementById("precio").value);
      const estado = document.getElementById("estado").value;
      const descripcion = document.getElementById("descripcion").value.trim();
      let hasError = false;
      if (nombre.length < 3 || nombre.length > 150) { document.getElementById("error-nombre").textContent = "El nombre debe tener entre 3 y 150 caracteres."; hasError = true; }
      if (isNaN(precio) || precio <= 0) { document.getElementById("error-precio").textContent = "El precio debe ser un número mayor a 0."; hasError = true; }
      if (descripcion.length < 20) { document.getElementById("error-descripcion").textContent = "La descripción debe tener al menos 20 caracteres."; hasError = true; }
      if (hasError) return;
      const payload = { Nombre: nombre, Precio: precio, Estado: estado, Descripcion: descripcion, Imagen: currentBase64Image || null };
      const isEdit = Boolean(id);
      const btnSubmit = document.getElementById("btnGuardarServicio");
      const spinner = document.getElementById("spinnerGuardar");
      btnSubmit.disabled = true; spinner.classList.remove("d-none");
      try {
        const res = await fetch(isEdit ? `${API}/${id}` : API, {
          method: isEdit ? "PUT" : "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (res.ok && json.ok) {
          bsModalForm.hide();
          showToast(isEdit ? "Servicio actualizado correctamente." : "Servicio creado correctamente.");
          await fetchServicios();
        } else if (res.status === 422 && json.errors) {
          Object.keys(json.errors).forEach((field) => {
            const errEl = document.getElementById(`error-${field.toLowerCase()}`);
            if (errEl) errEl.textContent = json.errors[field];
          });
        } else showToast(json.message || "Ocurrió un error al guardar.", false);
      } catch { showToast("Error de conexión al guardar el servicio.", false); }
      finally { btnSubmit.disabled = false; spinner.classList.add("d-none"); }
    });

    async function cambiarEstadoServicio(id, nuevoEstado) {
      try {
        const res = await fetch(`${API}/${id}/estado`, {
          method: "PATCH",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ Estado: nuevoEstado }),
        });
        const json = await res.json();
        if (res.ok && json.ok) { showToast(`Servicio ${nuevoEstado === "Activo" ? "activado" : "desactivado"} con éxito.`); await fetchServicios(); }
        else showToast(json.message || "No se pudo cambiar el estado.", false);
      } catch { showToast("Error de red al cambiar estado.", false); }
    }

    function escapeHTML(str) {
      return String(str).replace(/[&<>'"]/g, (tag) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[tag] || tag));
    }

    function solicitarEliminacion(id, nombre) {
      document.getElementById("modalConfirmarLabel").textContent = "Confirmar eliminación";
      document.getElementById("modalConfirmarBody").innerHTML = `¿Eliminar el servicio <strong>${escapeHTML(nombre)}</strong>?`;
      document.getElementById("modalConfirmarFooter").innerHTML = `
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="btnConfirmarDeleteAction">Eliminar</button>`;
      document.getElementById("btnConfirmarDeleteAction").addEventListener("click", () => ejecutarEliminacion(id));
      bsModalConfirm.show();
    }

    async function ejecutarEliminacion(id) {
      try {
        const res = await fetch(`${API}/${id}`, { method: "DELETE", credentials: "same-origin" });
        const json = await res.json();
        if (res.ok && json.ok) { bsModalConfirm.hide(); showToast("Servicio eliminado exitosamente."); await fetchServicios(); }
        else if (res.status === 409) {
          document.getElementById("modalConfirmarLabel").textContent = "No se puede eliminar";
          document.getElementById("modalConfirmarBody").innerHTML = `<div class="alert alert-warning mb-0">${escapeHTML(json.message || "Este servicio tiene solicitudes asociadas.")}<p class="mt-2 mb-0">¿Desea cambiar su estado a <strong>Inactivo</strong>?</p></div>`;
          document.getElementById("modalConfirmarFooter").innerHTML = `
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-warning" id="btnDesactivarConflict">Desactivar servicio</button>`;
          document.getElementById("btnDesactivarConflict").addEventListener("click", async () => { bsModalConfirm.hide(); await cambiarEstadoServicio(id, "Inactivo"); });
        } else { bsModalConfirm.hide(); showToast(json.message || "Error al eliminar el servicio.", false); }
      } catch { bsModalConfirm.hide(); showToast("Error de conexión al eliminar.", false); }
    }
  });
</script>

<style is:global>
  :root { --teal-primary: #2e8b57; }
  .page-title { font-family: Georgia, serif; font-size: 1.75rem; font-weight: 700; margin: 0; color: #1b3a2a; }
  .page-subtitle { margin: 0.25rem 0 0; color: #6b7280; }
  .btn-sky-primary { background: #2e8b57; color: #fff; border: none; }
  .btn-sky-primary:hover { background: #1b5e20; color: #fff; }
  .stat-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 1.1rem 1.25rem; }
  .stat-title { font-size: 0.8rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em; }
  .stat-value { font-size: 1.8rem; font-weight: 700; color: #111827; }
  .stat-activos .stat-value { color: #15803d; }
  .stat-inactivos .stat-value { color: #b45309; }
  .filter-bar { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 1rem; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .service-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  .service-img-wrapper { position: relative; height: 160px; background: #eef2f0; }
  .service-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .badge-status { position: absolute; top: 10px; left: 10px; border-radius: 999px; padding: 4px 10px; font-size: 0.75rem; font-weight: 600; color: #fff; }
  .badge-activo { background: #15803d; }
  .badge-inactivo { background: #6b7280; }
  .service-card-body { padding: 1rem 1.1rem 0.5rem; flex: 1; }
  .service-title { font-size: 1.05rem; margin: 0 0 0.35rem; }
  .service-desc { font-size: 0.85rem; color: #6b7280; margin: 0 0 0.6rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .service-price { font-weight: 700; color: #2e8b57; }
  .service-actions { display: flex; gap: 0.4rem; padding: 0.85rem 1rem 1rem; }
  .field-error { color: #b91c1c; font-size: 0.8rem; }
  .img-preview-box img { max-height: 140px; border-radius: 10px; object-fit: cover; }
</style>